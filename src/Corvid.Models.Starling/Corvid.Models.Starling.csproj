<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>In-process Starling model adapters: Qwen3.5 generator, GLiNER2 extractor, EmbeddingGemma 2 and e5 text embedders, the Kev decider, and explicit model acquisition.</Description>
    <!-- Not IsAotCompatible: the Starling packages are not AOT-qualified as a set, and warnings are errors. -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Starlings.Acquisition" />
    <PackageReference Include="Starlings.Models.E5.Extensions.AI" />
    <PackageReference Include="Starlings.Models.EmbeddingGemma2.Extensions.AI" />
    <PackageReference Include="Starlings.Models.Gliner2" />
    <PackageReference Include="Starlings.Models.Kev" />
    <PackageReference Include="Starlings.Models.Qwen35.Extensions.AI" />
    <ProjectReference Include="../Corvid.Models/Corvid.Models.csproj" />
    <InternalsVisibleTo Include="Corvid.Models.Starling.Tests" />
  </ItemGroup>
  <!--
    The one native runtime package. By default it is Microsoft.ML.OnnxRuntimeGenAI, which brings Microsoft.ML.OnnxRuntime
    1.30.0 (CPU) for GLiNER2, e5, EmbeddingGemma 2 and Kev through Starlings.Runtime.Onnx. -p:UseCuda=true (C-029, the
    property S1 and Starling's Kev fidelity tool use) swaps it for Microsoft.ML.OnnxRuntimeGenAI.Cuda, which brings
    Microsoft.ML.OnnxRuntime.Gpu 1.30.0: the CUDA provider plus the CPU one, under the same file names. Never reference
    both. The CUDA 13 runtime (cudart, cuBLAS, cuRAND, cuFFT) is not in the package and must be on the loader path
    (corvid doctor checks); cuDNN 9 is optional, dlopened only for kernels that use it (Kev's graph runs without it). Build each variant into its own output directory: they share obj/ and bin/ otherwise.
  -->
  <ItemGroup Condition="'$(UseCuda)' != 'true'">
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseCuda)' == 'true'">
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI.Cuda" />
  </ItemGroup>
</Project>

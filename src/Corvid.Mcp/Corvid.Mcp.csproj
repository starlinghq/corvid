  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.Core" />
    <PackageReference Include="ModelContextProtocol.Extensions.Tasks" />
    <ProjectReference Include="../Corvid.Sandbox/Corvid.Sandbox.csproj" />
    <ProjectReference Include="../Corvid.Tools/Corvid.Tools.csproj" />
    <ProjectReference Include="../Corvid.Vault.Client/Corvid.Vault.Client.csproj" />
    <InternalsVisibleTo Include="Corvid.Mcp.Tests" />
  </ItemGroup>
</Project>

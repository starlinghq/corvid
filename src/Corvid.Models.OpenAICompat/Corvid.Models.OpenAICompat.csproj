<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>OpenAI-compatible chat endpoints as Corvid model bindings: local servers (llama.cpp, Ollama, vLLM, LM Studio), OpenAI, OpenRouter and Gemini's compatible endpoint, through the official OpenAI SDK and its Microsoft.Extensions.AI adapter; keys only through Vault.</Description>
    <!-- Not IsAotCompatible: the OpenAI SDK is not AOT-qualified as a set with its adapter, and warnings are errors. -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="OpenAI" />
    <ProjectReference Include="../Corvid.Models/Corvid.Models.csproj" />
    <InternalsVisibleTo Include="Corvid.Models.Remote.Tests" />
  </ItemGroup>
</Project>

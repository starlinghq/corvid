{
  "id": "credential-file-read",
  "version": 1,
  "title": "A credential file is read",
  "description": "A shell command or read_file names an SSH private key, cloud or registry credentials, .netrc, a kube config, the GitHub CLI's hosts file, the GnuPG directory or a .env file. Paths adapted from Corvid.Skills' SkillScanner and Beacon's credential-access rules (MIT).",
  "severity": "medium",
  "status": "stable",
  "posture": "detect",
  "category": "credential-access",
  "reason": "A credential file was read",
  "match": {
    "event": "tool_call_issued",
    "where": {
      "any": [
        {
          "field": "derived.command",
          "regex": "(?i)(\\.ssh/(id_(rsa|dsa|ecdsa|ed25519)(_sk)?|identity)($|[^.a-z0-9_])|\\.aws/credentials|\\.netrc\\b|\\.kube/config|\\.docker/config\\.json|\\.config/gh/hosts\\.yml|\\.gnupg/|\\.env(\\.local|\\.production|\\.prod|\\.development)?($|[\\s'\\\"|;&>)]))"
        },
        {
          "all": [
            {
              "field": "tool_name",
              "in": [
                "read_file"
              ]
            },
            {
              "field": "arguments.path",
              "regex": "(?i)(\\.ssh/(id_(rsa|dsa|ecdsa|ed25519)(_sk)?|identity)($|[^.a-z0-9_])|\\.aws/credentials|\\.netrc\\b|\\.kube/config|\\.docker/config\\.json|\\.config/gh/hosts\\.yml|\\.gnupg/|\\.env(\\.local|\\.production|\\.prod|\\.development)?($|[\\s'\\\"|;&>)]))"
            }
          ]
        }
      ]
    }
  },
  "tests": [
    {
      "name": "cat_ssh_key",
      "verdict": "match",
      "events": [
        {
          "type": "tool_call_issued",
          "call_id": "c1",
          "tool_name": "shell",
          "arguments": {
            "command": "cat ~/.ssh/id_ed25519"
          }
        }
      ]
    },
    {
      "name": "read_file_env",
      "verdict": "match",
      "events": [
        {
          "type": "tool_call_issued",
          "call_id": "c1",
          "tool_name": "read_file",
          "arguments": {
            "path": ".env"
          }
        }
      ]
    },
    {
      "name": "aws_credentials",
      "verdict": "match",
      "events": [
        {
          "type": "tool_call_issued",
          "call_id": "c1",
          "tool_name": "shell",
          "arguments": {
            "command": "grep key /home/u/.aws/credentials"
          }
        }
      ]
    },
    {
      "name": "public_key_is_fine",
      "verdict": "no_match",
      "events": [
        {
          "type": "tool_call_issued",
          "call_id": "c1",
          "tool_name": "shell",
          "arguments": {
            "command": "cat ~/.ssh/id_ed25519.pub"
          }
        }
      ]
    },
    {
      "name": "env_example_is_fine",
      "verdict": "no_match",
      "events": [
        {
          "type": "tool_call_issued",
          "call_id": "c1",
          "tool_name": "read_file",
          "arguments": {
            "path": ".env.example"
          }
        }
      ]
    },
    {
      "name": "readme",
      "verdict": "no_match",
      "events": [
        {
          "type": "tool_call_issued",
          "call_id": "c1",
          "tool_name": "shell",
          "arguments": {
            "command": "cat README.md"
          }
        }
      ]
    }
  ]
}

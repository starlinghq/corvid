<Project Sdk="Uno.Sdk">
  <!--
    The windowed Corvid (docs/plan/ui.md): the Uno single project. The Skia desktop target always builds; the WebAssembly
    target only with -p:CorvidAppWasm=true, because it needs the wasm-tools workload (UNOWA0001), which CI does not
    install. Uno.Sdk's version is pinned in global.json ("msbuild-sdks").
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop</TargetFrameworks>
    <TargetFrameworks Condition="'$(CorvidAppWasm)' == 'true'">$(TargetFrameworks);net10.0-browserwasm</TargetFrameworks>
    <!-- Directory.Build.props gives every project net10.0; clearing it here makes this a multi-target outer build. -->
    <TargetFramework />
    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <RootNamespace>Corvid.App</RootNamespace>
    <!-- U-7: the window is "Corvid" and the binary corvid-app, beside corvid; install.sh installs it with its app option. -->
    <AssemblyName>corvid-app</AssemblyName>

    <ApplicationTitle>Corvid</ApplicationTitle>
    <ApplicationId>com.starlinghq.corvid</ApplicationId>
    <ApplicationDisplayVersion>0.2.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationPublisher>Corvid</ApplicationPublisher>
    <Description>The windowed Corvid: the conversation, approvals, review and the rest of the kernel's evidence, on Uno Platform.</Description>

    <!-- The Skia renderer on every target, so the desktop and the browser draw the same pixels. -->
    <UnoFeatures>SkiaRenderer</UnoFeatures>
    <!-- Inter and JetBrains Mono ship as assets (Assets/Fonts) and Inter is set as the default text font in App.xaml.cs,
         so Uno's Open Sans package is not needed. -->
    <UnoDefaultFont>None</UnoDefaultFont>
    <!-- Hot Design brings CommunityToolkit.Mvvm, Uno.Toolkit and Uno.Themes into the graph, which the app does not take
         (the checker refuses them), and the in-app MCP endpoint is not wanted in a process that will host the engine. -->
    <UnoDisableHotDesign>true</UnoDisableHotDesign>
    <UnoDisableMCPSupport>true</UnoDisableMCPSupport>
    <!-- Uno.Sdk's implicit Microsoft.Extensions.Logging.Console is 10.0.12; the desktop target also reaches the composition
         root (through Corvid.App.Engine), whose Microsoft.Extensions.Hosting needs 10.0.13 (NU1605 otherwise). -->
    <MicrosoftLoggingVersion>10.0.13</MicrosoftLoggingVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Corvid.App.Core/Corvid.App.Core.csproj" />
  </ItemGroup>

  <!-- The in-process engine (the engine option), in the desktop target alone: the browser runs attached to an engine elsewhere and
       never references the composition root (the checker's AppHead rule). Platforms/Desktop/Program.cs starts it. -->
  <ItemGroup Condition="$(TargetFramework.Contains('-desktop'))">
    <ProjectReference Include="../Corvid.App.Engine/Corvid.App.Engine.csproj" />
  </ItemGroup>

  <!-- A5: corvid-sandbox beside the desktop app, where BubblewrapSandbox and doctor look for it when Sandbox:LauncherPath is
       unset. The launcher is started by path and never referenced (the checker refuses a ProjectReference), so it is built
       and copied after the app's own build. -->
  <Target Name="CopyCorvidSandbox" AfterTargets="Build" Condition="$(TargetFramework.Contains('-desktop'))">
    <MSBuild Projects="$(MSBuildThisFileDirectory)../../sandbox/Corvid.Sandbox.Launcher/Corvid.Sandbox.Launcher.csproj" Targets="Build"
             Properties="Configuration=$(Configuration)" RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="_CorvidSandboxAssembly" />
    </MSBuild>
    <PropertyGroup>
      <_CorvidSandboxDirectory>@(_CorvidSandboxAssembly->'%(RootDir)%(Directory)')</_CorvidSandboxDirectory>
    </PropertyGroup>
    <ItemGroup>
      <_CorvidSandboxFiles Include="$(_CorvidSandboxDirectory)corvid-sandbox;$(_CorvidSandboxDirectory)corvid-sandbox.dll;$(_CorvidSandboxDirectory)corvid-sandbox.runtimeconfig.json;$(_CorvidSandboxDirectory)corvid-sandbox.deps.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_CorvidSandboxFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- U-9: the release tarball install.sh installs with its app option (corvid-app-linux-x64.tar.gz): the published desktop app and a
       VERSION file, without corvid-sandbox (install.sh copies the release's native one beside the app) or symbols.
         dotnet publish src/Corvid.App/Corvid.App.csproj -c Release -f net10.0-desktop -r linux-x64 (self-contained) \
           -p:Version=0.2.0 -p:CorvidAppTarball=$PWD/corvid-app-linux-x64.tar.gz -->
  <Target Name="CorvidAppTarball" AfterTargets="Publish" Condition="'$(CorvidAppTarball)' != '' and $(TargetFramework.Contains('-desktop'))">
    <Error Condition="!Exists('$(PublishDir)corvid-app')" Text="The publish has no corvid-app apphost; publish with -r linux-x64." />
    <Error Condition="!Exists('$(PublishDir)Assets/Icons/Svg/corvid.svg')" Text="The publish has no Assets/Icons/Svg/corvid.svg for the desktop entry." />
    <WriteLinesToFile File="$(PublishDir)VERSION" Lines="$(Version)" Overwrite="true" />
    <Exec Command="tar -czf &quot;$(CorvidAppTarball)&quot; --exclude=./corvid-sandbox --exclude=./corvid-sandbox.dll --exclude=./corvid-sandbox.runtimeconfig.json --exclude=./corvid-sandbox.deps.json --exclude=*.pdb --exclude=*.dbg -C &quot;$(PublishDir)&quot; ." />
    <Message Importance="high" Text="corvid-app tarball: $(CorvidAppTarball)" />
  </Target>

  <!-- A6 review L4: the browser head calls history.replaceState through [JSImport], whose generated marshalling is unsafe code. -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-browserwasm'))">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsBrowserWasm)' == 'true'">
    <!-- Security pins (Directory.Packages.props). Uno.Sdk gives a WebAssembly head Microsoft.Windows.Compatibility, which
         resolves these at 10.0.12, a release with known advisories (NU1902, NU1903). Referencing the patched release
         directly lifts the graph past them; NuGet audit stays on. The desktop graph has neither package. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>
</Project>

<UserControl x:Class="Corvid.App.Shell.CommandPalette"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Corvid.App.Controls"
             xmlns:palette="using:Corvid.App.Core.Palette"
             xmlns:shell="using:Corvid.App.Shell"
             xmlns:ui="using:Corvid.App.Infrastructure"
             Foreground="{ThemeResource CorvidText}"
             FontSize="13.5"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch"
             IsTabStop="False">
  <!--
    The command palette (docs/plan/ui.md §3, §6) and the surfaces that share its shape: the session switcher, the prompt
    history, find in the session, search across sessions, the generator switch, the shortcuts, and the surfaces of keys
    whose feature comes later. A card over a scrim, near the top of the window, as the mockups' pickers are drawn: bg with
    a line border, radius 10; the field, a note row (.toast) when there is one, the rows (8px 10px, radius 6, accent-bg
    when selected), and a footer with the count and the keys.
  -->
  <UserControl.Resources>
    <!-- A row: the whole row is the button; hover bg-2. The selection is drawn under it, so the button stays transparent. -->
    <Style x:Key="PaletteRow" TargetType="Button">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" />
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                      <Setter Target="Face.Background" Value="{ThemeResource CorvidBg2}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                      <Setter Target="Face.Background" Value="{ThemeResource CorvidBg3}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Disabled" />
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid x:Name="Root" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#66000000" PointerPressed="OnScrimPressed"
        Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.IsOpen), Mode=OneWay}">
    <ContentControl x:Name="CardHost" IsTabStop="True" UseSystemFocusVisuals="False" VerticalAlignment="Top" HorizontalAlignment="Center"
                    Margin="16,64,16,16" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{x:Bind ViewModel.Title, Mode=OneWay}">
      <Border x:Name="Card" Width="640" Background="{ThemeResource CorvidBg}" BorderBrush="{ThemeResource CorvidLine}" BorderThickness="1"
              CornerRadius="10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- The surface's name and its field. -->
          <StackPanel Padding="14,12,14,10" Spacing="8" BorderBrush="{ThemeResource CorvidLine}" BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource CorvidText2}"
                         TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
              <controls:CorvidButton Grid.Column="1" Style="{StaticResource CorvidSmallButton}" Variant="Ghost" Content="Close"
                                     Foreground="{ThemeResource CorvidText2}" Click="OnCloseClick" ToolTipService.ToolTip="Esc" />
            </Grid>
            <Grid ColumnSpacing="8" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasQuery), Mode=OneWay}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <controls:Icon Kind="Search" Foreground="{ThemeResource CorvidText2}" VerticalAlignment="Center" />
              <TextBox x:Name="QueryBox" Grid.Column="1" FontSize="14" MinHeight="32" Padding="10,6" CornerRadius="6"
                       BorderBrush="{ThemeResource CorvidLine}" PlaceholderText="{x:Bind ViewModel.Placeholder, Mode=OneWay}"
                       Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="{x:Bind ViewModel.Placeholder, Mode=OneWay}" />
            </Grid>
          </StackPanel>

          <!-- What a pending feature comes with, a failure, or what a choice did. -->
          <controls:ToneRow Grid.Row="1" Margin="12,10,12,0" Tone="{x:Bind ViewModel.NoteTone, Mode=OneWay}"
                            Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasNote), Mode=OneWay}" AutomationProperties.LiveSetting="Polite">
            <TextBlock Text="{x:Bind ViewModel.Note, Mode=OneWay}" TextWrapping="Wrap" LineHeight="18.125" LineStackingStrategy="BlockLineHeight" />
          </controls:ToneRow>

          <Grid Grid.Row="2">
            <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6,6,6,6"
                          Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasItems), Mode=OneWay}">
              <ItemsControl x:Name="List" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" IsTabStop="False"
                            AutomationProperties.Name="{x:Bind ViewModel.Title, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="palette:PaletteItem">
                    <StackPanel>
                      <TextBlock Text="{x:Bind GroupHeader, Mode=OneWay}" Margin="10,8,10,4" FontSize="11.5" FontWeight="SemiBold"
                                 Foreground="{ThemeResource CorvidText2}" Visibility="{x:Bind ui:Ui.VisibleIf(HasGroupHeader), Mode=OneWay}"
                                 AutomationProperties.HeadingLevel="Level3" />
                      <Grid>
                        <Border CornerRadius="6" Background="{ThemeResource CorvidAccentBg}"
                                Visibility="{x:Bind ui:Ui.VisibleIf(IsSelected), Mode=OneWay}" />
                        <!-- The selected row's mark as a shape, not colour alone: a bar at its left edge (Enter runs this row). -->
                        <Border Width="3" Margin="2,8,0,8" HorizontalAlignment="Left" CornerRadius="1.5" Background="{ThemeResource CorvidAccent}"
                                IsHitTestVisible="False" Visibility="{x:Bind ui:Ui.VisibleIf(IsSelected), Mode=OneWay}" />
                        <Button Style="{StaticResource PaletteRow}" Command="{x:Bind Choose, Mode=OneWay}" CommandParameter="{x:Bind}"
                                AutomationProperties.Name="{x:Bind AutomationName}">
                          <Grid ColumnSpacing="10" Opacity="{x:Bind shell:CommandPalette.RowOpacity(IsEnabled)}">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:Icon Kind="{x:Bind Icon}" Foreground="{ThemeResource CorvidText2}" VerticalAlignment="Top" Margin="0,2,0,0"
                                           Visibility="{x:Bind shell:CommandPalette.IconVisible(Icon)}" />
                            <StackPanel Grid.Column="1" Spacing="1">
                              <TextBlock Text="{x:Bind Title}" FontSize="13.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{x:Bind Detail}" FontSize="12" Foreground="{ThemeResource CorvidText2}" TextWrapping="NoWrap"
                                         TextTrimming="CharacterEllipsis" Visibility="{x:Bind ui:Ui.VisibleIf(HasDetail)}" />
                              <TextBlock Text="{x:Bind Note}" FontSize="12" Foreground="{ThemeResource CorvidAmber}" TextWrapping="Wrap"
                                         Visibility="{x:Bind ui:Ui.VisibleIf(HasNote)}" />
                            </StackPanel>
                            <controls:HintLine Grid.Column="2" Parts="{x:Bind KeyParts}" VerticalAlignment="Top" Margin="0,1,0,0"
                                               Visibility="{x:Bind ui:Ui.VisibleIf(HasKey)}" />
                          </Grid>
                        </Button>
                      </Grid>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock Margin="20,16,20,18" Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" Style="{StaticResource CorvidMutedText}" TextWrapping="Wrap"
                       Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.ShowEmpty), Mode=OneWay}" />
            <TextBlock Margin="20,16,20,18" Text="Loading…" Style="{StaticResource CorvidMutedText}"
                       Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.IsLoading), Mode=OneWay}" />
            <!-- The selected row, said politely as the arrows move it (PaletteViewModel.SelectionText). -->
            <TextBlock x:Name="SelectionAnnouncer" Width="1" Height="1" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left"
                       VerticalAlignment="Top" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Palette selection" />
          </Grid>

          <!-- The count, and the keys that work here. -->
          <Grid Grid.Row="3" Padding="14,8" ColumnSpacing="12" Background="{ThemeResource CorvidBg2}" BorderBrush="{ThemeResource CorvidLine}"
                BorderThickness="0,1,0,0" CornerRadius="0,0,10,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource CorvidText2}" VerticalAlignment="Center"
                       Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasItems), Mode=OneWay}" />
            <controls:HintLine x:Name="FooterHint" Grid.Column="1" Parts="{x:Bind shell:CommandPalette.Footer}" />
          </Grid>
        </Grid>
      </Border>
    </ContentControl>
  </Grid>
</UserControl>

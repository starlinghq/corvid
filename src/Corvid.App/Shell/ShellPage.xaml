<Page x:Class="Corvid.App.Shell.ShellPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:shell="using:Corvid.App.Shell"
      xmlns:controls="using:Corvid.App.Controls"
      xmlns:coreshell="using:Corvid.App.Core.Shell"
      xmlns:infra="using:Corvid.App.Infrastructure"
      Background="{ThemeResource CorvidBg}"
      Foreground="{ThemeResource CorvidText}"
      FontSize="13.5"
      KeyboardAcceleratorPlacementMode="Hidden">
  <!--
    The shell (docs/plan/ui.md §3, Main.dc.html): rail 260 px, the content frame, the dock 380 px, the status bar 28 px.
    Under 1180 px the dock opens over the content; under 860 px the rail does too; under 720 px the phone layout takes over
    with its top bar and the Chat, Changes, Attention, More bar. The view model decides what shows; this page draws it.
  -->
  <Grid x:Name="Root">
    <Grid x:Name="Layout">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- .ph-top: the phone's top bar. -->
      <Grid Grid.ColumnSpan="3" Padding="14,14,14,10" ColumnSpacing="8" Background="{ThemeResource CorvidBg}"
            BorderBrush="{ThemeResource CorvidLine}" BorderThickness="0,0,0,1"
            Visibility="{x:Bind infra:Ui.VisibleIf(ViewModel.ShowPhoneBars), Mode=OneWay}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <controls:IconButton Icon="Menu" VerticalAlignment="Center" Command="{x:Bind ViewModel.ToggleRailCommand}"
                             Visibility="{x:Bind infra:Ui.VisibleIf(ViewModel.ShowPhoneTabs), Mode=OneWay}"
                             AutomationProperties.Name="Sessions and areas" ToolTipService.ToolTip="Sessions and areas" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <!-- The level-1 heading where the page drops its own title on the phone (ShellViewModel.PhoneTitleIsHeading). -->
          <TextBlock x:Name="PhoneTitleText" Text="{x:Bind ViewModel.PhoneTitle, Mode=OneWay}" Style="{StaticResource CorvidSessionTitle}" FontSize="14"
                     LineHeight="20.3" AutomationProperties.HeadingLevel="Level1" />
          <TextBlock Text="{x:Bind ViewModel.PhoneSubtitle, Mode=OneWay}" Style="{StaticResource CorvidSmallText}" TextWrapping="NoWrap"
                     TextTrimming="CharacterEllipsis" Visibility="{x:Bind infra:Ui.VisibleIfText(ViewModel.PhoneSubtitle), Mode=OneWay}" />
        </StackPanel>
        <ItemsControl Grid.Column="2" ItemsSource="{x:Bind ViewModel.PhoneTags, Mode=OneWay}" IsTabStop="False" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="coreshell:StatusTag">
              <controls:TagChip Text="{x:Bind Text}" Tone="{x:Bind Tone}" ToolTipService.ToolTip="{x:Bind Detail}"
                                AutomationProperties.Name="{x:Bind Text}" AutomationProperties.HelpText="{x:Bind Detail}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <controls:IconButton Grid.Column="3" Icon="Bell" VerticalAlignment="Center"
                             Count="{x:Bind ViewModel.AttentionText, Mode=OneWay}"
                             Command="{x:Bind ViewModel.OpenAttentionCommand}"
                             Visibility="{x:Bind infra:Ui.VisibleIf(ViewModel.ShowPhoneTabs), Mode=OneWay}"
                             AutomationProperties.Name="{x:Bind ViewModel.AttentionName, Mode=OneWay}" />
      </Grid>

      <shell:RailView Grid.Row="1" ViewModel="{x:Bind ViewModel}"
                      Visibility="{x:Bind infra:Ui.VisibleIf(ViewModel.ShowRail), Mode=OneWay}" />

      <Frame x:Name="ContentFrame" Grid.Row="1" Grid.Column="1" Background="{ThemeResource CorvidBg}" IsTabStop="False">
        <Frame.ContentTransitions>
          <TransitionCollection />
        </Frame.ContentTransitions>
      </Frame>

      <!-- .dock: bg-2 with a line on the left; its content comes from the page. -->
      <Border Grid.Row="1" Grid.Column="2" Width="380" Background="{ThemeResource CorvidBg2}" BorderBrush="{ThemeResource CorvidLine}"
              BorderThickness="1,0,0,0" Visibility="{x:Bind infra:Ui.VisibleIf(ViewModel.ShowDock), Mode=OneWay}"
              AutomationProperties.Name="Panels">
        <ContentPresenter x:Name="DockColumnHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      </Border>

      <shell:StatusBarView Grid.Row="2" Grid.ColumnSpan="3" Shell="{x:Bind ViewModel}"
                           Visibility="{x:Bind infra:Ui.VisibleIf(ViewModel.ShowStatusBar), Mode=OneWay}" />

      <!-- .ph-bar: the phone's bottom bar. -->
      <Grid Grid.Row="2" Grid.ColumnSpan="3" Padding="4,6,4,10" Background="{ThemeResource CorvidBg2}"
            BorderBrush="{ThemeResource CorvidLine}" BorderThickness="0,1,0,0"
            Visibility="{x:Bind infra:Ui.VisibleIf(ViewModel.ShowPhoneTabs), Mode=OneWay}"
            AutomationProperties.Name="Sections">
        <ItemsControl ItemsSource="{x:Bind ViewModel.PhoneTabs}" IsTabStop="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <shell:EqualColumnsPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="coreshell:PhoneTab">
              <controls:PhoneTabItem Icon="{x:Bind Icon}" Label="{x:Bind Label}" Count="{x:Bind CountText, Mode=OneWay}"
                                     IsSelected="{x:Bind IsSelected, Mode=OneWay}" Command="{x:Bind Open}"
                                     AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Grid>

    <!-- Overlays: a scrim that closes them, the rail from the left, the dock from the right above the status bar. -->
    <Grid x:Name="Overlays">
      <Border Background="#66000000" Tapped="OnScrimTapped"
              Visibility="{x:Bind infra:Ui.VisibleIf(ViewModel.ShowScrim), Mode=OneWay}" />
      <shell:RailView x:Name="RailOverlay" HorizontalAlignment="Left" ViewModel="{x:Bind ViewModel}"
                      Visibility="{x:Bind infra:Ui.VisibleIf(ViewModel.ShowRailOverlay), Mode=OneWay}" />
      <Border Width="380" Margin="0,0,0,28" HorizontalAlignment="Right" Background="{ThemeResource CorvidBg2}"
              BorderBrush="{ThemeResource CorvidLine}" BorderThickness="1,0,0,0"
              Visibility="{x:Bind infra:Ui.VisibleIf(ViewModel.ShowDockOverlay), Mode=OneWay}"
              AutomationProperties.Name="Panels">
        <ContentPresenter x:Name="DockOverlayHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      </Border>
    </Grid>
  </Grid>
</Page>

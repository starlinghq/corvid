<UserControl x:Class="Corvid.App.Shell.RailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Corvid.App.Controls"
             xmlns:coreshell="using:Corvid.App.Core.Shell"
             xmlns:infra="using:Corvid.App.Infrastructure"
             Width="260">
  <!-- .rail: bg-2, a line on the right, 12px 10px padding; brand, destinations, session groups, then the footer. -->
  <Border Background="{ThemeResource CorvidBg2}" BorderBrush="{ThemeResource CorvidLine}" BorderThickness="0,0,1,0">
    <Grid Padding="10,12,10,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- .brand: the logo tile, the name and workspace, the attention bell. -->
      <Grid Padding="6,4,6,12" ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="28" Height="28" CornerRadius="8" Background="{ThemeResource CorvidText}" VerticalAlignment="Center">
          <controls:Icon Kind="Logo" Foreground="{ThemeResource CorvidBg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <!-- Single lines centred in the CSS's line boxes (16.8 and 17.4 px): the half-leading as padding. -->
          <TextBlock Text="Corvid" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource CorvidText}" />
          <TextBlock Text="{x:Bind ViewModel.Workspace, Mode=OneWay}" FontSize="12" Padding="0,1.44" Foreground="{ThemeResource CorvidText2}"
                     TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <controls:IconButton Grid.Column="2" Icon="Bell" VerticalAlignment="Center"
                             Count="{x:Bind ViewModel.AttentionText, Mode=OneWay}"
                             Command="{x:Bind ViewModel.OpenAttentionCommand}"
                             AutomationProperties.Name="{x:Bind ViewModel.AttentionName, Mode=OneWay}"
                             ToolTipService.ToolTip="{x:Bind ViewModel.AttentionName, Mode=OneWay}" />
      </Grid>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <!-- .nav: the destinations. -->
          <ItemsControl ItemsSource="{x:Bind ViewModel.NavItems}" IsTabStop="False" AutomationProperties.Name="Main">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <controls:PitchedStackPanel Pitch="31.575" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="coreshell:NavItem">
                <controls:RailNavItem Icon="{x:Bind Icon}" Label="{x:Bind Label}" Badge="{x:Bind BadgeText, Mode=OneWay}"
                                      IsSelected="{x:Bind IsSelected, Mode=OneWay}" Command="{x:Bind Open}"
                                      AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- .section-title and .sessions: Pinned, Recent. -->
          <ItemsControl ItemsSource="{x:Bind ViewModel.SessionGroups}" IsTabStop="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="coreshell:SessionGroup">
                <StackPanel>
                  <!-- 14px 8px 4px around a 15.95 px line: the half-leading added to the padding. -->
                  <TextBlock Text="{x:Bind infra:Ui.Upper(Title)}" Style="{StaticResource CorvidSectionTitle}" Padding="8,15.32,8,5.32"
                             AutomationProperties.Name="{x:Bind Title}" AutomationProperties.HeadingLevel="Level2" />
                  <ItemsControl ItemsSource="{x:Bind Sessions}" IsTabStop="False" AutomationProperties.Name="{x:Bind Title}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <controls:PitchedStackPanel Pitch="29.575" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="coreshell:SessionListItem">
                        <controls:RailSessionItem Title="{x:Bind Title, Mode=OneWay}" When="{x:Bind When, Mode=OneWay}"
                                                  State="{x:Bind State, Mode=OneWay}" IsSelected="{x:Bind IsSelected, Mode=OneWay}"
                                                  Command="{x:Bind Open}"
                                                  AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                                                  ToolTipService.ToolTip="{x:Bind StateLabel, Mode=OneWay}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <!-- .rail-foot: a line above, Settings and Doctor. -->
      <Border Grid.Row="2" BorderBrush="{ThemeResource CorvidLine}" BorderThickness="0,1,0,0" Padding="8,12,8,0">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <controls:LinkButton Text="Settings" Command="{x:Bind ViewModel.OpenSettingsCommand}" />
          <controls:LinkButton Text="Doctor" Command="{x:Bind ViewModel.OpenDoctorCommand}"
                               ToolTipService.ToolTip="The checks corvid doctor runs, each with its fix" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>

<UserControl x:Class="Corvid.App.Pages.AttentionList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Corvid.App.Controls"
             xmlns:board="using:Corvid.App.Core.Board"
             xmlns:local="using:Corvid.App.Pages"
             Foreground="{ThemeResource CorvidText}"
             FontSize="13.5">
  <!--
    The attention tray's items (Board.dc.html .tray-item: 10px 14px, a line below; the icon 2 px down and 10 from the
    body; what (500), the detail (small, muted) and the buttons 3 apart, the buttons 6 apart). The dock shows them, and on
    a phone the Board's page does.
  -->
  <ItemsControl ItemsSource="{x:Bind Items, Mode=OneWay}" IsTabStop="False" AutomationProperties.Name="Attention">
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="board:AttentionItemViewModel">
        <Grid Padding="14,10" ColumnSpacing="10" BorderBrush="{ThemeResource CorvidLine}" BorderThickness="0,0,0,1"
              AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <local:ToneIcon Kind="{x:Bind Icon}" Tone="{x:Bind IconTone}" Plain="{x:Bind IconPlain}" Margin="0,2,0,0" VerticalAlignment="Top" />
          <StackPanel Grid.Column="1" Spacing="3">
            <TextBlock Text="{x:Bind What, Mode=OneWay}" Style="{StaticResource CorvidBodyText}" FontWeight="Medium" />
            <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource CorvidSmallText}" />
            <ItemsControl ItemsSource="{x:Bind Buttons, Mode=OneWay}" IsTabStop="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <controls:WrapRowPanel Spacing="6" LineSpacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="board:AttentionButton">
                  <controls:CorvidButton Content="{x:Bind Label}" Style="{StaticResource CorvidSmallButton}"
                                         Variant="{x:Bind local:AttentionList.Variant(IsGhost)}"
                                         local:ThemedForeground.Key="{x:Bind local:AttentionList.LabelKey(IsLink, IsDanger)}"
                                         Command="{x:Bind Command}" ToolTipService.ToolTip="{x:Bind Help}"
                                         AutomationProperties.HelpText="{x:Bind Help}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>

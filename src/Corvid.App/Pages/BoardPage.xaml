<Page x:Class="Corvid.App.Pages.BoardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Corvid.App.Controls"
      xmlns:board="using:Corvid.App.Core.Board"
      xmlns:coreshell="using:Corvid.App.Core.Shell"
      xmlns:mvvm="using:Corvid.App.Core.Mvvm"
      xmlns:local="using:Corvid.App.Pages"
      xmlns:ui="using:Corvid.App.Infrastructure"
      Background="{ThemeResource CorvidBg}"
      Foreground="{ThemeResource CorvidText}"
      FontSize="13.5">
  <!--
    The Board (Board.png, Board-narrow.png; docs/plan/ui.md §4.13, F18): the page head with the counts, the filter and
    the buttons that start work; the session cards two to a row (one on a phone), each row as tall as its tallest card;
    and a peek that shows a session's latest exchange read-only. The attention tray is BoardDock, in the shell's dock.
    Sizes and colours are corvid.css's: .page-head, .page-body, .cards, .scard, .state, .foot, .tag, .btn.sm, .seg.
  -->
  <Page.Resources>
    <!-- .scard: a line border (amber while it waits on you), radius 10, 12px 14px, rows 8 apart, the foot at the bottom. -->
    <DataTemplate x:Key="CardTemplate" x:DataType="board:SessionCardViewModel">
      <ContentControl IsTabStop="True" UseSystemFocusVisuals="True" FocusVisualPrimaryBrush="{ThemeResource CorvidAccent}"
                      FocusVisualSecondaryBrush="{ThemeResource CorvidBg}" HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch" AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
        <Grid>
          <Border CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CorvidLine}" Background="{ThemeResource CorvidBg}"
                  Visibility="{x:Bind ui:Ui.CollapsedIf(IsWaiting), Mode=OneWay}" />
          <Border CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CorvidAmber}" Background="{ThemeResource CorvidBg}"
                  Visibility="{x:Bind ui:Ui.VisibleIf(IsWaiting), Mode=OneWay}" />
          <Grid Padding="14,12" RowSpacing="8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource CorvidBodyText}" FontWeight="SemiBold" TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" AutomationProperties.HeadingLevel="Level3" />
            <TextBlock Grid.Row="1" Style="{StaticResource CorvidSmallText}" controls:RichText.Runs="{x:Bind Meta, Mode=OneWay}" />
            <!-- .state: the dot, then the state in bold and what follows it, 12.5 px; a long target wraps under the state. -->
            <Grid Grid.Row="2" ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <local:ToneDot Tone="{x:Bind StateTone, Mode=OneWay}" VerticalAlignment="Top" Margin="0,5,0,0" />
              <TextBlock Grid.Column="1" FontSize="12.5" LineHeight="18.1" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                         controls:RichText.Runs="{x:Bind local:BoardPage.StateRuns(StateLabel, StateDetail), Mode=OneWay}" />
            </Grid>
            <TextBlock Grid.Row="3" Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource CorvidSmallText}"
                       Visibility="{x:Bind ui:Ui.VisibleIfText(Detail), Mode=OneWay}" />
            <!-- .foot: tags then buttons, 8 apart, at the card's bottom. -->
            <controls:WrapRowPanel Grid.Row="4" Spacing="8" LineSpacing="8" VerticalAlignment="Bottom">
              <ItemsControl ItemsSource="{x:Bind Tags, Mode=OneWay}" IsTabStop="False" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="coreshell:StatusTag">
                    <controls:TagChip Text="{x:Bind Text}" Tone="{x:Bind Tone}" ToolTipService.ToolTip="{x:Bind Detail}"
                                      AutomationProperties.Name="{x:Bind Text}" AutomationProperties.HelpText="{x:Bind Detail}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <controls:CorvidButton Content="Open" Style="{StaticResource CorvidSmallButton}" Foreground="{ThemeResource CorvidAccent}"
                                     Command="{x:Bind OpenCommand}" Visibility="{x:Bind ui:Ui.VisibleIf(CanOpen), Mode=OneWay}"
                                     ToolTipService.ToolTip="Open it here as the current session (Enter)" />
              <controls:CorvidButton Content="Peek" Style="{StaticResource CorvidSmallButton}" Variant="Ghost"
                                     Command="{x:Bind PeekCommand}" Visibility="{x:Bind ui:Ui.VisibleIf(CanPeek), Mode=OneWay}"
                                     ToolTipService.ToolTip="Watch its latest exchange read-only, without opening it (Space)" />
              <controls:CorvidButton Content="Take over" Style="{StaticResource CorvidSmallButton}" Variant="Ghost"
                                     Command="{x:Bind TakeOverCommand}" Visibility="{x:Bind ui:Ui.VisibleIf(IsReadOnly), Mode=OneWay}"
                                     ToolTipService.ToolTip="Another process drives it; it can be taken over once that process lets go" />
              <controls:CorvidButton Content="Open run" Style="{StaticResource CorvidSmallButton}"
                                     Command="{x:Bind OpenRunCommand}" Visibility="{x:Bind ui:Ui.VisibleIf(IsJob), Mode=OneWay}"
                                     ToolTipService.ToolTip="Open the run as it ran, read-only (Enter)" />
              <controls:CorvidButton Content="Jobs" Style="{StaticResource CorvidSmallButton}" Variant="Ghost" Foreground="{ThemeResource CorvidAccent}"
                                     Command="{x:Bind OpenJobsCommand}" Visibility="{x:Bind ui:Ui.VisibleIf(IsJob), Mode=OneWay}"
                                     ToolTipService.ToolTip="The job's schedule and its other runs" />
            </controls:WrapRowPanel>
          </Grid>
        </Grid>
      </ContentControl>
    </DataTemplate>

    <!-- The dashed card: start another session or open a workspace, 10 apart, centred in its row. -->
    <DataTemplate x:Key="NewSessionTemplate" x:DataType="board:NewSessionTile">
      <Grid>
        <Rectangle RadiusX="10" RadiusY="10" Stroke="{ThemeResource CorvidLine}" StrokeThickness="1" StrokeDashArray="3,3" />
        <StackPanel Padding="14,12" Spacing="10" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource CorvidMutedText}" controls:RichText.Runs="{x:Bind Text}"
                     AutomationProperties.Name="{x:Bind AutomationName}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <controls:CorvidButton Content="New session" Style="{StaticResource CorvidSmallButton}" Command="{x:Bind NewSessionCommand}"
                                   ToolTipService.ToolTip="Starting a session comes with the engine (Corvid.App.Engine)" />
            <controls:CorvidButton Content="Open a workspace…" Style="{StaticResource CorvidSmallButton}" Variant="Ghost"
                                   Command="{x:Bind OpenWorkspaceCommand}"
                                   ToolTipService.ToolTip="Opening a workspace comes with the engine (Corvid.App.Engine)" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </DataTemplate>

    <local:BoardTileTemplateSelector x:Key="TileSelector" Card="{StaticResource CardTemplate}" NewSession="{StaticResource NewSessionTemplate}" />
  </Page.Resources>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- .page-head: the title, the counts and the filter on one line; the buttons wrap under them as the mockup's do. -->
    <Border x:Name="HeadBorder" Style="{StaticResource CorvidPageHead}">
      <controls:WrapRowPanel x:Name="Head" Spacing="12" LineSpacing="12">
        <controls:WrapRowPanel Spacing="12" LineSpacing="6">
          <TextBlock x:Name="PageTitle" Text="{x:Bind ViewModel.Title}" Style="{StaticResource CorvidPageTitle}" VerticalAlignment="Center"
                     AutomationProperties.HeadingLevel="Level1" />
          <TextBlock Text="{x:Bind ViewModel.Counts, Mode=OneWay}" Style="{StaticResource CorvidMutedText}" TextWrapping="NoWrap"
                     VerticalAlignment="Center" />
          <!-- .seg: all, running, waiting on you, jobs. -->
          <Border Height="20" BorderBrush="{ThemeResource CorvidLine}" BorderThickness="1" CornerRadius="6" VerticalAlignment="Center">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Filters}" IsTabStop="False" AutomationProperties.Name="Filter">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="mvvm:Choice">
                  <controls:SegmentButton Content="{x:Bind Label}" IsChecked="{x:Bind IsSelected, Mode=OneWay}" Command="{x:Bind Choose}"
                                          AutomationProperties.HelpText="{x:Bind Description}" ToolTipService.ToolTip="{x:Bind Description}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </controls:WrapRowPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <controls:CorvidButton Content="Open a workspace…" Command="{x:Bind ViewModel.OpenWorkspaceCommand}"
                                 ToolTipService.ToolTip="{x:Bind ViewModel.UnavailableReason}" />
          <controls:CorvidButton Content="New session" Variant="Primary" Command="{x:Bind ViewModel.NewSessionCommand}"
                                 ToolTipService.ToolTip="{x:Bind ViewModel.UnavailableReason}" />
        </StackPanel>
      </controls:WrapRowPanel>
    </Border>

    <!-- .page-body: 18px 24px; .cards: two equal columns 14 apart, one under 600 px of content. -->
    <ScrollViewer x:Name="Body" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
      <StackPanel x:Name="BodyPanel" Padding="24,18,24,18" Spacing="18">
        <!-- On a phone the dock is gone: the tray's items lead the page (the bottom bar's Attention lands here). -->
        <StackPanel x:Name="PhoneAttention" Visibility="Collapsed" Spacing="8">
          <TextBlock Text="{x:Bind ViewModel.AttentionHead, Mode=OneWay}" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
          <Border Style="{StaticResource CorvidPanel}" Background="{ThemeResource CorvidBg2}">
            <local:AttentionList Items="{x:Bind ViewModel.Attention, Mode=OneWay}" Margin="0,0,0,-1" />
          </Border>
        </StackPanel>
        <ItemsControl x:Name="CardGrid" ItemsSource="{x:Bind ViewModel.Tiles}" ItemTemplateSelector="{StaticResource TileSelector}"
                      IsTabStop="False" AutomationProperties.Name="Sessions">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <controls:ColumnsPanel Columns="2" Spacing="14" MinColumnWidth="290" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" Style="{StaticResource CorvidMutedText}"
                   Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.IsEmpty), Mode=OneWay}" />
        <!-- Under 1180 px the dock is an overlay; Board-narrow.png lays the tray out below the cards instead. -->
        <Border x:Name="InlineAttention" Visibility="Collapsed" Style="{StaticResource CorvidPanel}" Background="{ThemeResource CorvidBg2}"
                AutomationProperties.Name="Attention">
          <StackPanel>
            <Grid Padding="14,12" BorderBrush="{ThemeResource CorvidLine}" BorderThickness="0,0,0,1" ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Bind ViewModel.AttentionHead, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis" AutomationProperties.HeadingLevel="Level2" />
              <controls:CorvidButton Grid.Column="1" Content="{x:Bind ViewModel.NotifyLabel, Mode=OneWay}" Style="{StaticResource CorvidSmallButton}"
                                     Variant="Ghost" Command="{x:Bind ViewModel.ToggleNotifyCommand}"
                                     ToolTipService.ToolTip="{x:Bind ViewModel.NotifyUnavailableReason}" />
            </Grid>
            <local:AttentionList Items="{x:Bind ViewModel.Attention, Mode=OneWay}" />
            <TextBlock Margin="14,12" Style="{StaticResource CorvidSmallText}" Text="Nothing waits on you."
                       Visibility="{x:Bind ui:Ui.CollapsedIf(ViewModel.HasAttention), Mode=OneWay}" />
            <Border Padding="14,12" BorderBrush="{ThemeResource CorvidLine}" BorderThickness="0,1,0,0">
              <TextBlock Style="{StaticResource CorvidSmallText}" TextWrapping="Wrap"
                         Text="Nothing here is answered from a bare button: approvals open their full card, with the parsed command, reasons and diff." />
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Peek: a session's latest exchange, read-only and live, over the cards. Esc or Close goes back. -->
    <Grid Grid.Row="1" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.IsPeeking), Mode=OneWay}">
      <Border Background="#66000000" Tapped="OnPeekScrimTapped" />
      <Border x:Name="PeekPanel" Style="{StaticResource CorvidPanel}" Margin="24,18,24,18" MaxWidth="680" VerticalAlignment="Top"
              AutomationProperties.Name="Peek">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <!-- .panel-head: the session, its state, and Open and Close. -->
          <Grid Padding="14,10" ColumnSpacing="10" BorderBrush="{ThemeResource CorvidLine}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
              <TextBlock Text="{x:Bind ViewModel.Peek.Card.Title, Mode=OneWay}" Style="{StaticResource CorvidBodyText}" FontWeight="SemiBold"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" AutomationProperties.HeadingLevel="Level2" />
              <TextBlock Text="{x:Bind local:BoardPage.PeekState(ViewModel.Peek.Card.StateLabel, ViewModel.Peek.Card.Detail), Mode=OneWay}" Style="{StaticResource CorvidSmallText}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
              <controls:CorvidButton x:Name="PeekOpen" Content="Open" Style="{StaticResource CorvidSmallButton}" Foreground="{ThemeResource CorvidAccent}"
                                     Click="OnPeekOpen" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.Peek.Card.CanOpen), Mode=OneWay}"
                                     ToolTipService.ToolTip="Open it here as the current session" />
              <controls:CorvidButton x:Name="PeekClose" Content="Close" Style="{StaticResource CorvidSmallButton}" Variant="Ghost"
                                     Command="{x:Bind ViewModel.ClosePeekCommand}" ToolTipService.ToolTip="Back to the Board (Esc)" />
            </StackPanel>
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <StackPanel Padding="14,12" Spacing="8">
              <TextBlock Text="{x:Bind ViewModel.Peek.Note, Mode=OneWay}" Style="{StaticResource CorvidSmallText}" />
              <ItemsControl ItemsSource="{x:Bind ViewModel.Peek.Entries, Mode=OneWay}" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="6" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="board:PeekLine">
                    <Grid ColumnSpacing="10" AutomationProperties.Name="{x:Bind AutomationName}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{x:Bind Label}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource CorvidText2}"
                                 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" LineHeight="18.1" LineStackingStrategy="BlockLineHeight" />
                      <TextBlock Grid.Column="1" controls:RichText.Runs="{x:Bind Runs}" FontSize="12.5" LineHeight="18.1" LineStackingStrategy="BlockLineHeight"
                                 TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="{x:Bind ui:Ui.CollapsedIf(IsCode)}" />
                      <TextBlock Grid.Column="1" Text="{x:Bind Text}" Style="{StaticResource CorvidMonoText}" TextWrapping="Wrap"
                                 IsTextSelectionEnabled="True" Visibility="{x:Bind ui:Ui.VisibleIf(IsCode)}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>

<Page x:Class="Corvid.App.Pages.SessionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Corvid.App.Controls"
      xmlns:core="using:Corvid.App.Core"
      xmlns:sessions="using:Corvid.App.Core.Sessions"
      xmlns:diffs="using:Corvid.App.Core.Diffs"
      xmlns:local="using:Corvid.App.Pages"
      xmlns:ui="using:Corvid.App.Infrastructure"
      Background="{ThemeResource CorvidBg}"
      Foreground="{ThemeResource CorvidText}"
      FontSize="13.5">
  <!--
    The Sessions area (Main.png, Approval.png; docs/plan/ui.md §4.1 to §4.6): the conversation header, the transcript as a
    virtualised list with one template per block kind, the turn strip with the queue, and the composer. The dock's panels
    are SessionsDock. Sizes and colours are corvid.css's: .conv-head, .transcript, .msg.user, .turn-head, .chips, .row,
    .card, .answer, .approval, .turnstrip and .composer.
  -->
  <Page.Resources>
    <!-- .who: 12 px, semibold, text-2. -->
    <Style x:Key="WhoText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{ThemeResource CorvidText2}" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- .pill: 22 high, 0 8px, radius 11, bg-3, 12 px text-2. -->
    <Style x:Key="Pill" TargetType="Border">
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Background" Value="{ThemeResource CorvidBg3}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- .card: a line border, radius 8, on bg. -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="BorderBrush" Value="{ThemeResource CorvidLine}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{ThemeResource CorvidBg}" />
    </Style>

    <!-- .kv .k: the parsed command's labels, 12.5 px text-2, at least 64 wide. -->
    <Style x:Key="KeyLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="MinWidth" Value="64" />
      <Setter Property="Foreground" Value="{ThemeResource CorvidText2}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="MonoSmall" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource CorvidMono}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- .linkbtn: a muted, underlined text button (thought for 4 s). -->
    <Style x:Key="MutedLinkButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="UseSystemFocusVisuals" Value="True" />
      <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource CorvidAccent}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <TextBlock x:Name="LabelText" Text="{TemplateBinding Content}" FontSize="12.5" Foreground="{ThemeResource CorvidText2}"
                         TextDecorations="Underline" TextWrapping="NoWrap" />
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                      <Setter Target="LabelText.Foreground" Value="{ThemeResource CorvidText}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Pressed" />
                  <VisualState x:Name="Disabled" />
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- .opt: an approval answer, 34 high, 0 12px, radius 7, a line border, weight 500; the focus outline 2 px accent at 1 px. -->
    <Style x:Key="OptionButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="UseSystemFocusVisuals" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Root">
              <Border x:Name="Face" Height="34" CornerRadius="7" BorderThickness="1" BorderBrush="{ThemeResource CorvidLine}"
                      Background="{ThemeResource CorvidBg}" />
              <Border x:Name="Film" Height="34" CornerRadius="7" Background="{ThemeResource CorvidText}" Opacity="0.05" Visibility="Collapsed" />
              <ContentPresenter Content="{TemplateBinding Content}" Padding="12,0" VerticalAlignment="Center" />
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                      <Setter Target="Film.Visibility" Value="Visible" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                      <Setter Target="Film.Visibility" Value="Visible" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Disabled">
                    <VisualState.Setters>
                      <Setter Target="Root.Opacity" Value="0.5" />
                    </VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The phone's .opt: at least 44 high, the label centred; the same face and states as OptionButton. -->
    <Style x:Key="PhoneOptionButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="UseSystemFocusVisuals" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Root" MinHeight="44">
              <Border x:Name="Face" CornerRadius="7" BorderThickness="1" BorderBrush="{ThemeResource CorvidLine}" Background="{ThemeResource CorvidBg}" />
              <Border x:Name="Film" CornerRadius="7" Background="{ThemeResource CorvidText}" Opacity="0.05" Visibility="Collapsed" />
              <ContentPresenter Content="{TemplateBinding Content}" Padding="10,6" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                      <Setter Target="Film.Visibility" Value="Visible" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                      <Setter Target="Film.Visibility" Value="Visible" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Disabled">
                    <VisualState.Setters>
                      <Setter Target="Root.Opacity" Value="0.5" />
                    </VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The user's message (.msg.user): bg-2, a line border, radius 10, 10px 14px; "you · 14:01" above the text. -->
    <DataTemplate x:Key="UserTemplate" x:DataType="sessions:UserMessageBlock">
      <Border Margin="{x:Bind local:SessionsPage.Gap(StartsTurn)}" Background="{ThemeResource CorvidBg2}" BorderBrush="{ThemeResource CorvidLine}"
              BorderThickness="1" CornerRadius="10" Padding="14,10" AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
        <Border.ContextFlyout>
          <MenuFlyout>
            <MenuFlyoutItem Text="Branch from here" Click="OnBranchFromHere" />
          </MenuFlyout>
        </Border.ContextFlyout>
        <StackPanel Spacing="4">
          <TextBlock Text="{x:Bind Who, Mode=OneWay}" Style="{StaticResource WhoText}" />
          <TextBlock Text="{x:Bind Text, Mode=OneWay}" Style="{StaticResource CorvidBodyText}" IsTextSelectionEnabled="True" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- .turn-head: "corvid · turn 12" and its measures, baseline-aligned, gap 10. -->
    <DataTemplate x:Key="TurnHeaderTemplate" x:DataType="sessions:TurnHeaderBlock">
      <controls:WrapRowPanel Margin="{x:Bind local:SessionsPage.Gap(StartsTurn)}" Spacing="10" LineSpacing="2"
                             AutomationProperties.HeadingLevel="Level2">
        <TextBlock Text="{x:Bind Who, Mode=OneWay}" Style="{StaticResource WhoText}" VerticalAlignment="Bottom" />
        <TextBlock Text="{x:Bind Detail, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource CorvidText2}" VerticalAlignment="Bottom"
                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
      </controls:WrapRowPanel>
    </DataTemplate>

    <!-- .chips: 22 high, 0 8px, radius 6, a line border on bg-2, 12 px; the question bold in the text colour; dashed when unsure. -->
    <DataTemplate x:Key="DecisionsTemplate" x:DataType="sessions:DecisionsBlock">
      <ItemsControl ItemsSource="{x:Bind Chips, Mode=OneWay}" IsTabStop="False" AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <controls:WrapRowPanel Spacing="6" LineSpacing="6" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="sessions:DecisionChip">
            <Grid Height="22" AutomationProperties.Name="{x:Bind AutomationName}">
              <Border CornerRadius="6" Background="{ThemeResource CorvidBg2}" BorderBrush="{ThemeResource CorvidLine}"
                      BorderThickness="{x:Bind local:SessionsPage.SolidBorder(IsUnsure)}" />
              <Rectangle RadiusX="6" RadiusY="6" Stroke="{ThemeResource CorvidText2}" StrokeThickness="1" StrokeDashArray="3,2"
                         Visibility="{x:Bind ui:Ui.VisibleIf(IsUnsure)}" />
              <StackPanel Orientation="Horizontal" Spacing="5" Padding="8,0" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Question}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource CorvidText}" />
                <TextBlock Text="{x:Bind Text}" FontSize="12" Foreground="{ThemeResource CorvidText2}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DataTemplate>

    <!-- .row.esc: "escalated to claude: step budget (difficulty 0.71) · 2 values redacted · what left the machine". -->
    <DataTemplate x:Key="SwitchTemplate" x:DataType="sessions:SwitchBlock">
      <controls:ToneRow Tone="Violet" AutomationProperties.Name="{x:Bind Text}">
        <controls:WrapRowPanel Spacing="8" LineSpacing="2">
          <controls:Icon Kind="{x:Bind Icon}" VerticalAlignment="Center" />
          <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
            <Run Text="{x:Bind Lead}" /><Run Text=" " /><Run Text="{x:Bind Model}" FontWeight="SemiBold" /><Run Text="{x:Bind local:SessionsPage.Prefixed(': ', Reason)}" />
          </TextBlock>
          <TextBlock Text="{x:Bind local:SessionsPage.Dotted(Redaction)}" Visibility="{x:Bind ui:Ui.VisibleIf(HasRedaction)}" VerticalAlignment="Center" />
          <TextBlock Text="·" Visibility="{x:Bind ui:Ui.VisibleIf(HasEgressLink)}" VerticalAlignment="Center" />
          <controls:LinkButton Text="{x:Bind EgressLinkText}" Command="{x:Bind OpenEgressCommand}" FontSize="12.5"
                               Visibility="{x:Bind ui:Ui.VisibleIf(HasEgressLink)}" VerticalAlignment="Center" />
        </controls:WrapRowPanel>
      </controls:ToneRow>
    </DataTemplate>

    <!-- .row.taint: amber, the lead in bold. -->
    <DataTemplate x:Key="TaintTemplate" x:DataType="sessions:TaintBlock">
      <controls:ToneRow Tone="{x:Bind local:SessionsPage.TaintTone(IsCleared)}" AutomationProperties.Name="{x:Bind AutomationName}">
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <controls:Icon Kind="{x:Bind Icon}" VerticalAlignment="Top" Margin="0,1,0,0" />
          <TextBlock Grid.Column="1" TextWrapping="Wrap" LineHeight="18.1" LineStackingStrategy="BlockLineHeight">
            <Run Text="{x:Bind Lead}" FontWeight="SemiBold" /><Run Text="{x:Bind local:SessionsPage.Prefixed(': ', Text)}" />
          </TextBlock>
        </Grid>
      </controls:ToneRow>
    </DataTemplate>

    <!-- A tool call's card (.card): head (icon, title, state, chevron or Stop), why, the live tail, the expanded output or diffs. -->
    <DataTemplate x:Key="ToolTemplate" x:DataType="sessions:ToolCardBlock">
      <Grid AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
        <Border Style="{StaticResource Card}" />
        <Border CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CorvidAccent}" Visibility="{x:Bind ui:Ui.VisibleIf(IsRunning), Mode=OneWay}" />
        <StackPanel>
          <!-- .card-head: 8px 12px around the 28 px chevron button, 46 high with the border. -->
          <Grid Padding="12,8" MinHeight="44" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:Icon Kind="{x:Bind Icon}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" controls:RichText.Runs="{x:Bind local:SessionsPage.ToolTitle(ToolName, Target, Summary), Mode=OneWay}"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{x:Bind StatusText, Mode=OneWay}" Style="{StaticResource CorvidSmallText}" TextWrapping="NoWrap"
                       VerticalAlignment="Center" Visibility="{x:Bind ui:Ui.CollapsedIf(IsAwaitingApproval), Mode=OneWay}" />
            <controls:TagChip Grid.Column="2" Text="awaiting approval" Tone="Amber" Visibility="{x:Bind ui:Ui.VisibleIf(IsAwaitingApproval), Mode=OneWay}" />
            <controls:CorvidButton Grid.Column="3" Content="Stop" Variant="Ghost" Style="{StaticResource CorvidSmallButton}" Command="{x:Bind StopCommand}"
                                   Visibility="{x:Bind ui:Ui.VisibleIf(IsRunning), Mode=OneWay}"
                                   ToolTipService.ToolTip="Interrupts the turn and keeps the work so far (Esc)" />
            <controls:IconButton Grid.Column="3" Icon="ChevronDown" Command="{x:Bind ToggleCommand}"
                                 Visibility="{x:Bind local:SessionsPage.ChevronVisible(CanExpand, IsRunning), Mode=OneWay}"
                                 AutomationProperties.Name="{x:Bind local:SessionsPage.ExpandName(IsExpanded), Mode=OneWay}" />
          </Grid>
          <TextBlock controls:RichText.Runs="{x:Bind Why, Mode=OneWay}" Visibility="{x:Bind ui:Ui.VisibleIf(HasWhy), Mode=OneWay}"
                     Style="{StaticResource CorvidSmallText}" Margin="38,0,12,8" />
          <Border Margin="1,0,1,1" Padding="10,8" CornerRadius="0,0,7,7" Background="{ThemeResource CorvidCodeBg}" MaxHeight="120"
                  Visibility="{x:Bind ui:Ui.VisibleIf(HasTail), Mode=OneWay}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
              <TextBlock Text="{x:Bind Tail, Mode=OneWay}" Style="{StaticResource CorvidMonoText}" LineHeight="18.75" TextWrapping="NoWrap"
                         IsTextSelectionEnabled="True" AutomationProperties.Name="Output so far" />
            </ScrollViewer>
          </Border>
          <StackPanel Visibility="{x:Bind ui:Ui.VisibleIf(IsExpanded), Mode=OneWay}" Spacing="8" Margin="12,0,12,10">
            <ItemsControl ItemsSource="{x:Bind Diffs, Mode=OneWay}" IsTabStop="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sessions:FileDiffView">
                  <Border BorderBrush="{ThemeResource CorvidLine}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8">
                    <StackPanel>
                      <Grid Padding="12,8" Background="{ThemeResource CorvidBg2}" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Path}" Style="{StaticResource MonoSmall}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                          <TextBlock Text="{x:Bind AddedText}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource CorvidGreen}" />
                          <TextBlock Text="{x:Bind RemovedText}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource CorvidRed}" />
                        </StackPanel>
                      </Grid>
                      <controls:DiffRowsView Rows="{x:Bind Rows}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Padding="10,8" CornerRadius="6" Background="{ThemeResource CorvidCodeBg}" MaxHeight="280"
                    Visibility="{x:Bind ui:Ui.VisibleIfText(Output), Mode=OneWay}">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{x:Bind Output, Mode=OneWay}" Style="{StaticResource CorvidMonoText}" LineHeight="18.75" TextWrapping="NoWrap"
                           IsTextSelectionEnabled="True" />
              </ScrollViewer>
            </Border>
            <controls:LinkButton Text="Show in the Output panel" Command="{x:Bind ShowOutputCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </DataTemplate>

    <!-- The open approval card (section.approval): the amber head with the countdown, then the command, parsed commands,
         reasons, answers, the rule preview or the reason field, and the next prompt in the queue. -->
    <DataTemplate x:Key="ApprovalTemplate" x:DataType="sessions:ApprovalCardBlock">
      <Border BorderBrush="{ThemeResource CorvidAmber}" BorderThickness="1" CornerRadius="10" Background="{ThemeResource CorvidBg}"
              KeyDown="OnApprovalKeyDown" AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
        <StackPanel>
          <Grid Background="{ThemeResource CorvidAmberBg}" Padding="{x:Bind local:SessionsPage.CardHeadPadding(local:SessionsLayout.Current.IsPhone)}"
                ColumnSpacing="10" CornerRadius="9,9,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:Icon Kind="Shield" Foreground="{ThemeResource CorvidAmber}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{x:Bind local:SessionsPage.Pick(local:SessionsLayout.Current.IsPhone, PhoneTitle, Title), Mode=OneWay}"
                       FontWeight="SemiBold" Foreground="{ThemeResource CorvidAmber}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.HeadingLevel="Level3" />
            <TextBlock Grid.Column="2" Text="{x:Bind local:SessionsPage.Pick(local:SessionsLayout.Current.IsPhone, ShortDeadline, DeadlineText), Mode=OneWay}"
                       FontWeight="Medium" Foreground="{ThemeResource CorvidAmber}" VerticalAlignment="Center" />
          </Grid>
          <StackPanel Padding="{x:Bind local:SessionsPage.CardBodyPadding(local:SessionsLayout.Current.IsPhone)}"
                      Spacing="{x:Bind local:SessionsPage.CardSpacing(local:SessionsLayout.Current.IsPhone)}">
            <!-- The phone leaves the command to the tool card above the approval (Phone.png). -->
            <Border Padding="12,10" CornerRadius="6" Background="{ThemeResource CorvidCodeBg}"
                    Visibility="{x:Bind ui:Ui.CollapsedIf(local:SessionsLayout.Current.IsPhone)}">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                <TextBlock Text="{x:Bind CommandText}" Style="{StaticResource CorvidMonoText}" TextWrapping="NoWrap" IsTextSelectionEnabled="True" />
              </ScrollViewer>
            </Border>
            <TextBlock Text="{x:Bind Unparsed}" Style="{StaticResource CorvidSmallText}" Visibility="{x:Bind ui:Ui.VisibleIfText(Unparsed)}" />
            <ItemsControl ItemsSource="{x:Bind Commands}" IsTabStop="False"
                          Visibility="{x:Bind local:SessionsPage.WhenAny(local:SessionsLayout.Current.IsPhone, false, Commands)}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <controls:ColumnsPanel Columns="{x:Bind local:SessionsPage.ParsedColumns(local:SessionsLayout.Current.IsNarrow), Mode=OneWay}"
                                         MinColumnWidth="260" Spacing="10" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sessions:ParsedCommandView">
                  <Border BorderBrush="{ThemeResource CorvidLine}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                    <StackPanel Spacing="6">
                      <controls:WrapRowPanel Spacing="8" LineSpacing="4">
                        <TextBlock Text="{x:Bind Text}" Style="{StaticResource MonoSmall}" FontWeight="Medium" TextWrapping="Wrap" />
                        <controls:TagChip Text="{x:Bind EffectsText}" Tone="{x:Bind EffectsTone}" Visibility="{x:Bind ui:Ui.VisibleIf(HasEffects)}" />
                      </controls:WrapRowPanel>
                      <controls:WrapRowPanel Spacing="8" LineSpacing="2">
                        <TextBlock Text="verb" Style="{StaticResource KeyLabel}" />
                        <TextBlock Text="{x:Bind Verb}" Style="{StaticResource MonoSmall}" />
                        <TextBlock Text="subcommand" FontSize="12.5" Foreground="{ThemeResource CorvidText2}" VerticalAlignment="Center"
                                   Visibility="{x:Bind ui:Ui.VisibleIf(HasSubcommand)}" />
                        <TextBlock Text="{x:Bind Subcommand}" Style="{StaticResource MonoSmall}" Visibility="{x:Bind ui:Ui.VisibleIf(HasSubcommand)}" />
                        <TextBlock Text="flags" FontSize="12.5" Foreground="{ThemeResource CorvidText2}" VerticalAlignment="Center"
                                   Visibility="{x:Bind ui:Ui.VisibleIf(HasFlags)}" />
                        <TextBlock Text="{x:Bind Flags}" Style="{StaticResource MonoSmall}" Visibility="{x:Bind ui:Ui.VisibleIf(HasFlags)}" />
                      </controls:WrapRowPanel>
                      <Grid ColumnSpacing="8" Visibility="{x:Bind ui:Ui.VisibleIfAny(Targets)}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="targets" Style="{StaticResource KeyLabel}" VerticalAlignment="Top" Margin="0,1,0,0" />
                        <ItemsControl Grid.Column="1" ItemsSource="{x:Bind Targets}" IsTabStop="False">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <controls:WrapRowPanel Spacing="8" LineSpacing="6" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sessions:TargetChip">
                              <Grid AutomationProperties.Name="{x:Bind Text}">
                                <Border Height="20" CornerRadius="5" Background="{ThemeResource CorvidBg3}" Visibility="{x:Bind ui:Ui.CollapsedIf(IsDestructive)}" />
                                <Border Height="20" CornerRadius="5" Background="{ThemeResource CorvidRedBg}" Visibility="{x:Bind ui:Ui.VisibleIf(IsDestructive)}" />
                                <Grid ColumnSpacing="4" Padding="7,0" VerticalAlignment="Center" Visibility="{x:Bind ui:Ui.CollapsedIf(IsDestructive)}">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                  </Grid.ColumnDefinitions>
                                  <TextBlock Text="{x:Bind Prefix}" FontSize="12" Visibility="{x:Bind ui:Ui.VisibleIf(HasPrefix)}" Foreground="{ThemeResource CorvidText}" />
                                  <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontFamily="{StaticResource CorvidMono}" FontSize="12.5"
                                             TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Foreground="{ThemeResource CorvidText}" />
                                  <TextBlock Grid.Column="2" Text="{x:Bind local:SessionsPage.Dotted(Detail)}" FontSize="12" Visibility="{x:Bind ui:Ui.VisibleIf(HasDetail)}"
                                             Foreground="{ThemeResource CorvidText}" />
                                </Grid>
                                <Grid ColumnSpacing="4" Padding="7,0" VerticalAlignment="Center" Visibility="{x:Bind ui:Ui.VisibleIf(IsDestructive)}">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                  </Grid.ColumnDefinitions>
                                  <TextBlock Text="{x:Bind Prefix}" FontSize="12" Visibility="{x:Bind ui:Ui.VisibleIf(HasPrefix)}" Foreground="{ThemeResource CorvidRed}" />
                                  <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontFamily="{StaticResource CorvidMono}" FontSize="12.5"
                                             TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Foreground="{ThemeResource CorvidRed}" />
                                  <TextBlock Grid.Column="2" Text="{x:Bind local:SessionsPage.Dotted(Detail)}" FontSize="12" Visibility="{x:Bind ui:Ui.VisibleIf(HasDetail)}"
                                             Foreground="{ThemeResource CorvidRed}" />
                                </Grid>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Grid>
                      <ItemsControl ItemsSource="{x:Bind Notes}" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="sessions:CommandNoteView">
                            <StackPanel Spacing="2" Margin="0,0,0,4">
                              <TextBlock Text="{x:Bind Label}" Style="{StaticResource KeyLabel}" />
                              <TextBlock controls:RichText.Runs="{x:Bind Runs}" FontSize="12.5" TextWrapping="Wrap" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- The phone's compact parsed rows (Phone.png): the command and its effects, then each target; no verb or flags. -->
            <ItemsControl ItemsSource="{x:Bind Commands}" IsTabStop="False"
                          Visibility="{x:Bind local:SessionsPage.WhenAny(local:SessionsLayout.Current.IsPhone, true, Commands)}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sessions:ParsedCommandView">
                  <StackPanel Spacing="6" Margin="0,0,0,6">
                    <controls:WrapRowPanel Spacing="6" LineSpacing="4">
                      <TextBlock Text="{x:Bind Text}" Style="{StaticResource MonoSmall}" FontWeight="Medium" TextWrapping="Wrap" />
                      <controls:TagChip Text="{x:Bind EffectsText}" Tone="{x:Bind EffectsTone}" Visibility="{x:Bind ui:Ui.VisibleIf(HasEffects)}" />
                    </controls:WrapRowPanel>
                    <ItemsControl ItemsSource="{x:Bind Targets}" IsTabStop="False">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sessions:TargetChip">
                          <Grid ColumnSpacing="8" Margin="0,0,0,4" AutomationProperties.Name="{x:Bind local:SessionsPage.Prefixed('target ', Text)}">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="target" Style="{StaticResource KeyLabel}" />
                            <Grid Grid.Column="1" HorizontalAlignment="Left">
                              <Border CornerRadius="5" Background="{ThemeResource CorvidBg3}" Visibility="{x:Bind ui:Ui.CollapsedIf(IsDestructive)}" />
                              <Border CornerRadius="5" Background="{ThemeResource CorvidRedBg}" Visibility="{x:Bind ui:Ui.VisibleIf(IsDestructive)}" />
                              <TextBlock Padding="7,2" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{ThemeResource CorvidText}"
                                         Visibility="{x:Bind ui:Ui.CollapsedIf(IsDestructive)}"><Run Text="{x:Bind local:SessionsPage.Suffixed(Prefix, ' ')}" /><Run
                                         Text="{x:Bind Value}" FontFamily="{StaticResource CorvidMono}" FontSize="12.5" /><Run
                                         Text="{x:Bind local:SessionsPage.Prefixed(' · ', Detail)}" /></TextBlock>
                              <TextBlock Padding="7,2" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{ThemeResource CorvidRed}"
                                         Visibility="{x:Bind ui:Ui.VisibleIf(IsDestructive)}"><Run Text="{x:Bind local:SessionsPage.Suffixed(Prefix, ' ')}" /><Run
                                         Text="{x:Bind Value}" FontFamily="{StaticResource CorvidMono}" FontSize="12.5" /><Run
                                         Text="{x:Bind local:SessionsPage.Prefixed(' · ', Detail)}" /></TextBlock>
                            </Grid>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border BorderBrush="{ThemeResource CorvidLine}" BorderThickness="1" CornerRadius="8" Visibility="{x:Bind ui:Ui.VisibleIf(HasProposedDiff)}">
              <StackPanel>
                <Grid Padding="12,8" Background="{ThemeResource CorvidBg2}" ColumnSpacing="10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Bind ProposedDiff.Path}" Style="{StaticResource MonoSmall}" TextTrimming="CharacterEllipsis" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{x:Bind ProposedDiff.AddedText}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource CorvidGreen}" />
                    <TextBlock Text="{x:Bind ProposedDiff.RemovedText}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource CorvidRed}" />
                  </StackPanel>
                </Grid>
                <controls:DiffRowsView Rows="{x:Bind ProposedDiff.Rows}" />
              </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{x:Bind Detections}" IsTabStop="False" Visibility="{x:Bind ui:Ui.VisibleIf(HasDetections)}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sessions:DetectionView">
                  <controls:ToneRow Tone="Red" Margin="0,0,0,6">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                      <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" />
                      <TextBlock Text="{x:Bind Reason}" TextWrapping="Wrap" />
                      <ItemsControl ItemsSource="{x:Bind Events}" IsTabStop="False" />
                    </StackPanel>
                  </controls:ToneRow>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{x:Bind McpText}" Style="{StaticResource CorvidSmallText}" Visibility="{x:Bind ui:Ui.VisibleIfText(McpText)}" />
            <ItemsControl ItemsSource="{x:Bind Reasons}" IsTabStop="False" AutomationProperties.Name="Why Corvid asks">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sessions:ReasonView">
                  <Grid ColumnSpacing="8" Padding="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Height="18" Padding="6,0" CornerRadius="4" Background="{ThemeResource CorvidBg3}" VerticalAlignment="Top" Margin="0,1,0,0">
                      <TextBlock Text="{x:Bind Label}" FontFamily="{StaticResource CorvidMono}" FontSize="11" Foreground="{ThemeResource CorvidText2}"
                                 VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" controls:RichText.Runs="{x:Bind local:SessionsPage.PickRuns(local:SessionsLayout.Current.IsPhone, ShortRuns, Runs)}"
                               Style="{StaticResource CorvidBodyText}" FontSize="{x:Bind local:SessionsPage.CardTextSize(local:SessionsLayout.Current.IsPhone)}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- The phone's answers (Phone.png): 44 high and full width with their longer labels, the two denials sharing a line. -->
            <ItemsControl ItemsSource="{x:Bind Options}" IsTabStop="False" AutomationProperties.Name="Answer"
                          Visibility="{x:Bind ui:Ui.VisibleIf(local:SessionsLayout.Current.IsPhone), Mode=OneWay}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <local:PhoneAnswersPanel Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sessions:ApprovalOptionView">
                  <Grid>
                    <Border Margin="-3" CornerRadius="10" BorderThickness="2" BorderBrush="{ThemeResource CorvidAccent}"
                            Visibility="{x:Bind local:SessionsPage.OutlineVisible(IsFocused, IsExpanded), Mode=OneWay}" />
                    <Button Style="{StaticResource PhoneOptionButton}" Command="{x:Bind Choose}" AutomationProperties.Name="{x:Bind AutomationName}">
                      <Grid>
                        <TextBlock Text="{x:Bind LongLabel}" FontWeight="Medium" Foreground="{ThemeResource CorvidText}" TextAlignment="Center"
                                   TextWrapping="Wrap" Visibility="{x:Bind ui:Ui.CollapsedIf(IsDeny)}" />
                        <TextBlock Text="{x:Bind LongLabel}" FontWeight="Medium" Foreground="{ThemeResource CorvidRed}" TextAlignment="Center"
                                   TextWrapping="Wrap" Visibility="{x:Bind ui:Ui.VisibleIf(IsDeny)}" />
                      </Grid>
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{x:Bind Options}" IsTabStop="False" AutomationProperties.Name="Answer"
                          Visibility="{x:Bind ui:Ui.CollapsedIf(local:SessionsLayout.Current.IsPhone), Mode=OneWay}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <controls:WrapRowPanel Spacing="8" LineSpacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sessions:ApprovalOptionView">
                  <Grid>
                    <Border Margin="-3" CornerRadius="10" BorderThickness="2" BorderBrush="{ThemeResource CorvidAccent}"
                            Visibility="{x:Bind local:SessionsPage.OutlineVisible(IsFocused, IsExpanded), Mode=OneWay}" />
                    <Button Style="{StaticResource OptionButton}" Command="{x:Bind Choose}" AutomationProperties.Name="{x:Bind AutomationName}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Style="{StaticResource CorvidKeyCap}">
                          <TextBlock Text="{x:Bind Key}" Style="{StaticResource CorvidKeyCapText}" Foreground="{ThemeResource CorvidText}" />
                        </Border>
                        <TextBlock Text="{x:Bind Label}" FontWeight="Medium" VerticalAlignment="Center" Foreground="{ThemeResource CorvidText}"
                                   Visibility="{x:Bind ui:Ui.CollapsedIf(IsDeny)}" />
                        <TextBlock Text="{x:Bind Label}" FontWeight="Medium" VerticalAlignment="Center" Foreground="{ThemeResource CorvidRed}"
                                   Visibility="{x:Bind ui:Ui.VisibleIf(IsDeny)}" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid Visibility="{x:Bind ui:Ui.VisibleIf(IsRulePreviewOpen), Mode=OneWay}" AutomationProperties.Name="Rule preview">
              <Border CornerRadius="8" Background="{ThemeResource CorvidAccentBg}" />
              <Rectangle RadiusX="8" RadiusY="8" Stroke="{ThemeResource CorvidAccent}" StrokeThickness="1" StrokeDashArray="3,2" />
              <StackPanel Padding="12,10" Spacing="8">
                <controls:WrapRowPanel Spacing="8" LineSpacing="2" PushLastRight="True">
                  <TextBlock Text="{x:Bind RulePreview.Header}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <TextBlock Text="{x:Bind RulePreview.Source}" Style="{StaticResource CorvidSmallText}" VerticalAlignment="Center" />
                </controls:WrapRowPanel>
                <ItemsControl ItemsSource="{x:Bind RulePreview.Rows}" IsTabStop="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="sessions:RuleRowView">
                      <StackPanel Spacing="2" Margin="0,0,0,6">
                        <controls:WrapRowPanel Spacing="8" LineSpacing="4">
                          <controls:TagChip Text="{x:Bind Decision}" Tone="{x:Bind local:SessionsPage.DecisionTone(IsAllow)}" />
                          <TextBlock Text="{x:Bind Command}" Style="{StaticResource MonoSmall}" />
                          <TextBlock Text="{x:Bind PathsLabel}" FontSize="12.5" Foreground="{ThemeResource CorvidText2}" VerticalAlignment="Center"
                                     Visibility="{x:Bind ui:Ui.VisibleIf(HasPaths)}" />
                          <TextBox Text="{x:Bind Paths, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{x:Bind ui:Ui.VisibleIf(HasPaths)}"
                                   FontFamily="{StaticResource CorvidMono}" FontSize="12" MinWidth="200" MinHeight="26" Padding="8,3"
                                   AutomationProperties.Name="Paths the rule covers" />
                          <TextBlock Text="{x:Bind PathsHint}" Style="{StaticResource CorvidSmallText}" VerticalAlignment="Center"
                                     Visibility="{x:Bind ui:Ui.VisibleIf(HasPaths)}" />
                          <TextBlock Text="{x:Bind Scope}" FontSize="12.5" Foreground="{ThemeResource CorvidText2}" VerticalAlignment="Center"
                                     Visibility="{x:Bind ui:Ui.CollapsedIf(HasPaths)}" />
                        </controls:WrapRowPanel>
                        <TextBlock Text="{x:Bind PathsError, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource CorvidRed}" TextWrapping="Wrap"
                                   Visibility="{x:Bind ui:Ui.VisibleIf(HasPathsError), Mode=OneWay}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{x:Bind RulePreview.Note}" Style="{StaticResource CorvidSmallText}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <controls:CorvidButton Content="{x:Bind RulePreview.ConfirmLabel}" Variant="Primary" Style="{StaticResource CorvidSmallButton}"
                                         Command="{x:Bind ConfirmRuleCommand}" />
                  <controls:CorvidButton Content="{x:Bind RulePreview.BackLabel}" Variant="Ghost" Style="{StaticResource CorvidSmallButton}"
                                         Command="{x:Bind BackCommand}" />
                </StackPanel>
              </StackPanel>
            </Grid>
            <StackPanel Spacing="8" Visibility="{x:Bind ui:Ui.VisibleIf(IsAskingWhy), Mode=OneWay}">
              <TextBox Text="{x:Bind DenyReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Why not? Sent to Corvid as your next message"
                       AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" AutomationProperties.Name="Reason for the denial" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:CorvidButton Content="Deny and send" Foreground="{ThemeResource CorvidRed}" Style="{StaticResource CorvidSmallButton}"
                                       Command="{x:Bind SendDenyReasonCommand}" />
                <controls:CorvidButton Content="Back" Variant="Ghost" Style="{StaticResource CorvidSmallButton}" Command="{x:Bind BackCommand}" />
              </StackPanel>
            </StackPanel>
            <TextBlock controls:RichText.Runs="{x:Bind NextText, Mode=OneWay}" Style="{StaticResource CorvidSmallText}"
                       Visibility="{x:Bind local:SessionsPage.NextVisible(HasNext, local:SessionsLayout.Current.IsPhone, false), Mode=OneWay}" />
            <TextBlock Text="{x:Bind NextShort, Mode=OneWay}" Style="{StaticResource CorvidSmallText}"
                       Visibility="{x:Bind local:SessionsPage.NextVisible(HasNext, local:SessionsLayout.Current.IsPhone, true), Mode=OneWay}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- .answer: markdown at 1.6 line height, at most 72ch wide, with a caret while it streams. -->
    <DataTemplate x:Key="AnswerTemplate" x:DataType="sessions:AnswerBlock">
      <controls:MarkdownView Document="{x:Bind Document, Mode=OneWay}" IsStreaming="{x:Bind IsStreaming, Mode=OneWay}" MaxWidth="600"
                             HorizontalAlignment="Left" />
    </DataTemplate>

    <!-- .row.thought: "thought for 4 s" as a muted link; expanded, the thought in muted text. -->
    <DataTemplate x:Key="ThoughtTemplate" x:DataType="sessions:ThoughtBlock">
      <StackPanel Spacing="6" Padding="2,0">
        <Button Content="{x:Bind Label, Mode=OneWay}" Style="{StaticResource MutedLinkButton}" Command="{x:Bind ToggleCommand}"
                HorizontalAlignment="Left" AutomationProperties.Name="{x:Bind local:SessionsPage.ThoughtName(Label, IsExpanded), Mode=OneWay}" />
        <Border BorderBrush="{ThemeResource CorvidLine}" BorderThickness="2,0,0,0" Padding="10,0,0,0"
                Visibility="{x:Bind ui:Ui.VisibleIf(IsExpanded), Mode=OneWay}">
          <TextBlock controls:RichText.Runs="{x:Bind sessions:SessionText.Runs(Text), Mode=OneWay}" Style="{StaticResource CorvidSmallText}"
                     FontSize="12.5" IsTextSelectionEnabled="True" />
        </Border>
      </StackPanel>
    </DataTemplate>

    <!-- A note row: staged memory (grey, with "review"), a held MCP tool (red), a finished job (violet), a warning (amber). -->
    <DataTemplate x:Key="NoticeTemplate" x:DataType="sessions:NoticeBlock">
      <controls:ToneRow Tone="{x:Bind Tone}">
        <controls:WrapRowPanel Spacing="8" LineSpacing="2">
          <controls:Icon Kind="{x:Bind Icon}" VerticalAlignment="Center" />
          <TextBlock Text="{x:Bind Text}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
          <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" VerticalAlignment="Center" Visibility="{x:Bind ui:Ui.VisibleIf(HasDetail)}" />
          <controls:LinkButton Text="{x:Bind ActionLabel}" Command="{x:Bind ActionCommand}" Visibility="{x:Bind ui:Ui.VisibleIf(HasAction)}"
                               VerticalAlignment="Center" />
        </controls:WrapRowPanel>
      </controls:ToneRow>
    </DataTemplate>

    <!-- .row.detect: a detection rule's match in red, its events, and Open in Audit. -->
    <DataTemplate x:Key="DetectionTemplate" x:DataType="sessions:DetectionBlock">
      <controls:ToneRow Tone="Red">
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <controls:Icon Kind="{x:Bind Icon}" VerticalAlignment="Top" Margin="0,1,0,0" />
          <StackPanel Grid.Column="1" Spacing="3">
            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind Reason}" TextWrapping="Wrap" Visibility="{x:Bind ui:Ui.VisibleIfText(Reason)}" />
            <ItemsControl ItemsSource="{x:Bind Events}" IsTabStop="False" />
            <controls:LinkButton Text="Open in Audit" Command="{x:Bind OpenInAuditCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </Grid>
      </controls:ToneRow>
    </DataTemplate>

    <!-- A compaction marker: what was folded, and the compaction record on request. -->
    <DataTemplate x:Key="CompactionTemplate" x:DataType="sessions:CompactionBlock">
      <controls:ToneRow Tone="Grey">
        <StackPanel Spacing="6">
          <controls:WrapRowPanel Spacing="8">
            <controls:Icon Kind="Layers" VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Content="{x:Bind local:SessionsPage.RecordLabel(IsExpanded), Mode=OneWay}" Style="{StaticResource MutedLinkButton}"
                    Command="{x:Bind ToggleCommand}" VerticalAlignment="Center" />
          </controls:WrapRowPanel>
          <ItemsControl ItemsSource="{x:Bind Record}" IsTabStop="False" Visibility="{x:Bind ui:Ui.VisibleIf(IsExpanded), Mode=OneWay}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="sessions:LabelledText">
                <TextBlock TextWrapping="Wrap" Margin="24,0,0,4"><Run Text="{x:Bind Label}" FontWeight="SemiBold" /><Run Text="{x:Bind local:SessionsPage.Prefixed(': ', Text)}" /></TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </controls:ToneRow>
    </DataTemplate>

    <!-- A rewind marker: where the session went back to, and what each path became. -->
    <DataTemplate x:Key="RewindTemplate" x:DataType="sessions:RewindBlock">
      <controls:ToneRow Tone="{x:Bind local:SessionsPage.RewindTone(IsRefused)}">
        <StackPanel Spacing="4">
          <controls:WrapRowPanel Spacing="8">
            <controls:Icon Kind="{x:Bind Icon}" VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind Text}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" VerticalAlignment="Center" Visibility="{x:Bind ui:Ui.VisibleIfText(Detail)}" />
          </controls:WrapRowPanel>
          <ItemsControl ItemsSource="{x:Bind Paths}" IsTabStop="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="sessions:RestoredPath">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="24,0,0,0">
                  <TextBlock Text="{x:Bind Path}" Style="{StaticResource MonoSmall}" />
                  <TextBlock Text="{x:Bind Result}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </controls:ToneRow>
    </DataTemplate>

    <!-- A clarifying question: pinned until answered, with its options; the composer answers free text. -->
    <DataTemplate x:Key="QuestionTemplate" x:DataType="sessions:QuestionBlock">
      <Grid>
        <Border CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CorvidAccent}" Background="{ThemeResource CorvidAccentBg}"
                Visibility="{x:Bind ui:Ui.VisibleIf(IsOpen), Mode=OneWay}" />
        <Border CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CorvidLine}" Background="{ThemeResource CorvidBg2}"
                Visibility="{x:Bind ui:Ui.CollapsedIf(IsOpen), Mode=OneWay}" />
        <StackPanel Padding="14,10" Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <controls:Icon Kind="{x:Bind Icon}" Foreground="{ThemeResource CorvidAccent}" VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level3" />
          </StackPanel>
          <TextBlock Text="{x:Bind Text}" Style="{StaticResource CorvidBodyText}" />
          <ItemsControl ItemsSource="{x:Bind Options}" IsTabStop="False" Visibility="{x:Bind ui:Ui.VisibleIf(IsOpen), Mode=OneWay}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <controls:WrapRowPanel Spacing="8" LineSpacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="sessions:QuestionOption">
                <controls:CorvidButton Content="{x:Bind Label}" Command="{x:Bind Choose}" Style="{StaticResource CorvidSmallButton}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Or type an answer in the composer." Style="{StaticResource CorvidSmallText}"
                     Visibility="{x:Bind local:SessionsPage.Both(IsOpen, AllowsFreeText), Mode=OneWay}" />
          <TextBlock Text="{x:Bind local:SessionsPage.Prefixed('answered: ', AnswerText), Mode=OneWay}" Style="{StaticResource CorvidSmallText}"
                     Visibility="{x:Bind ui:Ui.VisibleIfText(AnswerText), Mode=OneWay}" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <!-- A slash command's output, as a card: the line typed, a title, lines or a table. -->
    <DataTemplate x:Key="CommandTemplate" x:DataType="sessions:CommandBlock">
      <Border Style="{StaticResource Card}" Padding="12,8">
        <StackPanel Spacing="6">
          <TextBlock Text="{x:Bind Line}" Style="{StaticResource MonoSmall}" Foreground="{ThemeResource CorvidText2}" />
          <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" Visibility="{x:Bind ui:Ui.VisibleIf(HasTitle)}" />
          <ItemsControl ItemsSource="{x:Bind Lines}" IsTabStop="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{x:Bind}" Style="{StaticResource CorvidMonoText}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{x:Bind local:SessionsPage.Table(Columns, Rows)}" Style="{StaticResource CorvidMonoText}" TextWrapping="NoWrap"
                     Visibility="{x:Bind ui:Ui.VisibleIf(HasTable)}" IsTextSelectionEnabled="True" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <local:TranscriptTemplateSelector x:Key="BlockTemplates"
                                      User="{StaticResource UserTemplate}"
                                      TurnHeader="{StaticResource TurnHeaderTemplate}"
                                      Decisions="{StaticResource DecisionsTemplate}"
                                      Switch="{StaticResource SwitchTemplate}"
                                      Tool="{StaticResource ToolTemplate}"
                                      Approval="{StaticResource ApprovalTemplate}"
                                      Taint="{StaticResource TaintTemplate}"
                                      Answer="{StaticResource AnswerTemplate}"
                                      Thought="{StaticResource ThoughtTemplate}"
                                      Notice="{StaticResource NoticeTemplate}"
                                      Detection="{StaticResource DetectionTemplate}"
                                      Compaction="{StaticResource CompactionTemplate}"
                                      Rewind="{StaticResource RewindTemplate}"
                                      Question="{StaticResource QuestionTemplate}"
                                      Command="{StaticResource CommandTemplate}" />
  </Page.Resources>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- .conv-head: 10px 20px, a line below; the title and fork pill on the left, the goal and actions on the right. -->
    <Border x:Name="Header" Padding="20,10" MinHeight="51" BorderBrush="{ThemeResource CorvidLine}" BorderThickness="0,0,0,1">
      <Grid x:Name="HeaderGrid" ColumnSpacing="12" SizeChanged="OnHeaderSizeChanged">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="TitleRow" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" Text="{x:Bind ViewModel.Session.Title, Mode=OneWay, FallbackValue=''}" Style="{StaticResource CorvidSessionTitle}"
                     VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1" />
          <Border x:Name="ForkPill" Style="{StaticResource Pill}" SizeChanged="OnHeaderSizeChanged" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.Session.HasFork), Mode=OneWay, FallbackValue=Collapsed}">
            <TextBlock Text="{x:Bind ViewModel.Session.ForkText, Mode=OneWay, FallbackValue=''}" FontSize="12" Foreground="{ThemeResource CorvidText2}"
                       VerticalAlignment="Center" TextWrapping="NoWrap" />
          </Border>
        </StackPanel>
        <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" SizeChanged="OnHeaderSizeChanged">
          <Border x:Name="GoalPill" Style="{StaticResource Pill}" Background="{ThemeResource CorvidAccentBg}"
                  Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.Session.HasGoal), Mode=OneWay, FallbackValue=Collapsed}"
                  ToolTipService.ToolTip="The standing goal the decider checks each turn against">
            <TextBlock Text="{x:Bind ViewModel.Session.GoalText, Mode=OneWay, FallbackValue=''}" FontSize="12" Foreground="{ThemeResource CorvidAccent}"
                       VerticalAlignment="Center" TextWrapping="NoWrap" />
          </Border>
          <controls:CorvidButton x:Name="AsideButton" Content="Aside" Variant="Ghost" Click="OnAside"
                                 ToolTipService.ToolTip="A side question in a scratch fork (Ctrl+;); it comes with flow F7, and this says so" />
          <controls:CorvidButton x:Name="RewindButton" Content="Rewind" Variant="Ghost" Foreground="{ThemeResource CorvidAccent}"
                                 Command="{x:Bind ViewModel.OpenRewindCommand}" ToolTipService.ToolTip="The session's checkpoint timeline (Esc Esc)" />
          <controls:CorvidButton x:Name="CompactButton" Content="Compact…" Variant="Ghost"
                                 ToolTipService.ToolTip="Summarise older context now, with an optional focus">
            <controls:CorvidButton.Flyout>
              <Flyout x:Name="CompactFlyout" Placement="BottomEdgeAlignedRight">
                <StackPanel Spacing="8" Width="300">
                  <TextBlock Text="Compact the context" FontWeight="SemiBold" />
                  <TextBlock Text="Older turns are summarised; the transcript keeps them. A focus says what to keep in detail." Style="{StaticResource CorvidSmallText}" />
                  <TextBox x:Name="CompactFocus" PlaceholderText="Focus (optional)" AutomationProperties.Name="Compaction focus" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:CorvidButton Content="Compact" Variant="Primary" Style="{StaticResource CorvidSmallButton}" Click="OnCompact" />
                    <TextBlock Text="Between turns only." Style="{StaticResource CorvidSmallText}" VerticalAlignment="Center"
                               Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.Session.IsRunning), Mode=OneWay, FallbackValue=Collapsed}" />
                  </StackPanel>
                </StackPanel>
              </Flyout>
            </controls:CorvidButton.Flyout>
          </controls:CorvidButton>
          <controls:IconButton x:Name="PopOutButton" Icon="PopOut" IsEnabled="False" AutomationProperties.Name="Pop out into its own window"
                               ToolTipService.ToolTip="Pop out into its own window (comes with multiple windows)" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- The transcript: a virtualised list, at most 960 wide, 16px 24px 8px; blocks 10 apart, turns 14. -->
    <Grid Grid.Row="1">
      <ScrollViewer x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled" ViewChanged="OnTranscriptViewChanged" AutomationProperties.Name="Transcript">
        <!-- At most 960 wide and on the left, as .transcript's max-width in its flex column. -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="960" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
        <StackPanel x:Name="TranscriptBody" Padding="24,16,24,8">
          <controls:ToneRow Tone="Grey" Margin="0,0,0,10" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.Session.IsReadOnly), Mode=OneWay, FallbackValue=Collapsed}">
            <TextBlock Text="{x:Bind ViewModel.Session.ReadOnlyNote, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" />
          </controls:ToneRow>
          <ItemsRepeater x:Name="Transcript" ItemsSource="{x:Bind ViewModel.Session.Blocks, Mode=OneWay}"
                         AutomationProperties.Name="Messages and tool calls" AutomationProperties.AccessibilityView="Content"
                         TabFocusNavigation="Local"
                         ItemTemplate="{StaticResource BlockTemplates}" SizeChanged="OnTranscriptSizeChanged">
            <ItemsRepeater.Layout>
              <StackLayout Spacing="10" />
            </ItemsRepeater.Layout>
          </ItemsRepeater>
          <TextBlock Text="No session is open. Pick one in the rail." Style="{StaticResource CorvidMutedText}"
                     Visibility="{x:Bind ui:Ui.CollapsedIf(ViewModel.HasSession), Mode=OneWay}" />
        </StackPanel>
        </Grid>
      </ScrollViewer>
      <!-- Live regions (docs/plan/ui.md §4.15), drawn nowhere: the turn strip's step without its ticking time, politely; an
           approval, a question or a finished turn, assertively. They are set from code (OnSessionChanged, Announce). -->
      <TextBlock x:Name="StepAnnouncer" Width="1" Height="1" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left"
                 VerticalAlignment="Top" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Turn progress" />
      <TextBlock x:Name="Announcer" Width="1" Height="1" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left"
                 VerticalAlignment="Top" AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="Session announcements" />
      <!-- "jump to bottom · N new", while scrolled up; streaming never moves the scroll position. -->
      <Button x:Name="JumpButton" Visibility="Collapsed" Click="OnJumpToBottom" HorizontalAlignment="Center" VerticalAlignment="Bottom"
              Margin="0,0,0,12" Padding="0" BorderThickness="0" Background="Transparent">
        <Border Height="28" Padding="12,0" CornerRadius="14" Background="{ThemeResource CorvidText}">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <controls:Icon Kind="ChevronDown" Foreground="{ThemeResource CorvidBg}" VerticalAlignment="Center" />
            <TextBlock x:Name="JumpText" Text="Jump to bottom" FontSize="12.5" FontWeight="Medium" Foreground="{ThemeResource CorvidBg}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </Button>
      <controls:ToneRow Tone="Red" Margin="24,0,24,8" VerticalAlignment="Bottom" AutomationProperties.LiveSetting="Assertive"
                        Visibility="{x:Bind ui:Ui.VisibleIfText(ViewModel.Session.Error), Mode=OneWay, FallbackValue=Collapsed}">
        <TextBlock Text="{x:Bind ViewModel.Session.Error, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" />
      </controls:ToneRow>
    </Grid>

    <!-- .turnstrip: 6px 24px, a line above, bg-2, 12.5 px: the spinner (or the amber clock while waiting), the step, the queue, the hint. -->
    <Border x:Name="TurnStrip" Grid.Row="2" Padding="24,6" Background="{ThemeResource CorvidBg2}" BorderBrush="{ThemeResource CorvidLine}"
            BorderThickness="0,1,0,0" MinHeight="37" Visibility="Collapsed">
      <controls:WrapRowPanel Spacing="10" LineSpacing="8" VerticalAlignment="Center" PushLastRight="True">
        <Grid Width="10" Height="10" VerticalAlignment="Center" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.Session.IsWorking), Mode=OneWay, FallbackValue=Collapsed}">
          <Ellipse Stroke="{ThemeResource CorvidLine}" StrokeThickness="2" />
          <Path x:Name="SpinnerArc" Stroke="{ThemeResource CorvidAccent}" StrokeThickness="2" Data="M 1,5 A 4,4 0 0 1 9,5"
                RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform>
              <RotateTransform x:Name="SpinnerRotation" />
            </Path.RenderTransform>
          </Path>
        </Grid>
        <controls:Icon Kind="Clock" Foreground="{ThemeResource CorvidAmber}" VerticalAlignment="Center"
                       Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.Session.IsWaiting), Mode=OneWay, FallbackValue=Collapsed}" />
        <TextBlock Text="{x:Bind ViewModel.Session.TurnStripText, Mode=OneWay, FallbackValue=''}" FontSize="12.5" VerticalAlignment="Center"
                   Visibility="{x:Bind ui:Ui.VisibleIfText(ViewModel.Session.TurnStripText), Mode=OneWay, FallbackValue=Collapsed}" />
        <ItemsControl ItemsSource="{x:Bind ViewModel.Session.Queue, Mode=OneWay}" IsTabStop="False" VerticalAlignment="Center"
                      AutomationProperties.Name="Queued messages">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <controls:WrapRowPanel Spacing="6" LineSpacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="sessions:QueuedChip">
              <!-- .queued: 24 high, 0 4px 0 8px, radius 12, a line border on bg; "queued" muted, the text, ×. -->
              <Border Height="24" Padding="8,0,4,0" CornerRadius="12" BorderBrush="{ThemeResource CorvidLine}" BorderThickness="1"
                      Background="{ThemeResource CorvidBg}" AutomationProperties.Name="{x:Bind AutomationName}">
                <Border.ContextFlyout>
                  <MenuFlyout>
                    <MenuFlyoutItem Text="Take back into the composer" Command="{x:Bind TakeBackCommand}" />
                    <MenuFlyoutItem Text="Move earlier" Command="{x:Bind MoveUpCommand}" />
                    <MenuFlyoutItem Text="Move later" Command="{x:Bind MoveDownCommand}" />
                  </MenuFlyout>
                </Border.ContextFlyout>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="{x:Bind Label}" FontSize="12.5" Foreground="{ThemeResource CorvidText2}" VerticalAlignment="Center" />
                  <TextBlock Text="{x:Bind Text}" FontSize="12.5" VerticalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis" />
                  <Button Command="{x:Bind RemoveCommand}" Width="20" Height="20" Padding="0" CornerRadius="10" Background="Transparent" BorderThickness="0"
                          AutomationProperties.Name="{x:Bind RemoveName}" ToolTipService.ToolTip="{x:Bind RemoveName}">
                    <TextBlock Text="×" FontSize="13" Foreground="{ThemeResource CorvidText2}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Button>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border x:Name="HintHost" VerticalAlignment="Center">
          <controls:HintLine x:Name="Hint" Parts="{x:Bind ViewModel.Session.Hint, Mode=OneWay, FallbackValue={x:Null}}" VerticalAlignment="Center"
                             Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.Session.HasHint), Mode=OneWay, FallbackValue=Collapsed}" />
        </Border>
      </controls:WrapRowPanel>
    </Border>

    <!-- .composer: 10px 24px 12px, a line above; the text area (min 60, radius 8), then the bar. On the phone (Phone.png) one
         line, 44 high, with a 44 px send button beside it and no bar. -->
    <Border x:Name="ComposerArea" Grid.Row="3" Padding="24,10,24,12" BorderBrush="{ThemeResource CorvidLine}" BorderThickness="0,1,0,0">
      <StackPanel Spacing="8">
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="Composer" Text="{x:Bind ViewModel.Session.Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}"
                   PlaceholderForeground="{ThemeResource CorvidText2}"
                   AcceptsReturn="True" TextWrapping="Wrap"
                   MinHeight="60" MaxHeight="220" Padding="12,10" CornerRadius="8" BorderThickness="1"
                   BorderBrush="{ThemeResource CorvidLine}" Background="{ThemeResource CorvidBg}" Foreground="{ThemeResource CorvidText}"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" IsSpellCheckEnabled="False"
                   IsEnabled="{x:Bind local:SessionsPage.Not(ViewModel.Session.IsReadOnly), Mode=OneWay, FallbackValue=False}"
                   AutomationProperties.Name="Message to Corvid" />
          <controls:CorvidButton x:Name="PhoneSendButton" Grid.Column="1" Variant="Primary" Visibility="Collapsed" VerticalAlignment="Bottom"
                                 Width="44" Height="44" Padding="0" HorizontalContentAlignment="Center"
                                 Command="{x:Bind ViewModel.Session.SubmitCommand, Mode=OneWay, FallbackValue={x:Null}}"
                                 AutomationProperties.Name="Send" ToolTipService.ToolTip="Send; queued while a turn runs">
            <controls:Icon Kind="Send" Foreground="{ThemeResource CorvidOnAccent}" />
          </controls:CorvidButton>
        </Grid>
        <Grid x:Name="ComposerBar" ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <controls:IconButton Icon="Paperclip" IsEnabled="False" AutomationProperties.Name="Attach a file"
                               ToolTipService.ToolTip="Attach a file (@ in the composer names one)" />
          <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Session.DraftNote, Mode=OneWay, FallbackValue=''}" Style="{StaticResource CorvidSmallText}"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
          <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.Session.TokenEstimate, Mode=OneWay, FallbackValue=''}" Style="{StaticResource CorvidSmallText}"
                     VerticalAlignment="Center" TextWrapping="NoWrap" />
          <controls:CorvidButton x:Name="SendButton" Grid.Column="3" Variant="Primary" Command="{x:Bind ViewModel.Session.SubmitCommand, Mode=OneWay, FallbackValue={x:Null}}"
                                 Padding="12,0,8,0" AutomationProperties.Name="Send" ToolTipService.ToolTip="Send (Enter); queued while a turn runs">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Send" VerticalAlignment="Center" />
              <Border Height="18" Padding="5,0" CornerRadius="4" Background="{ThemeResource CorvidBg}" Opacity="0.9" VerticalAlignment="Center">
                <TextBlock Text="↵" FontSize="11" Foreground="{ThemeResource CorvidAccent}" VerticalAlignment="Center" />
              </Border>
            </StackPanel>
          </controls:CorvidButton>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Page>

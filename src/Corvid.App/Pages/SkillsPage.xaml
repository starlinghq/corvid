<Page x:Class="Corvid.App.Pages.SkillsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Corvid.App.Controls"
      xmlns:skills="using:Corvid.App.Core.Skills"
      xmlns:mvvm="using:Corvid.App.Core.Mvvm"
      xmlns:local="using:Corvid.App.Pages"
      xmlns:ui="using:Corvid.App.Infrastructure"
      Background="{ThemeResource CorvidBg}"
      Foreground="{ThemeResource CorvidText}"
      FontSize="13.5">
  <!--
    Skills (ui.md §4.9 and flow F12; no mockup, so drawn in Memory.png's language): the page head with its tabs and the
    filter, then on the Review tab the drafts beside the most used skills, the idle ones and the import, in 1.4fr and 1fr
    columns 18 apart. Library and History are a table beside the open row's panel; Import is one column. No dock.
  -->
  <Page.Resources>
    <Style x:Key="SkPanelHead" TargetType="Border">
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="BorderBrush" Value="{ThemeResource CorvidLine}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style x:Key="SkHeadTitle" TargetType="TextBlock" BasedOn="{StaticResource CorvidBodyText}">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="SkHeadDetail" TargetType="TextBlock" BasedOn="{StaticResource CorvidSmallText}">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="SkSectTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="Foreground" Value="{ThemeResource CorvidText}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="SkSectDetail" TargetType="TextBlock" BasedOn="{StaticResource SkSectTitle}">
      <Setter Property="Foreground" Value="{ThemeResource CorvidText2}" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style x:Key="SkKey" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{ThemeResource CorvidText2}" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="SkCell" TargetType="TextBlock" BasedOn="{StaticResource CorvidBodyText}">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="LineHeight" Value="18.1" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style x:Key="SkMutedCell" TargetType="TextBlock" BasedOn="{StaticResource SkCell}">
      <Setter Property="Foreground" Value="{ThemeResource CorvidText2}" />
    </Style>
    <Style x:Key="SkMonoCell" TargetType="TextBlock" BasedOn="{StaticResource SkCell}">
      <Setter Property="FontFamily" Value="{StaticResource CorvidMono}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="SkTh" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{ThemeResource CorvidText2}" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="SkTextBox" TargetType="TextBox">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="BorderBrush" Value="{ThemeResource CorvidLine}" />
    </Style>
    <!-- A table row as one button: a film on hover, the accent ring on keyboard focus. -->
    <Style x:Key="SkRowButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="UseSystemFocusVisuals" Value="True" />
      <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource CorvidAccent}" />
      <Setter Property="FocusVisualMargin" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Border x:Name="Film" Background="{ThemeResource CorvidText}" Opacity="0.03" Visibility="Collapsed" />
              <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" />
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                      <Setter Target="Film.Visibility" Value="Visible" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                      <Setter Target="Film.Visibility" Value="Visible" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Disabled" />
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A replay or eval step: number, expected, called, verdict. -->
    <DataTemplate x:Key="StepRow" x:DataType="skills:ReplayStepView">
      <local:SkillsTableRow Columns="28,*,*,82" BorderBrush="{ThemeResource CorvidLine}" BorderThickness="0,1,0,0"
                            AutomationProperties.Name="{x:Bind AutomationName}">
        <TextBlock Text="{x:Bind NumberText}" Style="{StaticResource SkMutedCell}" Padding="10,5" />
        <TextBlock Grid.Column="1" Text="{x:Bind Expected}" Style="{StaticResource SkMonoCell}" Padding="10,5" />
        <TextBlock Grid.Column="2" Text="{x:Bind Actual}" Style="{StaticResource SkMonoCell}" Padding="10,5" />
        <Border Grid.Column="3" Padding="10,4">
          <controls:TagChip Text="{x:Bind Verdict}" Tone="{x:Bind Tone}" HorizontalAlignment="Left" />
        </Border>
      </local:SkillsTableRow>
    </DataTemplate>

    <!-- A drafted skill waiting for review (flow F12). -->
    <DataTemplate x:Key="DraftCard" x:DataType="skills:SkillDraftView">
      <Border Style="{StaticResource CorvidPanel}" AutomationProperties.Name="{x:Bind Title}">
        <StackPanel>
          <Border Style="{StaticResource SkPanelHead}">
            <local:MemoryHeadPanel>
              <TextBlock Text="{x:Bind Title}" Style="{StaticResource SkHeadTitle}" AutomationProperties.HeadingLevel="Level2" />
              <TextBlock Text="{x:Bind Why}" Style="{StaticResource SkHeadDetail}" />
            </local:MemoryHeadPanel>
          </Border>
          <StackPanel Padding="14,12" Spacing="10">
            <controls:ToneRow Tone="Red" Padding="10,6" Visibility="{x:Bind ui:Ui.VisibleIf(HasHiddenText)}">
              <TextBlock Text="{x:Bind HiddenWarning}" FontSize="12.5" TextWrapping="Wrap" />
            </controls:ToneRow>
            <controls:WrapRowPanel Spacing="8" LineSpacing="6" PushLastRight="True">
              <controls:TagChip Text="new skill" Tone="Violet" Visibility="{x:Bind ui:Ui.VisibleIf(IsNew)}" />
              <controls:TagChip Text="update" Tone="Violet" Visibility="{x:Bind ui:Ui.VisibleIf(IsUpdate)}" />
              <TextBlock Text="{x:Bind Origin}" FontSize="12.5" Foreground="{ThemeResource CorvidText2}" VerticalAlignment="Center" TextWrapping="NoWrap" />
              <TextBlock Text="{x:Bind Kind}" FontSize="12.5" Foreground="{ThemeResource CorvidText2}" VerticalAlignment="Center" TextWrapping="Wrap" />
              <controls:LinkButton Text="{x:Bind Evidence}" FontSize="12" Command="{x:Bind OpenEvidenceCommand}" VerticalAlignment="Center"
                                   ToolTipService.ToolTip="Open the session the draft came from" />
            </controls:WrapRowPanel>
            <TextBlock Text="{x:Bind Description}" Style="{StaticResource CorvidBodyText}" />

            <!-- SKILL.md as it would be written: revealed, in mono; the editor in its place while editing. -->
            <Grid>
              <TextBlock Text="SKILL.md" Style="{StaticResource SkSectTitle}" AutomationProperties.HeadingLevel="Level3" />
              <TextBlock Text="as approving writes it" Style="{StaticResource SkSectDetail}" />
            </Grid>
            <Border Background="{ThemeResource CorvidCodeBg}" CornerRadius="6" Padding="10,8" MaxHeight="300"
                    Visibility="{x:Bind ui:Ui.VisibleIf(IsReading), Mode=OneWay}">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsTabStop="False">
                <TextBlock Text="{x:Bind Source}" Style="{StaticResource CorvidMonoText}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                           AutomationProperties.Name="The drafted SKILL.md" />
              </ScrollViewer>
            </Border>
            <StackPanel Spacing="4" Visibility="{x:Bind ui:Ui.VisibleIf(IsEditing), Mode=OneWay}">
              <TextBlock Text="Edit the SKILL.md; Approve as edited writes it as yours. Ctrl+Enter approves, Esc undoes." Style="{StaticResource CorvidSmallText}" />
              <TextBox Text="{x:Bind EditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SkTextBox}"
                       FontFamily="{StaticResource CorvidMono}" FontSize="12" AcceptsReturn="True" MinHeight="160" MaxHeight="360"
                       ScrollViewer.VerticalScrollBarVisibility="Auto" PreviewKeyDown="OnDraftEditorKeyDown" Loaded="OnEditorLoaded" Unloaded="OnEditorUnloaded"
                       AutomationProperties.Name="The SKILL.md, edited" />
              <TextBlock Text="{x:Bind EditProblem, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource CorvidRed}" TextWrapping="Wrap"
                         Visibility="{x:Bind ui:Ui.VisibleIf(HasEditProblem), Mode=OneWay}" />
            </StackPanel>
            <StackPanel Spacing="6" Visibility="{x:Bind ui:Ui.VisibleIf(IsUpdate)}">
              <TextBlock Text="The change to the skill it updates" Style="{StaticResource SkSectTitle}" />
              <Border BorderBrush="{ThemeResource CorvidLine}" BorderThickness="1" CornerRadius="8" Background="{ThemeResource CorvidBg}">
                <controls:DiffRowsView Rows="{x:Bind DiffRows}" />
              </Border>
            </StackPanel>

            <!-- The replay: the source turn again with the draft loaded, step by step. -->
            <controls:WrapRowPanel Spacing="8" LineSpacing="4">
              <TextBlock Text="Replay" Style="{StaticResource SkSectTitle}" AutomationProperties.HeadingLevel="Level3" />
              <controls:TagChip Text="{x:Bind ReplayVerdict}" Tone="{x:Bind ReplayTone}" />
              <TextBlock Text="{x:Bind ReplayDetail}" FontSize="12" Foreground="{ThemeResource CorvidText2}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </controls:WrapRowPanel>
            <Border BorderBrush="{ThemeResource CorvidLine}" BorderThickness="1" CornerRadius="8">
              <StackPanel>
                <local:SkillsTableRow Columns="28,*,*,82">
                  <TextBlock Text="#" Style="{StaticResource SkTh}" />
                  <TextBlock Grid.Column="1" Text="expected" Style="{StaticResource SkTh}" />
                  <TextBlock Grid.Column="2" Text="called" Style="{StaticResource SkTh}" />
                  <TextBlock Grid.Column="3" Text="" Style="{StaticResource SkTh}" />
                </local:SkillsTableRow>
                <ItemsControl ItemsSource="{x:Bind Steps}" ItemTemplate="{StaticResource StepRow}" IsTabStop="False" AutomationProperties.Name="Replay steps" />
              </StackPanel>
            </Border>

            <controls:WrapRowPanel Spacing="8" LineSpacing="8" Visibility="{x:Bind ui:Ui.VisibleIf(ShowsActions), Mode=OneWay}">
              <controls:CorvidButton Content="{x:Bind ApproveLabel, Mode=OneWay}" Variant="Primary" Style="{StaticResource CorvidSmallButton}" Command="{x:Bind ApproveCommand}"
                                     ToolTipService.ToolTip="Write the skill; its evals run next" />
              <controls:CorvidButton Content="Edit…" Style="{StaticResource CorvidSmallButton}" Command="{x:Bind EditCommand}"
                                     Visibility="{x:Bind ui:Ui.VisibleIf(IsReading), Mode=OneWay}" />
              <controls:CorvidButton Content="Undo the edit" Style="{StaticResource CorvidSmallButton}" Command="{x:Bind CancelEditCommand}"
                                     Visibility="{x:Bind ui:Ui.VisibleIf(IsEditing), Mode=OneWay}" />
              <controls:CorvidButton Content="Reject with a reason…" Variant="Ghost" Foreground="{ThemeResource CorvidRed}" Style="{StaticResource CorvidSmallButton}"
                                     Command="{x:Bind StartRejectingCommand}" />
            </controls:WrapRowPanel>
            <StackPanel Spacing="6" Visibility="{x:Bind ui:Ui.VisibleIf(IsRejecting), Mode=OneWay}">
              <TextBox Text="{x:Bind Reason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SkTextBox}"
                       PlaceholderText="Why not? Kept with the draft, so the loop learns from it" AcceptsReturn="False"
                       PreviewKeyDown="OnReasonKeyDown" Loaded="OnEditorLoaded" Unloaded="OnEditorUnloaded" AutomationProperties.Name="Reason for rejecting the draft" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:CorvidButton Content="Reject" Foreground="{ThemeResource CorvidRed}" Style="{StaticResource CorvidSmallButton}"
                                       Command="{x:Bind ConfirmRejectCommand}" />
                <controls:CorvidButton Content="Back" Variant="Ghost" Style="{StaticResource CorvidSmallButton}" Command="{x:Bind BackCommand}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- A library row: name and description, author, last used, uses, evals. -->
    <DataTemplate x:Key="SkillRow" x:DataType="skills:SkillRowView">
      <Grid BorderBrush="{ThemeResource CorvidLine}" BorderThickness="0,1,0,0">
        <Border Background="{ThemeResource CorvidAccentBg}" Visibility="{x:Bind ui:Ui.VisibleIf(IsSelected), Mode=OneWay}" />
        <Button Style="{StaticResource SkRowButton}" Command="{x:Bind SelectCommand}" Click="OnRowClick" AutomationProperties.Name="{x:Bind AutomationName}">
          <local:SkillsTableRow Columns="*,100,86,52,60" NarrowColumns="*,100,0,0,60">
            <StackPanel Padding="10,7" Spacing="2">
              <controls:WrapRowPanel Spacing="6" LineSpacing="2">
                <TextBlock Text="{x:Bind Name}" FontFamily="{StaticResource CorvidMono}" FontSize="12.5" FontWeight="Medium" TextWrapping="Wrap" VerticalAlignment="Center" />
                <controls:TagChip Text="pinned" Tone="Blue" Visibility="{x:Bind ui:Ui.VisibleIf(IsPinned)}" />
                <controls:TagChip Text="idle" Tone="Amber" Visibility="{x:Bind ui:Ui.VisibleIf(IsStale)}" />
              </controls:WrapRowPanel>
              <TextBlock Text="{x:Bind Description}" Style="{StaticResource CorvidSmallText}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Border Grid.Column="1" Padding="10,8">
              <controls:TagChip Text="{x:Bind Author}" Tone="{x:Bind AuthorTone}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                ToolTipService.ToolTip="{x:Bind AuthorMeaning}" />
            </Border>
            <TextBlock Grid.Column="2" Text="{x:Bind LastUsed}" Style="{StaticResource SkCell}" />
            <TextBlock Grid.Column="3" Text="{x:Bind UsesText}" Style="{StaticResource SkCell}" HorizontalAlignment="Right" />
            <Border Grid.Column="4" Padding="10,8">
              <controls:TagChip Text="{x:Bind EvalText}" Tone="{x:Bind EvalTone}" HorizontalAlignment="Left" VerticalAlignment="Top" />
            </Border>
          </local:SkillsTableRow>
        </Button>
      </Grid>
    </DataTemplate>

    <!-- A history row: revision, author, when, the change. -->
    <DataTemplate x:Key="CommitRow" x:DataType="skills:CommitRowView">
      <Grid BorderBrush="{ThemeResource CorvidLine}" BorderThickness="0,1,0,0">
        <Border Background="{ThemeResource CorvidAccentBg}" Visibility="{x:Bind ui:Ui.VisibleIf(IsSelected), Mode=OneWay}" />
        <Button Style="{StaticResource SkRowButton}" Command="{x:Bind SelectCommand}" Click="OnRowClick" AutomationProperties.Name="{x:Bind AutomationName}">
          <local:SkillsTableRow Columns="76,100,124,*" NarrowColumns="76,0,0,*">
            <TextBlock Text="{x:Bind Revision}" Style="{StaticResource SkMonoCell}" />
            <Border Grid.Column="1" Padding="10,8">
              <controls:TagChip Text="{x:Bind Author}" Tone="{x:Bind AuthorTone}" HorizontalAlignment="Left" VerticalAlignment="Top" />
            </Border>
            <TextBlock Grid.Column="2" Text="{x:Bind When}" Style="{StaticResource SkMutedCell}" />
            <TextBlock Grid.Column="3" Text="{x:Bind Subject}" Style="{StaticResource SkCell}" TextWrapping="Wrap" />
          </local:SkillsTableRow>
        </Button>
      </Grid>
    </DataTemplate>

    <!-- A side-panel row for a library skill: name, uses, last used. -->
    <DataTemplate x:Key="MostUsedRow" x:DataType="skills:SkillRowView">
      <local:SkillsTableRow Columns="*,64,88" BorderBrush="{ThemeResource CorvidLine}" BorderThickness="0,1,0,0" AutomationProperties.Name="{x:Bind AutomationName}">
        <TextBlock Text="{x:Bind Name}" Style="{StaticResource SkMonoCell}" TextWrapping="Wrap" />
        <TextBlock Grid.Column="1" Text="{x:Bind UsesText}" Style="{StaticResource SkCell}" HorizontalAlignment="Right" />
        <TextBlock Grid.Column="2" Text="{x:Bind LastUsed}" Style="{StaticResource SkMutedCell}" />
      </local:SkillsTableRow>
    </DataTemplate>
  </Page.Resources>

  <Grid x:Name="Root" KeyDown="OnRootKeyDown">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- .page-head: the title and the tabs, the filter on the right; wraps when narrow. -->
    <Border x:Name="Head" Style="{StaticResource CorvidPageHead}" MinHeight="53">
      <controls:WrapRowPanel Spacing="12" LineSpacing="8" PushLastRight="True" VerticalAlignment="Center">
        <TextBlock x:Name="PageTitle" Text="{x:Bind ViewModel.Title}" Style="{StaticResource CorvidPageTitle}" VerticalAlignment="Center"
                   AutomationProperties.HeadingLevel="Level1" />
        <ItemsControl x:Name="TabStrip" ItemsSource="{x:Bind ViewModel.Tabs}" IsTabStop="False" VerticalAlignment="Center" AutomationProperties.Name="Skills views">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <controls:WrapRowPanel Spacing="2" LineSpacing="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="skills:SkillsTab">
              <controls:DockTab Label="{x:Bind Label}" Badge="{x:Bind BadgeText, Mode=OneWay}" IsSelected="{x:Bind IsSelected, Mode=OneWay}"
                                Command="{x:Bind Open}" AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBox x:Name="FilterBox" Width="300" Height="28" MinHeight="28" Padding="8,3,8,3" FontSize="13.5" CornerRadius="6"
                 VerticalAlignment="Center" PlaceholderText="Filter skills and history…"
                 Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 BorderBrush="{ThemeResource CorvidLine}" PreviewKeyDown="OnFilterKeyDown" AutomationProperties.Name="Filter skills and history" />
      </controls:WrapRowPanel>
    </Border>

    <!-- What the last action did, or why it failed, and a failed load. -->
    <StackPanel x:Name="Notices" Grid.Row="1" Spacing="8" Padding="24,14,24,0"
                Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasNotice), Mode=OneWay}" AutomationProperties.LiveSetting="Polite">
      <controls:ToneRow Tone="Red" Padding="12,8" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasLoadError), Mode=OneWay}">
        <TextBlock Text="{x:Bind ViewModel.LoadError, Mode=OneWay}" FontSize="12.5" TextWrapping="Wrap" />
      </controls:ToneRow>
      <controls:ToneRow Tone="{x:Bind ViewModel.OutcomeTone, Mode=OneWay}" Padding="12,8" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasOutcome), Mode=OneWay}">
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{x:Bind ViewModel.Outcome, Mode=OneWay}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" />
          <controls:IconButton Grid.Column="1" Icon="Check" Width="22" Height="22" Command="{x:Bind ViewModel.DismissOutcomeCommand}"
                               AutomationProperties.Name="Dismiss" ToolTipService.ToolTip="Dismiss" />
        </Grid>
      </controls:ToneRow>
    </StackPanel>

    <ScrollViewer x:Name="Scroller" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid x:Name="Body" Padding="24,18" ColumnSpacing="18" RowSpacing="14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="LeftColumn" Width="1.4*" />
          <ColumnDefinition x:Name="RightColumn" Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Review: the drafts. -->
        <StackPanel x:Name="ReviewColumn" Spacing="14" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.IsReviewTab), Mode=OneWay}">
          <TextBlock Text="{x:Bind ViewModel.IntroText}" Style="{StaticResource CorvidSmallText}" />
          <TextBlock Text="{x:Bind ViewModel.EmptyReviewText}" Style="{StaticResource CorvidMutedText}"
                     Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasNoDrafts), Mode=OneWay}" />
          <ItemsControl ItemsSource="{x:Bind ViewModel.Drafts}" ItemTemplate="{StaticResource DraftCard}" IsTabStop="False"
                        Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasDrafts), Mode=OneWay}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="14" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>

        <!-- Beside the drafts: the most used skills, the idle ones, the import. -->
        <StackPanel x:Name="ReviewSide" Grid.Column="1" Spacing="14" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.IsReviewTab), Mode=OneWay}">
          <Border Style="{StaticResource CorvidPanel}">
            <StackPanel>
              <Border Style="{StaticResource SkPanelHead}">
                <local:MemoryHeadPanel>
                  <TextBlock Text="Library · most used" Style="{StaticResource SkHeadTitle}" AutomationProperties.HeadingLevel="Level2" />
                  <controls:LinkButton Text="Open the library" FontSize="12" Command="{x:Bind ViewModel.OpenLibraryCommand}" />
                </local:MemoryHeadPanel>
              </Border>
              <local:SkillsTableRow Columns="*,64,88">
                <TextBlock Text="skill" Style="{StaticResource SkTh}" />
                <TextBlock Grid.Column="1" Text="uses" Style="{StaticResource SkTh}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2" Text="last used" Style="{StaticResource SkTh}" />
              </local:SkillsTableRow>
              <ItemsControl ItemsSource="{x:Bind ViewModel.MostUsed}" ItemTemplate="{StaticResource MostUsedRow}" IsTabStop="False"
                            AutomationProperties.Name="Most used skills" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CorvidPanel}">
            <StackPanel>
              <Border Style="{StaticResource SkPanelHead}">
                <local:MemoryHeadPanel>
                  <TextBlock Text="{x:Bind ViewModel.StaleTitle, Mode=OneWay}" Style="{StaticResource SkHeadTitle}" AutomationProperties.HeadingLevel="Level2" />
                  <TextBlock Text="the curator's archive suggestion" Style="{StaticResource SkHeadDetail}" />
                </local:MemoryHeadPanel>
              </Border>
              <StackPanel Padding="14,12" Spacing="8">
                <TextBlock Text="{x:Bind ViewModel.StaleIntro}" Style="{StaticResource CorvidSmallText}"
                           Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasStaleSkills), Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.NoStaleText, Mode=OneWay}" Style="{StaticResource CorvidSmallText}"
                           Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasNoStaleSkills), Mode=OneWay}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.StaleSkills}" IsTabStop="False" AutomationProperties.Name="Idle skills">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="skills:StaleSkillView">
                      <Grid Padding="0,6" ColumnSpacing="10" BorderBrush="{ThemeResource CorvidLine}" BorderThickness="0,0,0,1"
                            AutomationProperties.Name="{x:Bind AutomationName}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="1">
                          <controls:LinkButton Text="{x:Bind Name}" FontSize="12.5" Command="{x:Bind OpenCommand}" HorizontalAlignment="Left"
                                               ToolTipService.ToolTip="Open it in the library" />
                          <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CorvidSmallText}" />
                        </StackPanel>
                        <controls:CorvidButton Grid.Column="1" Content="Archive" Style="{StaticResource CorvidSmallButton}" Command="{x:Bind ArchiveCommand}"
                                               VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <controls:CorvidButton Content="{x:Bind ViewModel.ArchiveAllLabel, Mode=OneWay}" Variant="Ghost" Style="{StaticResource CorvidSmallButton}"
                                       Command="{x:Bind ViewModel.ArchiveAllStaleCommand}" HorizontalAlignment="Left"
                                       Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasStaleSkills), Mode=OneWay}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CorvidPanel}">
            <StackPanel>
              <Border Style="{StaticResource SkPanelHead}">
                <local:MemoryHeadPanel>
                  <TextBlock Text="Import" Style="{StaticResource SkHeadTitle}" AutomationProperties.HeadingLevel="Level2" />
                  <TextBlock Text="Hermes · a folder" Style="{StaticResource SkHeadDetail}" />
                </local:MemoryHeadPanel>
              </Border>
              <StackPanel Padding="14,12" Spacing="8">
                <TextBlock Text="Skills from Hermes or a folder are scanned first; a finding refuses one. A dry run lists them before anything is imported."
                           Style="{StaticResource CorvidSmallText}" />
                <controls:CorvidButton Content="Import…" Style="{StaticResource CorvidSmallButton}" Command="{x:Bind ViewModel.OpenImportCommand}" HorizontalAlignment="Left" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Library: the table. -->
        <Border x:Name="LibraryTable" Style="{StaticResource CorvidPanel}" VerticalAlignment="Top" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.IsLibraryTab), Mode=OneWay}">
          <StackPanel>
            <Border Style="{StaticResource SkPanelHead}">
              <local:MemoryHeadPanel>
                <TextBlock Text="Library" Style="{StaticResource SkHeadTitle}" AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Text="{x:Bind ViewModel.LibrarySummary, Mode=OneWay}" Style="{StaticResource SkHeadDetail}" />
              </local:MemoryHeadPanel>
            </Border>
            <ItemsControl ItemsSource="{x:Bind ViewModel.Issues, Mode=OneWay}" IsTabStop="False" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasIssues), Mode=OneWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{x:Bind}" FontSize="12" Foreground="{ThemeResource CorvidAmber}" Margin="14,6" TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <local:SkillsTableRow Columns="*,100,86,52,60" NarrowColumns="*,100,0,0,60">
              <TextBlock Text="skill" Style="{StaticResource SkTh}" />
              <TextBlock Grid.Column="1" Text="author" Style="{StaticResource SkTh}" />
              <TextBlock Grid.Column="2" Text="last used" Style="{StaticResource SkTh}" />
              <TextBlock Grid.Column="3" Text="uses" Style="{StaticResource SkTh}" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="4" Text="evals" Style="{StaticResource SkTh}" />
            </local:SkillsTableRow>
            <ItemsControl x:Name="SkillRows" ItemsSource="{x:Bind ViewModel.Skills}" ItemTemplate="{StaticResource SkillRow}" IsTabStop="False"
                          PreviewKeyDown="OnRowsKeyDown" AutomationProperties.Name="Skills" />
            <TextBlock Text="{x:Bind ViewModel.NoSkillsText, Mode=OneWay}" Style="{StaticResource CorvidMutedText}" Margin="14,10"
                       Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasNoSkills), Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.MoreSkillsText, Mode=OneWay}" Style="{StaticResource CorvidSmallText}" Margin="14,8"
                       Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasMoreSkills), Mode=OneWay}" />
            <controls:LinkButton Text="Clear the filter" FontSize="12.5" Margin="14,4,14,10" Command="{x:Bind ViewModel.ClearFilterCommand}"
                                 Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.IsFiltered), Mode=OneWay}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>

        <!-- Library: the open skill. -->
        <StackPanel x:Name="LibrarySide" Grid.Column="1" Spacing="14" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.IsLibraryTab), Mode=OneWay}">
          <Border Style="{StaticResource CorvidPanel}" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasNoDetail), Mode=OneWay}">
            <TextBlock Text="Pick a skill to see its SKILL.md, its evals and its history. Up and Down move through the table." Style="{StaticResource CorvidSmallText}"
                       Margin="14,12" />
          </Border>
          <ContentControl Content="{x:Bind ViewModel.Detail, Mode=OneWay}" HorizontalContentAlignment="Stretch" IsTabStop="False"
                          Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasDetail), Mode=OneWay}">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="skills:SkillDetailView">
                <StackPanel Spacing="14">
                  <Border Style="{StaticResource CorvidPanel}" AutomationProperties.Name="{x:Bind Name}">
                    <StackPanel>
                      <Border Style="{StaticResource SkPanelHead}">
                        <Grid ColumnSpacing="10">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{x:Bind Name}" Style="{StaticResource SkHeadTitle}" FontFamily="{StaticResource CorvidMono}" FontWeight="Medium"
                                     TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
                          <controls:TagChip Grid.Column="1" Text="{x:Bind Row.Author}" Tone="{x:Bind Row.AuthorTone}" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                      <StackPanel Padding="14,12" Spacing="10">
                        <TextBlock Text="{x:Bind Description}" Style="{StaticResource CorvidBodyText}" />
                        <controls:ToneRow Tone="Amber" Padding="10,6" Visibility="{x:Bind ui:Ui.VisibleIf(Row.IsOutside)}">
                          <TextBlock Text="Outside content: loading this skill taints the session, so network reads ask and egress offers only “once”."
                                     FontSize="12.5" TextWrapping="Wrap" />
                        </controls:ToneRow>
                        <ItemsControl ItemsSource="{x:Bind Facts}" IsTabStop="False">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="skills:SkillFact">
                              <Grid ColumnSpacing="10" Padding="0,3">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="72" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Key}" Style="{StaticResource SkKey}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontSize="12.5" TextWrapping="Wrap"
                                           FontFamily="{x:Bind local:SkillsPage.FactFont(IsCode)}" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{x:Bind StaleNote}" FontSize="12.5" Foreground="{ThemeResource CorvidAmber}" TextWrapping="Wrap"
                                   Visibility="{x:Bind ui:Ui.VisibleIf(IsStale)}" />
                        <controls:WrapRowPanel Spacing="8" LineSpacing="8" Visibility="{x:Bind ui:Ui.CollapsedIf(IsConfirmingArchive), Mode=OneWay}">
                          <controls:CorvidButton Content="{x:Bind PinLabel}" Style="{StaticResource CorvidSmallButton}" Command="{x:Bind TogglePinCommand}"
                                                 ToolTipService.ToolTip="{x:Bind PinHint}" />
                          <controls:CorvidButton Content="Run evals" Style="{StaticResource CorvidSmallButton}" Command="{x:Bind RunEvalsCommand}"
                                                 ToolTipService.ToolTip="Replay each evals/ case with the skill loaded" />
                          <controls:CorvidButton Content="History" Variant="Ghost" Style="{StaticResource CorvidSmallButton}" Command="{x:Bind ShowHistoryCommand}" />
                          <controls:CorvidButton Content="Archive…" Variant="Ghost" Foreground="{ThemeResource CorvidRed}" Style="{StaticResource CorvidSmallButton}"
                                                 Command="{x:Bind StartArchiveCommand}" Visibility="{x:Bind ui:Ui.VisibleIf(CanArchive)}" />
                        </controls:WrapRowPanel>
                        <StackPanel Spacing="6" Visibility="{x:Bind ui:Ui.VisibleIf(IsConfirmingArchive), Mode=OneWay}">
                          <TextBlock Text="Move it to .archive/? It leaves the library; git keeps it." Style="{StaticResource CorvidSmallText}" />
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:CorvidButton Content="Archive" Foreground="{ThemeResource CorvidRed}" Style="{StaticResource CorvidSmallButton}"
                                                   Command="{x:Bind ConfirmArchiveCommand}" />
                            <controls:CorvidButton Content="Back" Variant="Ghost" Style="{StaticResource CorvidSmallButton}" Command="{x:Bind CancelArchiveCommand}" />
                          </StackPanel>
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <Border Style="{StaticResource CorvidPanel}">
                    <StackPanel>
                      <Border Style="{StaticResource SkPanelHead}">
                        <local:MemoryHeadPanel>
                          <TextBlock Text="Evals" Style="{StaticResource SkHeadTitle}" AutomationProperties.HeadingLevel="Level2" />
                          <TextBlock Text="passed of total, by revision" Style="{StaticResource SkHeadDetail}" />
                        </local:MemoryHeadPanel>
                      </Border>
                      <TextBlock Text="{x:Bind EvalsEmptyText}" Style="{StaticResource CorvidSmallText}" Margin="14,10"
                                 Visibility="{x:Bind ui:Ui.VisibleIf(HasNoEvalRuns), Mode=OneWay}" />
                      <ItemsControl ItemsSource="{x:Bind EvalRuns}" IsTabStop="False" AutomationProperties.Name="Eval runs">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="skills:EvalRunView">
                            <local:SkillsTableRow Columns="*,124,60" BorderBrush="{ThemeResource CorvidLine}" BorderThickness="0,0,0,1"
                                                  AutomationProperties.Name="{x:Bind AutomationName}">
                              <TextBlock Text="{x:Bind Label}" Style="{StaticResource SkMonoCell}" />
                              <TextBlock Grid.Column="1" Text="{x:Bind When}" Style="{StaticResource SkMutedCell}" />
                              <Border Grid.Column="2" Padding="10,7">
                                <controls:TagChip Text="{x:Bind Score}" Tone="{x:Bind Tone}" HorizontalAlignment="Left" />
                              </Border>
                            </local:SkillsTableRow>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <StackPanel Padding="14,10" Spacing="4" Visibility="{x:Bind ui:Ui.VisibleIf(HasEvalRuns), Mode=OneWay}">
                        <TextBlock Text="{x:Bind LatestTitle, Mode=OneWay}" Style="{StaticResource SkSectTitle}" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{x:Bind LatestCases, Mode=OneWay}" IsTabStop="False">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="skills:EvalCaseView">
                              <Grid ColumnSpacing="10" Padding="0,3">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:TagChip Text="{x:Bind Verdict}" Tone="{x:Bind Tone}" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                  <TextBlock Text="{x:Bind Case}" FontFamily="{StaticResource CorvidMono}" FontSize="12" />
                                  <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CorvidSmallText}" TextWrapping="Wrap" />
                                </StackPanel>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <Border Style="{StaticResource CorvidPanel}">
                    <StackPanel>
                      <Border Style="{StaticResource SkPanelHead}">
                        <local:MemoryHeadPanel>
                          <TextBlock Text="SKILL.md" Style="{StaticResource SkHeadTitle}" AutomationProperties.HeadingLevel="Level2" />
                          <TextBlock Text="rendered" Style="{StaticResource SkHeadDetail}" />
                        </local:MemoryHeadPanel>
                      </Border>
                      <controls:MarkdownView Document="{x:Bind Document}" Margin="14,12" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </StackPanel>

        <!-- History: the log. -->
        <Border x:Name="HistoryTable" Style="{StaticResource CorvidPanel}" VerticalAlignment="Top" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.IsHistoryTab), Mode=OneWay}">
          <StackPanel>
            <Border Style="{StaticResource SkPanelHead}">
              <local:MemoryHeadPanel>
                <TextBlock Text="{x:Bind ViewModel.HistoryTitle, Mode=OneWay}" Style="{StaticResource SkHeadTitle}" AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Text="{x:Bind ViewModel.HistorySummary}" Style="{StaticResource SkHeadDetail}" />
              </local:MemoryHeadPanel>
            </Border>
            <controls:LinkButton Text="Show every skill's history" FontSize="12.5" Margin="14,8,14,4" Command="{x:Bind ViewModel.ClearHistoryFilterCommand}"
                                 Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.IsHistoryNarrowed), Mode=OneWay}" HorizontalAlignment="Left" />
            <local:SkillsTableRow Columns="76,100,124,*" NarrowColumns="76,0,0,*">
              <TextBlock Text="revision" Style="{StaticResource SkTh}" />
              <TextBlock Grid.Column="1" Text="author" Style="{StaticResource SkTh}" />
              <TextBlock Grid.Column="2" Text="when" Style="{StaticResource SkTh}" />
              <TextBlock Grid.Column="3" Text="change" Style="{StaticResource SkTh}" />
            </local:SkillsTableRow>
            <ItemsControl x:Name="CommitRows" ItemsSource="{x:Bind ViewModel.Commits}" ItemTemplate="{StaticResource CommitRow}" IsTabStop="False"
                          PreviewKeyDown="OnRowsKeyDown" AutomationProperties.Name="Commits" />
            <TextBlock Text="{x:Bind ViewModel.NoCommitsText, Mode=OneWay}" Style="{StaticResource CorvidMutedText}" Margin="14,10"
                       Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasNoCommits), Mode=OneWay}" />
          </StackPanel>
        </Border>

        <!-- History: the open commit. -->
        <StackPanel x:Name="HistorySide" Grid.Column="1" Spacing="14" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.IsHistoryTab), Mode=OneWay}">
          <Border Style="{StaticResource CorvidPanel}" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasNoCommitDetail), Mode=OneWay}">
            <TextBlock Text="Pick a commit to see its diff and revert it. Up and Down move through the log." Style="{StaticResource CorvidSmallText}" Margin="14,12" />
          </Border>
          <ContentControl Content="{x:Bind ViewModel.CommitDetail, Mode=OneWay}" HorizontalContentAlignment="Stretch" IsTabStop="False"
                          Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasCommitDetail), Mode=OneWay}">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="skills:CommitDetailView">
                <Border Style="{StaticResource CorvidPanel}">
                  <StackPanel>
                    <Border Style="{StaticResource SkPanelHead}">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind Subject}" Style="{StaticResource SkHeadTitle}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Style="{StaticResource CorvidSmallText}">
                          <Run Text="{x:Bind Revision}" FontFamily="{StaticResource CorvidMono}" />
                          <Run Text="·" />
                          <Run Text="{x:Bind Byline}" />
                        </TextBlock>
                      </StackPanel>
                    </Border>
                    <StackPanel Padding="14,12" Spacing="10">
                      <ItemsControl ItemsSource="{x:Bind Files}" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Spacing="10" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="skills:CommitFileView">
                            <Border BorderBrush="{ThemeResource CorvidLine}" BorderThickness="1" CornerRadius="8" Background="{ThemeResource CorvidBg}">
                              <StackPanel>
                                <Grid Padding="10,6" BorderBrush="{ThemeResource CorvidLine}" BorderThickness="0,0,0,1" Background="{ThemeResource CorvidBg2}">
                                  <TextBlock Text="{x:Bind Path}" FontFamily="{StaticResource CorvidMono}" FontSize="12" TextWrapping="Wrap" Margin="0,0,80,0" />
                                  <TextBlock Text="{x:Bind Counts}" FontSize="12" Foreground="{ThemeResource CorvidText2}" HorizontalAlignment="Right" />
                                </Grid>
                                <controls:DiffRowsView Rows="{x:Bind Rows}" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <controls:CorvidButton Content="Revert…" Style="{StaticResource CorvidSmallButton}" Command="{x:Bind StartRevertCommand}" HorizontalAlignment="Left"
                                             Visibility="{x:Bind ui:Ui.VisibleIf(IsReading), Mode=OneWay}"
                                             ToolTipService.ToolTip="Write a commit, authored user, that undoes this one" />
                      <StackPanel Spacing="6" Visibility="{x:Bind ui:Ui.VisibleIf(IsConfirmingRevert), Mode=OneWay}">
                        <TextBlock Text="{x:Bind RevertNote}" Style="{StaticResource CorvidSmallText}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <controls:CorvidButton Content="Revert" Variant="Primary" Style="{StaticResource CorvidSmallButton}" Command="{x:Bind ConfirmRevertCommand}" />
                          <controls:CorvidButton Content="Back" Variant="Ghost" Style="{StaticResource CorvidSmallButton}" Command="{x:Bind CancelRevertCommand}" />
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </StackPanel>

        <!-- Import: the source, the dry run, then what it found. -->
        <StackPanel Grid.ColumnSpan="2" Spacing="14" MaxWidth="820" HorizontalAlignment="Left" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.IsImportTab), Mode=OneWay}">
          <Border Style="{StaticResource CorvidPanel}">
            <StackPanel>
              <Border Style="{StaticResource SkPanelHead}">
                <local:MemoryHeadPanel>
                  <TextBlock Text="Import skills" Style="{StaticResource SkHeadTitle}" AutomationProperties.HeadingLevel="Level2" />
                  <TextBlock Text="scanned before anything is imported" Style="{StaticResource SkHeadDetail}" />
                </local:MemoryHeadPanel>
              </Border>
              <StackPanel Padding="14,12" Spacing="10">
                <controls:WrapRowPanel Spacing="10" LineSpacing="6">
                  <TextBlock Text="from" Style="{StaticResource SkKey}" VerticalAlignment="Center" />
                  <Border Height="24" BorderBrush="{ThemeResource CorvidLine}" BorderThickness="1" CornerRadius="6" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.ImportKinds}" IsTabStop="False" AutomationProperties.Name="Import from">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="mvvm:Choice">
                          <controls:SegmentButton Content="{x:Bind Label}" IsChecked="{x:Bind IsSelected, Mode=OneWay}" Command="{x:Bind Choose}"
                                                  AutomationProperties.HelpText="{x:Bind Description}" ToolTipService.ToolTip="{x:Bind Description}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                </controls:WrapRowPanel>
                <TextBlock Text="{x:Bind ViewModel.ImportNote, Mode=OneWay}" Style="{StaticResource CorvidSmallText}" />
                <Grid ColumnSpacing="10" RowSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="folder" Style="{StaticResource SkKey}" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{x:Bind ViewModel.ImportFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SkTextBox}"
                           FontFamily="{StaticResource CorvidMono}" FontSize="12.5" TextWrapping="NoWrap" PlaceholderText="{x:Bind ViewModel.FolderPlaceholder, Mode=OneWay}"
                           PreviewKeyDown="OnImportKeyDown" AutomationProperties.Name="Folder to import from" />
                  <TextBlock Grid.Row="1" Text="source" Style="{StaticResource SkKey}" VerticalAlignment="Center"
                             Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.IsFolderImport), Mode=OneWay}" />
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.ImportSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SkTextBox}"
                           TextWrapping="NoWrap" PlaceholderText="the hub name the skills are authored as; local by default" PreviewKeyDown="OnImportKeyDown"
                           Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.IsFolderImport), Mode=OneWay}" AutomationProperties.Name="Hub name" />
                </Grid>
                <controls:CorvidButton Content="Dry run" Style="{StaticResource CorvidSmallButton}" Command="{x:Bind ViewModel.ScanCommand}" HorizontalAlignment="Left"
                                       ToolTipService.ToolTip="List and scan every skill; nothing is imported" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CorvidPanel}" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasScan), Mode=OneWay}">
            <StackPanel>
              <Border Style="{StaticResource SkPanelHead}">
                <TextBlock Text="{x:Bind ViewModel.ScanTitle, Mode=OneWay}" Style="{StaticResource SkHeadTitle}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" />
              </Border>
              <StackPanel Padding="14,12" Spacing="8">
                <TextBlock Text="{x:Bind ViewModel.ScanSummary, Mode=OneWay}" Style="{StaticResource SkSectTitle}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Candidates}" IsTabStop="False" AutomationProperties.Name="Skills found">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="skills:ImportCandidateView">
                      <Grid Padding="0,6" ColumnSpacing="8" BorderBrush="{ThemeResource CorvidLine}" BorderThickness="0,0,0,1"
                            AutomationProperties.Name="{x:Bind AutomationName}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                          <TextBlock FontSize="12.5" TextWrapping="Wrap">
                            <Run Text="{x:Bind Name}" FontFamily="{StaticResource CorvidMono}" FontWeight="Medium" />
                            <Run Text="{x:Bind local:SkillsPage.Dotted(Description)}" />
                          </TextBlock>
                          <TextBlock Text="{x:Bind Path}" FontFamily="{StaticResource CorvidMono}" FontSize="11.5" Foreground="{ThemeResource CorvidText2}" />
                          <ItemsControl ItemsSource="{x:Bind Findings}" IsTabStop="False" Visibility="{x:Bind ui:Ui.VisibleIf(HasFindings)}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" FontSize="12" Foreground="{ThemeResource CorvidRed}" TextWrapping="Wrap" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                        <controls:TagChip Grid.Column="1" Text="{x:Bind Verdict}" Tone="{x:Bind VerdictTone}" VerticalAlignment="Top" Margin="0,1,0,0" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <controls:CorvidButton Content="{x:Bind ViewModel.ImportLabel, Mode=OneWay}" Variant="Primary" Style="{StaticResource CorvidSmallButton}"
                                         Command="{x:Bind ViewModel.ImportCommand}" />
                  <controls:CorvidButton Content="Cancel" Variant="Ghost" Style="{StaticResource CorvidSmallButton}" Command="{x:Bind ViewModel.CancelScanCommand}" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>

<Page x:Class="Corvid.App.Pages.MemoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Corvid.App.Controls"
      xmlns:memory="using:Corvid.App.Core.Memory"
      xmlns:local="using:Corvid.App.Pages"
      xmlns:ui="using:Corvid.App.Infrastructure"
      Background="{ThemeResource CorvidBg}"
      Foreground="{ThemeResource CorvidText}"
      FontSize="13.5">
  <!--
    Memory (Memory.png, Memory-narrow.png; Memory.dc.html): the page head with its tabs and the search, then on the
    Review tab the queue (staged facts, core block updates, lesson candidates) beside the core blocks, the recent facts and
    the Hermes import, in 1.4fr and 1fr columns 18 apart. The other tabs fill the width. No dock.
  -->
  <Page.Resources>
    <!-- .panel-head: 10px 14px, a line below, weight 600; the detail .muted.small (still 600). -->
    <Style x:Key="MemPanelHead" TargetType="Border">
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="BorderBrush" Value="{ThemeResource CorvidLine}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style x:Key="MemHeadTitle" TargetType="TextBlock" BasedOn="{StaticResource CorvidBodyText}">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="MemHeadDetail" TargetType="TextBlock" BasedOn="{StaticResource CorvidSmallText}">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- .sect-head: 12.5 px semibold, the detail muted on the right. -->
    <Style x:Key="MemSectTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="Foreground" Value="{ThemeResource CorvidText}" />
    </Style>
    <Style x:Key="MemSectDetail" TargetType="TextBlock" BasedOn="{StaticResource MemSectTitle}">
      <Setter Property="Foreground" Value="{ThemeResource CorvidText2}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <!-- .kv: 12.5 px; .k muted, at least 64 px. -->
    <Style x:Key="MemKey" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="MinWidth" Value="64" />
      <Setter Property="Foreground" Value="{ThemeResource CorvidText2}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="MemCell" TargetType="TextBlock" BasedOn="{StaticResource CorvidBodyText}">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="LineHeight" Value="18.1" />
    </Style>
    <Style x:Key="MemMutedCell" TargetType="TextBlock" BasedOn="{StaticResource MemCell}">
      <Setter Property="Foreground" Value="{ThemeResource CorvidText2}" />
    </Style>
    <!-- .table th: 12.5 px semibold muted, 6px 10px. -->
    <Style x:Key="MemTh" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{ThemeResource CorvidText2}" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <!-- .target: 20 high, 0 7px, radius 5, bg-3, 12 px. -->
    <Style x:Key="MemTarget" TargetType="Border">
      <Setter Property="Height" Value="20" />
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="{ThemeResource CorvidBg3}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- .files li as a button: 5px 8px, radius 6, bg-3 on hover. -->
    <Style x:Key="MemRowButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="UseSystemFocusVisuals" Value="True" />
      <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource CorvidAccent}" />
      <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource CorvidBg}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Root" CornerRadius="6" Background="Transparent">
              <Border x:Name="Hover" CornerRadius="6" Background="{ThemeResource CorvidBg3}" Opacity="0" />
              <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="Stretch" Foreground="{ThemeResource CorvidText}" />
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                      <Setter Target="Hover.Opacity" Value="1" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                      <Setter Target="Hover.Opacity" Value="1" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Disabled" />
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- .select: 28 high, 0 8px, a line border, radius 6, on bg. -->
    <Style x:Key="MemSelect" TargetType="controls:CorvidButton" BasedOn="{StaticResource CorvidButtonBase}">
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="MemTextBox" TargetType="TextBox">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- A staged fact (Memory.png's first panel). -->
    <DataTemplate x:Key="FactCard" x:DataType="memory:StagedFactView">
      <Border Style="{StaticResource CorvidPanel}" AutomationProperties.Name="{x:Bind Title}">
        <StackPanel>
          <Border Style="{StaticResource MemPanelHead}">
            <local:MemoryHeadPanel>
              <TextBlock Text="{x:Bind Title}" Style="{StaticResource MemHeadTitle}" AutomationProperties.HeadingLevel="Level2" />
              <TextBlock Text="{x:Bind Why}" Style="{StaticResource MemHeadDetail}" />
            </local:MemoryHeadPanel>
          </Border>
          <StackPanel Padding="14,12" Spacing="10">
            <!-- .row.memory: bg-2, a dashed line border, 6px 10px; staged memory is dotted (ui.md §7). -->
            <Grid Visibility="{x:Bind ui:Ui.VisibleIf(IsReading), Mode=OneWay}">
              <Rectangle RadiusX="6" RadiusY="6" Fill="{ThemeResource CorvidBg2}" Stroke="{ThemeResource CorvidLine}" StrokeThickness="1"
                         StrokeDashArray="3,2" />
              <Grid Padding="10,6" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:Icon Kind="Layers" Foreground="{ThemeResource CorvidText}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" local:MemorySpans.Spans="{x:Bind Statement}" Style="{StaticResource CorvidBodyText}" VerticalAlignment="Center" />
              </Grid>
            </Grid>
            <StackPanel Spacing="4" Visibility="{x:Bind ui:Ui.VisibleIf(IsCorrecting), Mode=OneWay}">
              <TextBlock Text="Correct the statement; Approve writes it as edited. Enter approves, Esc undoes." Style="{StaticResource CorvidSmallText}" />
              <TextBox Text="{x:Bind CorrectedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MemTextBox}"
                       AcceptsReturn="False" PreviewKeyDown="OnFactEditorKeyDown" Loaded="OnEditorLoaded"
                       AutomationProperties.Name="The statement, corrected" />
            </StackPanel>
            <controls:WrapRowPanel Spacing="8" LineSpacing="8" Visibility="{x:Bind ui:Ui.VisibleIf(HasEntities)}">
              <TextBlock Text="entities" Style="{StaticResource MemKey}" />
              <ItemsControl ItemsSource="{x:Bind Entities}" IsTabStop="False" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <controls:WrapRowPanel Spacing="8" LineSpacing="8" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Border Style="{StaticResource MemTarget}">
                      <TextBlock Text="{x:Bind}" FontSize="12" VerticalAlignment="Center" TextWrapping="NoWrap" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{x:Bind ValidText}" FontSize="12.5" Foreground="{ThemeResource CorvidText2}" VerticalAlignment="Center" TextWrapping="NoWrap" />
            </controls:WrapRowPanel>
            <StackPanel Visibility="{x:Bind ui:Ui.VisibleIf(HasNearest)}">
              <Grid Margin="0,0,0,6">
                <TextBlock Text="Nearest existing facts" Style="{StaticResource MemSectTitle}" AutomationProperties.HeadingLevel="Level3" />
                <TextBlock Text="{x:Bind SearchKind}" Style="{StaticResource MemSectDetail}" />
              </Grid>
              <ItemsControl ItemsSource="{x:Bind Nearest}" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="memory:NearbyFactView">
                    <Grid>
                      <Border CornerRadius="6" Background="{ThemeResource CorvidAccentBg}" Visibility="{x:Bind ui:Ui.VisibleIf(IsTarget), Mode=OneWay}" />
                      <Button Style="{StaticResource MemRowButton}" Command="{x:Bind SelectCommand}"
                              AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                              ToolTipService.ToolTip="Pick this fact as the one an update or invalidation closes">
                        <Grid ColumnSpacing="10">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock local:MemorySpans.Spans="{x:Bind Spans}" Style="{StaticResource CorvidBodyText}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{x:Bind ScoreText}" FontSize="12" Foreground="{ThemeResource CorvidText}" VerticalAlignment="Center" />
                        </Grid>
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <TextBlock Text="{x:Bind TargetHint, Mode=OneWay}" Style="{StaticResource CorvidSmallText}"
                       Visibility="{x:Bind ui:Ui.VisibleIf(HasTargetHint), Mode=OneWay}" />
            <controls:WrapRowPanel Spacing="8" LineSpacing="8" PushLastRight="{x:Bind HasEvidence}">
              <TextBlock Text="operation" FontSize="12" Foreground="{ThemeResource CorvidText2}" VerticalAlignment="Center" />
              <controls:CorvidButton Style="{StaticResource MemSelect}" Width="98" Click="OnOperationClick"
                                     AutomationProperties.Name="{x:Bind OperationName, Mode=OneWay}">
                <Grid Width="80">
                  <TextBlock Text="{x:Bind OperationLabel, Mode=OneWay}" VerticalAlignment="Center" />
                  <controls:Icon Kind="ChevronDown" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource CorvidText}" />
                </Grid>
              </controls:CorvidButton>
              <controls:CorvidButton Content="Approve" Variant="Primary" Style="{StaticResource CorvidSmallButton}" Command="{x:Bind ApproveCommand}" />
              <controls:CorvidButton Content="{x:Bind CorrectLabel, Mode=OneWay}" Style="{StaticResource CorvidSmallButton}" Command="{x:Bind CorrectCommand}" />
              <controls:CorvidButton Content="Reject" Variant="Ghost" Foreground="{ThemeResource CorvidRed}" Style="{StaticResource CorvidSmallButton}"
                                     Command="{x:Bind RejectCommand}" />
              <controls:LinkButton Text="{x:Bind Evidence}" FontSize="12" Command="{x:Bind OpenEvidenceCommand}" VerticalAlignment="Center"
                                   Visibility="{x:Bind ui:Ui.VisibleIf(HasEvidence)}" ToolTipService.ToolTip="Open the events in Audit" />
            </controls:WrapRowPanel>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- A staged core block update (Memory.png's second panel). -->
    <DataTemplate x:Key="BlockCard" x:DataType="memory:BlockUpdateView">
      <Border Style="{StaticResource CorvidPanel}" AutomationProperties.Name="{x:Bind TitleText}">
        <StackPanel>
          <Border Style="{StaticResource MemPanelHead}">
            <local:MemoryHeadPanel>
              <TextBlock local:MemorySpans.Spans="{x:Bind Title}" Style="{StaticResource MemHeadTitle}" AutomationProperties.HeadingLevel="Level2" />
              <TextBlock Text="{x:Bind Why}" Style="{StaticResource MemHeadDetail}" />
            </local:MemoryHeadPanel>
          </Border>
          <StackPanel Padding="14,12" Spacing="10">
            <!-- .diff with two .dl rows: the context, then the added line on add-bg in green; 12.5 px, no wrapping. -->
            <Border BorderBrush="{ThemeResource CorvidLine}" BorderThickness="1" CornerRadius="8" Background="{ThemeResource CorvidBg}"
                    Visibility="{x:Bind ui:Ui.VisibleIf(ShowsDiff), Mode=OneWay}">
              <StackPanel>
                <Grid MinHeight="22">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border BorderBrush="{ThemeResource CorvidLine}" BorderThickness="0,0,1,0" />
                  <TextBlock Grid.Column="1" Text="{x:Bind Context}" FontSize="12.5" Margin="8,2,0,2" TextWrapping="NoWrap" VerticalAlignment="Center" />
                </Grid>
                <Grid MinHeight="22" Background="{ThemeResource CorvidAddBg}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border BorderBrush="{ThemeResource CorvidLine}" BorderThickness="0,0,1,0">
                    <TextBlock Text="+" FontSize="12.5" Foreground="{ThemeResource CorvidGreen}" HorizontalAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="{x:Bind Added}" FontSize="12.5" Margin="8,2,0,2" TextWrapping="NoWrap" VerticalAlignment="Center"
                             Foreground="{ThemeResource CorvidGreen}" />
                </Grid>
              </StackPanel>
            </Border>
            <StackPanel Spacing="4" Visibility="{x:Bind ui:Ui.VisibleIf(IsEditing), Mode=OneWay}">
              <TextBlock Text="{x:Bind EditLabel, Mode=OneWay}" Style="{StaticResource CorvidSmallText}" />
              <TextBox Text="{x:Bind EditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MemTextBox}"
                       AcceptsReturn="False" PreviewKeyDown="OnBlockEditorKeyDown" Loaded="OnEditorLoaded"
                       AutomationProperties.Name="{x:Bind EditLabel, Mode=OneWay}" />
            </StackPanel>
            <controls:WrapRowPanel Spacing="8" LineSpacing="8">
              <TextBlock Text="budget after" Style="{StaticResource MemKey}" />
              <TextBlock Text="{x:Bind BudgetText, Mode=OneWay}" FontSize="12.5" VerticalAlignment="Center" TextWrapping="NoWrap" />
              <controls:Meter Width="120" Fraction="{x:Bind BudgetFraction, Mode=OneWay}" IsWarning="{x:Bind IsNearBudget, Mode=OneWay}" VerticalAlignment="Center" />
              <TextBlock Text="{x:Bind ConsolidationNote}" FontSize="12" Foreground="{ThemeResource CorvidText2}" VerticalAlignment="Center" TextWrapping="NoWrap" />
            </controls:WrapRowPanel>
            <controls:WrapRowPanel Spacing="8" LineSpacing="8" PushLastRight="True">
              <controls:CorvidButton Content="Approve" Variant="Primary" Style="{StaticResource CorvidSmallButton}" Command="{x:Bind ApproveCommand}" />
              <controls:CorvidButton Content="{x:Bind CorrectLabel, Mode=OneWay}" Style="{StaticResource CorvidSmallButton}" Command="{x:Bind CorrectCommand}" />
              <controls:CorvidButton Content="Reject" Variant="Ghost" Foreground="{ThemeResource CorvidRed}" Style="{StaticResource CorvidSmallButton}"
                                     Command="{x:Bind RejectCommand}" />
              <controls:CorvidButton Content="Consolidate the block…" Variant="Ghost" Style="{StaticResource CorvidSmallButton}"
                                     Command="{x:Bind ConsolidateCommand}"
                                     ToolTipService.ToolTip="Rewrite the block shorter with this update folded in; you see it before it is written" />
            </controls:WrapRowPanel>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- A lesson candidate (Memory.png's third panel). -->
    <DataTemplate x:Key="LessonCard" x:DataType="memory:LessonCandidateView">
      <Border Style="{StaticResource CorvidPanel}" AutomationProperties.Name="{x:Bind Title}">
        <StackPanel>
          <Border Style="{StaticResource MemPanelHead}">
            <local:MemoryHeadPanel>
              <TextBlock Text="{x:Bind Title}" Style="{StaticResource MemHeadTitle}" AutomationProperties.HeadingLevel="Level2" />
              <TextBlock Text="{x:Bind Status}" Style="{StaticResource MemHeadDetail}" />
            </local:MemoryHeadPanel>
          </Border>
          <StackPanel Padding="14,12" Spacing="8">
            <TextBlock local:MemorySpans.Spans="{x:Bind Text}" Style="{StaticResource CorvidBodyText}" />
            <TextBlock Text="{x:Bind Evidence}" Style="{StaticResource CorvidSmallText}" />
            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ui:Ui.VisibleIf(ShowsActions), Mode=OneWay}">
              <controls:CorvidButton Content="Approve" Variant="Primary" Style="{StaticResource CorvidSmallButton}" Command="{x:Bind ApproveCommand}" />
              <controls:CorvidButton Content="Approve, superseding…" Style="{StaticResource CorvidSmallButton}" Command="{x:Bind StartSupersedingCommand}" />
              <controls:CorvidButton Content="Reject with a reason…" Variant="Ghost" Foreground="{ThemeResource CorvidRed}" Style="{StaticResource CorvidSmallButton}"
                                     Command="{x:Bind StartRejectingCommand}" />
            </StackPanel>
            <StackPanel Spacing="6" Visibility="{x:Bind ui:Ui.VisibleIf(IsSuperseding), Mode=OneWay}">
              <TextBlock Text="Which approved lesson does it replace? The old one is kept, marked superseded." Style="{StaticResource CorvidSmallText}" />
              <ItemsControl ItemsSource="{x:Bind Supersedable}" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="memory:SupersedeChoice">
                    <Grid>
                      <Border CornerRadius="6" Background="{ThemeResource CorvidAccentBg}" Visibility="{x:Bind ui:Ui.VisibleIf(IsSelected), Mode=OneWay}" />
                      <Button Style="{StaticResource MemRowButton}" Command="{x:Bind ChooseCommand}" AutomationProperties.Name="{x:Bind AutomationName}">
                        <StackPanel Spacing="1">
                          <TextBlock Text="{x:Bind Text}" Style="{StaticResource CorvidBodyText}" />
                          <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CorvidSmallText}" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:CorvidButton Content="Approve, superseding" Variant="Primary" Style="{StaticResource CorvidSmallButton}"
                                       Command="{x:Bind ConfirmSupersedeCommand}" />
                <controls:CorvidButton Content="Back" Variant="Ghost" Style="{StaticResource CorvidSmallButton}" Command="{x:Bind BackCommand}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Spacing="6" Visibility="{x:Bind ui:Ui.VisibleIf(IsRejecting), Mode=OneWay}">
              <TextBox Text="{x:Bind Reason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MemTextBox}"
                       PlaceholderText="Why not? Kept with the lesson so it is not drawn again" AcceptsReturn="False"
                       PreviewKeyDown="OnReasonKeyDown" Loaded="OnEditorLoaded" AutomationProperties.Name="Reason for rejecting the lesson" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:CorvidButton Content="Reject" Foreground="{ThemeResource CorvidRed}" Style="{StaticResource CorvidSmallButton}"
                                       Command="{x:Bind ConfirmRejectCommand}" />
                <controls:CorvidButton Content="Back" Variant="Ghost" Style="{StaticResource CorvidSmallButton}" Command="{x:Bind BackCommand}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- A block's meter (Core blocks panel): the name in mono and its count, the meter, the line under it. -->
    <DataTemplate x:Key="BlockMeter" x:DataType="memory:CoreBlockView">
      <StackPanel AutomationProperties.Name="{x:Bind AutomationName}">
        <Grid Margin="0,0,0,6">
          <TextBlock Text="{x:Bind Name}" Style="{StaticResource MemSectTitle}" FontFamily="{StaticResource CorvidMono}" FontWeight="Medium" />
          <TextBlock Text="{x:Bind CountText}" Style="{StaticResource MemSectDetail}" />
        </Grid>
        <controls:Meter Fraction="{x:Bind Fraction}" IsWarning="{x:Bind IsNearBudget}" />
        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CorvidSmallText}" Margin="0,4,0,0" />
      </StackPanel>
    </DataTemplate>

    <!-- A .table row: fact, valid, recorded; invalidated facts muted with their tag. -->
    <DataTemplate x:Key="FactRow" x:DataType="memory:FactRowView">
      <Grid BorderBrush="{ThemeResource CorvidLine}" BorderThickness="0,1,0,0" AutomationProperties.Name="{x:Bind AutomationName}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2.1*" />
          <ColumnDefinition Width="1.1*" />
          <ColumnDefinition Width="0.7*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{x:Bind Text}" Style="{StaticResource MemCell}" Padding="10,7" Visibility="{x:Bind ui:Ui.VisibleIf(IsCurrent)}" />
        <Border Padding="10,7" Visibility="{x:Bind ui:Ui.VisibleIf(IsInvalidated)}">
          <controls:WrapRowPanel Spacing="4" LineSpacing="2">
            <TextBlock Text="{x:Bind Text}" Style="{StaticResource MemMutedCell}" />
            <controls:TagChip Text="invalidated" />
          </controls:WrapRowPanel>
        </Border>
        <TextBlock Grid.Column="1" Text="{x:Bind local:MemoryPage.Breakable(ValidText)}" Style="{StaticResource MemCell}" Padding="10,7" />
        <TextBlock Grid.Column="2" Text="{x:Bind local:MemoryPage.Breakable(RecordedText)}" Style="{StaticResource MemMutedCell}" Padding="10,7" />
      </Grid>
    </DataTemplate>

    <!-- The Hermes import: the note, Dry run and Import for review, then the dry run's list before anything is staged. -->
    <DataTemplate x:Key="ImportPanel" x:DataType="memory:MemoryViewModel">
      <Border Style="{StaticResource CorvidPanel}">
        <StackPanel>
          <Border Style="{StaticResource MemPanelHead}">
            <local:MemoryHeadPanel>
              <TextBlock Text="{x:Bind ImportTitle, Mode=OneWay}" Style="{StaticResource MemHeadTitle}" AutomationProperties.HeadingLevel="Level2" />
              <TextBlock Text="{x:Bind ImportPath, Mode=OneWay}" Style="{StaticResource MemHeadDetail}" />
            </local:MemoryHeadPanel>
          </Border>
          <StackPanel Padding="14,12" Spacing="8">
            <TextBlock Text="{x:Bind ImportNote, Mode=OneWay}" Style="{StaticResource CorvidSmallText}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <controls:CorvidButton Content="Dry run" Style="{StaticResource CorvidSmallButton}" Command="{x:Bind DryRunCommand}" />
              <controls:CorvidButton Content="Import for review" Variant="Ghost" Style="{StaticResource CorvidSmallButton}" Command="{x:Bind ImportForReviewCommand}"
                                     ToolTipService.ToolTip="Lists every entry first; nothing is staged until you confirm" />
            </StackPanel>
            <StackPanel Spacing="8" Visibility="{x:Bind ui:Ui.VisibleIf(HasPreview), Mode=OneWay}">
              <TextBlock Text="{x:Bind PreviewSummary, Mode=OneWay}" Style="{StaticResource MemSectTitle}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{x:Bind ImportEntries}" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="memory:ImportEntryView">
                    <Grid Padding="0,5" ColumnSpacing="8" BorderBrush="{ThemeResource CorvidLine}" BorderThickness="0,0,0,1"
                          AutomationProperties.Name="{x:Bind AutomationName}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Spacing="1">
                        <TextBlock Text="{x:Bind Text}" Style="{StaticResource MemCell}" />
                        <TextBlock Style="{StaticResource CorvidSmallText}">
                          <Run Text="{x:Bind File}" FontFamily="{StaticResource CorvidMono}" />
                          <Run Text="{x:Bind local:MemoryPage.Dotted(Reason)}" />
                        </TextBlock>
                      </StackPanel>
                      <controls:TagChip Grid.Column="1" Text="{x:Bind Verdict}" Tone="{x:Bind VerdictTone}" VerticalAlignment="Top" Margin="0,1,0,0" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:CorvidButton Content="{x:Bind StageLabel, Mode=OneWay}" Variant="Primary" Style="{StaticResource CorvidSmallButton}"
                                       Command="{x:Bind StageImportCommand}" />
                <controls:CorvidButton Content="Cancel" Variant="Ghost" Style="{StaticResource CorvidSmallButton}" Command="{x:Bind CancelImportCommand}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- The facts table: head row, then the rows. -->
    <DataTemplate x:Key="FactsHeader" x:DataType="x:String">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2.1*" />
          <ColumnDefinition Width="1.1*" />
          <ColumnDefinition Width="0.7*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="fact" Style="{StaticResource MemTh}" />
        <TextBlock Grid.Column="1" Text="valid" Style="{StaticResource MemTh}" />
        <TextBlock Grid.Column="2" Text="recorded" Style="{StaticResource MemTh}" />
      </Grid>
    </DataTemplate>
  </Page.Resources>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- .page-head: the title and the tabs 12 apart, the search on the right; wraps when narrow. -->
    <Border x:Name="Head" Style="{StaticResource CorvidPageHead}" MinHeight="53">
      <controls:WrapRowPanel Spacing="12" LineSpacing="8" PushLastRight="True" VerticalAlignment="Center">
        <TextBlock x:Name="PageTitle" Text="{x:Bind ViewModel.Title}" Style="{StaticResource CorvidPageTitle}" VerticalAlignment="Center"
                   AutomationProperties.HeadingLevel="Level1" />
        <ItemsControl ItemsSource="{x:Bind ViewModel.Tabs}" IsTabStop="False" VerticalAlignment="Center" AutomationProperties.Name="Memory views">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <controls:WrapRowPanel Spacing="2" LineSpacing="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="memory:MemoryTab">
              <controls:DockTab Label="{x:Bind Label}" Badge="{x:Bind BadgeText, Mode=OneWay}" IsSelected="{x:Bind IsSelected, Mode=OneWay}"
                                Command="{x:Bind Open}" AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBox x:Name="SearchBox" Width="300" Height="28" MinHeight="28" Padding="8,3,8,3" FontSize="13.5" CornerRadius="6"
                 VerticalAlignment="Center" PlaceholderText="Search facts, episodes and blocks…"
                 Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 BorderBrush="{ThemeResource CorvidLine}" PreviewKeyDown="OnSearchKeyDown" AutomationProperties.Name="Search memory" />
      </controls:WrapRowPanel>
    </Border>

    <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid x:Name="Body" Padding="24,18" ColumnSpacing="18" RowSpacing="14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="LeftColumn" Width="1.4*" />
          <ColumnDefinition x:Name="RightColumn" Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The review queue. -->
        <StackPanel x:Name="ReviewColumn" Spacing="14" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.IsReviewTab), Mode=OneWay}">
          <TextBlock Text="{x:Bind ViewModel.IntroText}" Style="{StaticResource CorvidSmallText}" />
          <controls:ToneRow Tone="{x:Bind ViewModel.OutcomeTone, Mode=OneWay}" Padding="12,8" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasOutcome), Mode=OneWay}">
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Bind ViewModel.Outcome, Mode=OneWay}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" />
              <controls:IconButton Grid.Column="1" Icon="Check" Width="22" Height="22" Command="{x:Bind ViewModel.DismissOutcomeCommand}"
                                   AutomationProperties.Name="Dismiss" ToolTipService.ToolTip="Dismiss" />
            </Grid>
          </controls:ToneRow>
          <TextBlock Text="{x:Bind ViewModel.EmptyReviewText}" Style="{StaticResource CorvidMutedText}"
                     Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasNothingToReview), Mode=OneWay}" />
          <ItemsControl ItemsSource="{x:Bind ViewModel.StagedFacts}" ItemTemplate="{StaticResource FactCard}" IsTabStop="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="14" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <ItemsControl ItemsSource="{x:Bind ViewModel.BlockUpdates}" ItemTemplate="{StaticResource BlockCard}" IsTabStop="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="14" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <ItemsControl ItemsSource="{x:Bind ViewModel.LessonCandidates}" ItemTemplate="{StaticResource LessonCard}" IsTabStop="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="14" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>

        <!-- Beside the queue: the core blocks, the recent facts, the import. -->
        <StackPanel x:Name="SideColumn" Grid.Column="1" Spacing="14" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.IsReviewTab), Mode=OneWay}">
          <Border Style="{StaticResource CorvidPanel}">
            <StackPanel>
              <Border Style="{StaticResource MemPanelHead}">
                <local:MemoryHeadPanel>
                  <TextBlock Text="Core blocks" Style="{StaticResource MemHeadTitle}" AutomationProperties.HeadingLevel="Level2" />
                  <TextBlock Text="counted with the generator's tokenizer" Style="{StaticResource MemHeadDetail}" />
                </local:MemoryHeadPanel>
              </Border>
              <StackPanel Padding="14,12" Spacing="12">
                <ItemsControl ItemsSource="{x:Bind ViewModel.CoreBlocks}" ItemTemplate="{StaticResource BlockMeter}" IsTabStop="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="12" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
                <controls:CorvidButton Content="Edit blocks…" Style="{StaticResource CorvidSmallButton}" HorizontalAlignment="Left"
                                       Command="{x:Bind ViewModel.EditBlocksCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CorvidPanel}">
            <StackPanel>
              <Border Style="{StaticResource MemPanelHead}">
                <local:MemoryHeadPanel>
                  <TextBlock Text="Facts · recent" Style="{StaticResource MemHeadTitle}" AutomationProperties.HeadingLevel="Level2" />
                  <TextBlock Text="bi-temporal" Style="{StaticResource MemHeadDetail}" />
                </local:MemoryHeadPanel>
              </Border>
              <ContentControl ContentTemplate="{StaticResource FactsHeader}" Content="fact" HorizontalContentAlignment="Stretch" IsTabStop="False" />
              <ItemsControl ItemsSource="{x:Bind ViewModel.RecentFacts}" ItemTemplate="{StaticResource FactRow}" IsTabStop="False"
                            AutomationProperties.Name="Recent facts" />
            </StackPanel>
          </Border>

          <ContentControl Content="{x:Bind ViewModel}" ContentTemplate="{StaticResource ImportPanel}" HorizontalContentAlignment="Stretch" IsTabStop="False" />
        </StackPanel>

        <!-- Facts: every fact, or what the search matched. -->
        <Border Grid.ColumnSpan="2" Style="{StaticResource CorvidPanel}" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.IsFactsTab), Mode=OneWay}">
          <StackPanel>
            <Border Style="{StaticResource MemPanelHead}">
              <local:MemoryHeadPanel>
                <TextBlock Text="Facts" Style="{StaticResource MemHeadTitle}" AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Text="{x:Bind ViewModel.FactsSummary, Mode=OneWay}" Style="{StaticResource MemHeadDetail}" />
              </local:MemoryHeadPanel>
            </Border>
            <controls:LinkButton Text="Clear the search" FontSize="12.5" Margin="14,8,14,0" Command="{x:Bind ViewModel.ClearSearchCommand}"
                                 Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.IsFiltered), Mode=OneWay}" HorizontalAlignment="Left" />
            <ContentControl ContentTemplate="{StaticResource FactsHeader}" Content="fact" HorizontalContentAlignment="Stretch" IsTabStop="False" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Facts}" ItemTemplate="{StaticResource FactRow}" IsTabStop="False" AutomationProperties.Name="Facts" />
            <TextBlock Text="No fact matches. Try fewer words." Style="{StaticResource CorvidMutedText}" Margin="14,10"
                       Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasNoFacts), Mode=OneWay}" />
          </StackPanel>
        </Border>

        <!-- Core blocks: each block's meter and text. -->
        <ItemsControl Grid.ColumnSpan="2" ItemsSource="{x:Bind ViewModel.CoreBlocks}" IsTabStop="False" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.IsBlocksTab), Mode=OneWay}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="14" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="memory:CoreBlockView">
              <Border Style="{StaticResource CorvidPanel}">
                <StackPanel Padding="14,12" Spacing="10">
                  <ContentControl Content="{x:Bind}" ContentTemplate="{StaticResource BlockMeter}" HorizontalContentAlignment="Stretch" IsTabStop="False" />
                  <controls:WrapRowPanel Spacing="10" LineSpacing="4" Visibility="{x:Bind ui:Ui.VisibleIf(ShowsConsolidationOffer)}">
                    <TextBlock Text="{x:Bind ConsolidationOffer}" FontSize="12.5" Foreground="{ThemeResource CorvidAmber}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <controls:LinkButton Text="Consolidate in Review" FontSize="12.5" Command="{x:Bind OpenReview}" VerticalAlignment="Center"
                                         Visibility="{x:Bind ui:Ui.VisibleIf(CanOpenReview)}" />
                  </controls:WrapRowPanel>
                  <Border Background="{ThemeResource CorvidCodeBg}" CornerRadius="6" Padding="10,8">
                    <TextBlock Text="{x:Bind Text}" Style="{StaticResource CorvidBodyText}" IsTextSelectionEnabled="True" />
                  </Border>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Lessons: the candidates, then the approved lessons. -->
        <StackPanel Grid.ColumnSpan="2" Spacing="14" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.IsLessonsTab), Mode=OneWay}">
          <TextBlock Text="Lessons waiting for review" Style="{StaticResource MemSectTitle}" AutomationProperties.HeadingLevel="Level2" />
          <TextBlock Text="No lesson waits for review." Style="{StaticResource CorvidMutedText}" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasNoLessonCandidates), Mode=OneWay}" />
          <ItemsControl ItemsSource="{x:Bind ViewModel.LessonCandidates}" ItemTemplate="{StaticResource LessonCard}" IsTabStop="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="14" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <Border Style="{StaticResource CorvidPanel}">
            <StackPanel>
              <Border Style="{StaticResource MemPanelHead}">
                <local:MemoryHeadPanel>
                  <TextBlock Text="Approved lessons" Style="{StaticResource MemHeadTitle}" AutomationProperties.HeadingLevel="Level2" />
                  <TextBlock Text="applied by project" Style="{StaticResource MemHeadDetail}" />
                </local:MemoryHeadPanel>
              </Border>
              <ItemsControl ItemsSource="{x:Bind ViewModel.Lessons}" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="memory:LessonRowView">
                    <StackPanel Padding="14,8" Spacing="2" BorderBrush="{ThemeResource CorvidLine}" BorderThickness="0,0,0,1">
                      <TextBlock local:MemorySpans.Spans="{x:Bind Text}" Style="{StaticResource CorvidBodyText}" />
                      <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CorvidSmallText}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Import: the panel at full width. -->
        <ContentControl Grid.ColumnSpan="2" Content="{x:Bind ViewModel}" ContentTemplate="{StaticResource ImportPanel}" HorizontalContentAlignment="Stretch"
                        IsTabStop="False" MaxWidth="820" HorizontalAlignment="Left" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.IsImportTab), Mode=OneWay}" />
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>

<Page x:Class="Corvid.App.Pages.ReviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Corvid.App.Controls"
      xmlns:review="using:Corvid.App.Core.Review"
      xmlns:local="using:Corvid.App.Pages"
      xmlns:ui="using:Corvid.App.Infrastructure"
      Background="{ThemeResource CorvidBg}"
      Foreground="{ThemeResource CorvidText}"
      FontSize="13.5">
  <!--
    Review.dc.html: the page head (title, the session, the scope picker; the review point and the two view buttons), then
    a 300 px Files panel beside the diff with its actions. Under 720 px the panel goes above the diff.
  -->
  <Page.Resources>
    <!-- .panel-head: 10px 14px, a line below, semibold; the detail muted on the right. -->
    <Style x:Key="PanelHead" TargetType="Border">
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="BorderBrush" Value="{ThemeResource CorvidLine}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <!-- 10 + the 19.6 px line box + 10 + the line: CSS centres the one line in it. -->
      <Setter Property="MinHeight" Value="40.6" />
    </Style>
    <Style x:Key="PanelHeadDetail" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{ThemeResource CorvidText2}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- .files li as a button: 5px 8px, radius 6, bg-3 while hovered. -->
    <Style x:Key="FileRowButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="UseSystemFocusVisuals" Value="True" />
      <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource CorvidAccent}" />
      <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource CorvidBg}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Root" CornerRadius="6" Background="Transparent">
              <Border x:Name="Film" Background="{ThemeResource CorvidBg3}" Visibility="Collapsed" />
              <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                      <Setter Target="Film.Visibility" Value="Visible" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                      <Setter Target="Film.Visibility" Value="Visible" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Disabled" />
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="FileRow" x:DataType="review:ReviewFileView">
      <Grid>
        <Border CornerRadius="6" Background="{ThemeResource CorvidAccentBg}" Visibility="{x:Bind ui:Ui.VisibleIf(IsSelected), Mode=OneWay}" />
        <Button Style="{StaticResource FileRowButton}" Command="{x:Bind Select}" AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
          <!-- The row's line box is the mono path's 18.1 px, so rows are 28.1 apart as in Review.png. -->
          <Grid ColumnSpacing="10" MinHeight="18.1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:PathText Path="{x:Bind Path}" Foreground="{ThemeResource CorvidText}" VerticalAlignment="Center"
                               Visibility="{x:Bind ui:Ui.VisibleIf(IsReadable)}" />
            <controls:PathText Path="{x:Bind Path}" Foreground="{ThemeResource CorvidText2}" VerticalAlignment="Center"
                               Visibility="{x:Bind ui:Ui.CollapsedIf(IsReadable)}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                        Visibility="{x:Bind ui:Ui.VisibleIf(ShowCounts)}">
              <TextBlock Text="{x:Bind AddedText}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource CorvidGreen}" />
              <TextBlock Text="{x:Bind RemovedText}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource CorvidRed}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{x:Bind Note}" FontSize="12" Foreground="{ThemeResource CorvidText2}" VerticalAlignment="Center"
                       TextWrapping="NoWrap" Visibility="{x:Bind ui:Ui.CollapsedIf(ShowCounts)}" />
          </Grid>
        </Button>
      </Grid>
    </DataTemplate>
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- .page-head: the two groups spread apart, wrapping onto two lines when they do not fit. -->
    <Border x:Name="Head" Style="{StaticResource CorvidPageHead}">
      <controls:WrapRowPanel Spacing="12" LineSpacing="12" PushLastRight="True" VerticalAlignment="Center">
        <controls:WrapRowPanel Spacing="12" LineSpacing="8" VerticalAlignment="Center">
          <TextBlock Text="{x:Bind ViewModel.Title}" Style="{StaticResource CorvidPageTitle}" VerticalAlignment="Center"
                     AutomationProperties.HeadingLevel="Level1" />
          <TextBlock x:Name="SessionText" Text="{x:Bind ViewModel.SessionTitle, Mode=OneWay}" Style="{StaticResource CorvidMutedText}" TextWrapping="NoWrap"
                     VerticalAlignment="Center" />
          <ComboBox x:Name="ScopePicker" ItemsSource="{x:Bind ViewModel.Scopes}" SelectedIndex="{x:Bind ViewModel.ScopeIndex, Mode=TwoWay}"
                    AutomationProperties.Name="Changes to review" VerticalAlignment="Center" MinHeight="28" Height="28" Padding="8,0,0,0"
                    CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CorvidLine}" Background="{ThemeResource CorvidBg}"
                    Foreground="{ThemeResource CorvidText}" FontSize="13.5">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="review:ReviewScopeOption">
                <TextBlock Text="{x:Bind Label, Mode=OneWay}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </controls:WrapRowPanel>
        <controls:WrapRowPanel Spacing="8" LineSpacing="8" VerticalAlignment="Center">
          <TextBlock Text="{x:Bind ViewModel.ReviewPointText, Mode=OneWay}" Style="{StaticResource CorvidSmallText}" TextWrapping="NoWrap"
                     VerticalAlignment="Center" Visibility="{x:Bind ui:Ui.VisibleIfText(ViewModel.ReviewPointText), Mode=OneWay}" />
          <controls:CorvidButton Content="Unified" Variant="{x:Bind local:ReviewPage.Pressed(ViewModel.IsUnified), Mode=OneWay}"
                                 Command="{x:Bind ViewModel.ShowUnifiedCommand}" AutomationProperties.Name="Unified view" />
          <controls:CorvidButton Content="Side by side" Variant="{x:Bind local:ReviewPage.Pressed(ViewModel.IsSideBySide), Mode=OneWay}"
                                 Command="{x:Bind ViewModel.ShowSideBySideCommand}" AutomationProperties.Name="Side by side view" />
        </controls:WrapRowPanel>
      </controls:WrapRowPanel>
    </Border>

    <ScrollViewer x:Name="BodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid x:Name="Body" Padding="24,18,24,18" ColumnSpacing="18" RowSpacing="18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="FilesColumn" Width="300" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The Files panel. -->
        <Border x:Name="FilesPanel" Style="{StaticResource CorvidPanel}" VerticalAlignment="Top">
          <StackPanel>
            <Border Style="{StaticResource PanelHead}">
              <Grid ColumnSpacing="10" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Files" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.FilesSummary, Mode=OneWay}" Style="{StaticResource PanelHeadDetail}" />
              </Grid>
            </Border>
            <ItemsControl ItemsSource="{x:Bind ViewModel.Files}" ItemTemplate="{StaticResource FileRow}" Padding="6" IsTabStop="False"
                          AutomationProperties.Name="Changed files" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasFiles), Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" Style="{StaticResource CorvidSmallText}" Margin="14,12"
                       Visibility="{x:Bind ui:Ui.CollapsedIf(ViewModel.HasFiles), Mode=OneWay}" />
            <Border Padding="14,12" BorderBrush="{ThemeResource CorvidLine}" BorderThickness="0,1,0,0">
              <StackPanel Spacing="8">
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Checkpoints in range" FontSize="12.5" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CheckpointRange, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold"
                             Foreground="{ThemeResource CorvidText2}" />
                </Grid>
                <TextBlock Text="Every file here is restorable from its checkpoint; a restore merges three ways with your own edits."
                           Style="{StaticResource CorvidSmallText}" />
                <controls:CorvidButton Content="Open Rewind" Style="{StaticResource CorvidSmallButton}" Foreground="{ThemeResource CorvidAccent}"
                                       HorizontalAlignment="Left" Command="{x:Bind ViewModel.OpenRewindCommand}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- The diff, then its actions. -->
        <StackPanel x:Name="DiffArea" Grid.Column="1" Spacing="12" MinWidth="0">
          <Border CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CorvidLine}" Background="{ThemeResource CorvidBg}"
                  Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasSelection), Mode=OneWay}">
            <StackPanel>
              <!-- .diff-head: 8px 12px on bg-2, a line below, 12.5 px. -->
              <Border Padding="12,8" Background="{ThemeResource CorvidBg2}" BorderBrush="{ThemeResource CorvidLine}" BorderThickness="0,0,0,1"
                      CornerRadius="7,7,0,0">
                <Grid ColumnSpacing="10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <controls:PathText Path="{x:Bind ViewModel.DiffPath, Mode=OneWay}" Foreground="{ThemeResource CorvidText}" VerticalAlignment="Center" />
                  <controls:WrapRowPanel Grid.Column="1" Spacing="6" LineSpacing="2" VerticalAlignment="Center">
                    <controls:TagChip Text="{x:Bind ViewModel.ReversibleText, Mode=OneWay}" Tone="Green" VerticalAlignment="Center"
                                      Visibility="{x:Bind ui:Ui.VisibleIfText(ViewModel.ReversibleText), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.DiffSource, Mode=OneWay}" FontSize="12.5" Foreground="{ThemeResource CorvidText2}"
                               VerticalAlignment="Center" TextWrapping="NoWrap" />
                  </controls:WrapRowPanel>
                </Grid>
              </Border>
              <controls:SideBySideDiffView x:Name="Diff" Rows="{x:Bind ViewModel.SideRows, Mode=OneWay}" UnifiedRows="{x:Bind ViewModel.UnifiedRows, Mode=OneWay}"
                                           IsUnified="{x:Bind ViewModel.IsUnified, Mode=OneWay}" Comments="{x:Bind ViewModel.FileComments}"
                                           Editor="{x:Bind ViewModel.Editor, Mode=OneWay}" LineCommand="{x:Bind ViewModel.CommentOnLineCommand}"
                                           Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasDiff), Mode=OneWay}" />
              <TextBlock Text="{x:Bind ViewModel.NoDiffText, Mode=OneWay}" Style="{StaticResource CorvidSmallText}" Margin="12,12"
                         Visibility="{x:Bind ui:Ui.CollapsedIf(ViewModel.HasDiff), Mode=OneWay}" />
            </StackPanel>
          </Border>

          <controls:WrapRowPanel Spacing="8" LineSpacing="8">
            <controls:CorvidButton x:Name="SendButton" Content="{x:Bind ViewModel.SendCommentsText, Mode=OneWay}" Variant="Primary"
                                   Command="{x:Bind ViewModel.SendCommentsCommand}" />
            <controls:CorvidButton Content="Ask about this file" Command="{x:Bind ViewModel.AskAboutFileCommand}"
                                   Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasSelection), Mode=OneWay}" />
            <controls:CorvidButton Content="Open in editor" Command="{x:Bind ViewModel.OpenInEditorCommand}"
                                   Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasSelection), Mode=OneWay}" />
            <controls:CorvidButton Content="{x:Bind ViewModel.RevertText, Mode=OneWay}" Variant="Ghost" Foreground="{ThemeResource CorvidRed}"
                                   Command="{x:Bind ViewModel.RevertFileCommand}" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasSelection), Mode=OneWay}" />
          </controls:WrapRowPanel>
          <TextBlock Text="Comments go out as one message, quoting file and line. The next turn's diff shows against this review point."
                     Style="{StaticResource CorvidSmallText}" HorizontalAlignment="Right" TextAlignment="Right" Margin="0,-4,0,0" />
          <controls:ToneRow Tone="{x:Bind ViewModel.NoticeTone, Mode=OneWay}" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasNotice), Mode=OneWay}">
            <TextBlock Text="{x:Bind ViewModel.Notice, Mode=OneWay}" TextWrapping="Wrap" />
          </controls:ToneRow>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    The Models page's and the first run's parts, from corvid.css: .panel-head, .table th and td, .kv, .target, .radio. Kept
    beside the two pages (merged into each page's resources) rather than in Themes, which every area shares.
  -->

  <!-- .panel-head: 10px 14px, a line below, semibold; the note after the title is .muted.small and inherits the weight. -->
  <Style x:Key="PanelHead" TargetType="Border">
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="BorderBrush" Value="{ThemeResource CorvidLine}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <!-- One line centred in the CSS's 19.575 px line box: Inter's natural 1.21 em plus half the leading above and below. -->
  <Style x:Key="PanelTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="0,1.62" />
    <Setter Property="Foreground" Value="{ThemeResource CorvidText}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="PanelNote" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="0,1.44" />
    <Setter Property="Foreground" Value="{ThemeResource CorvidText2}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- .table th: 12.5 px semibold text-2, 6px 10px. -->
  <Style x:Key="TableHead" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource CorvidText2}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="Margin" Value="10,7.5" />
  </Style>

  <!-- .table td: 12.5 px with the 1.45 line height. -->
  <Style x:Key="Cell" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="LineHeight" Value="18.125" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="Foreground" Value="{ThemeResource CorvidText}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="CellMuted" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
    <Setter Property="Foreground" Value="{ThemeResource CorvidText2}" />
  </Style>

  <Style x:Key="CellMono" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
    <Setter Property="FontFamily" Value="{StaticResource CorvidMono}" />
  </Style>

  <!-- .muted.small inside a cell: 12 px, line 17.4. -->
  <Style x:Key="CellSmall" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="17.4" />
    <Setter Property="Foreground" Value="{ThemeResource CorvidText2}" />
  </Style>

  <!-- A table row: a line above (the header's or the previous row's bottom border), cells padded 7px 10px. -->
  <Style x:Key="TableRow" TargetType="Border">
    <Setter Property="BorderBrush" Value="{ThemeResource CorvidLine}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>

  <!-- .kv .k: 12.5 px text-2, at least 64 wide; .kv's value: 12.5 px text. -->
  <Style x:Key="KvKey" TargetType="TextBlock" BasedOn="{StaticResource CellMuted}">
    <Setter Property="MinWidth" Value="64" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <!-- Body text in a panel: 13.5 px with the 1.45 line height. -->
  <Style x:Key="PanelText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="LineHeight" Value="19.575" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="Foreground" Value="{ThemeResource CorvidText}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="PanelSmall" TargetType="TextBlock" BasedOn="{StaticResource PanelText}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="17.4" />
    <Setter Property="Foreground" Value="{ThemeResource CorvidText2}" />
  </Style>

  <!-- .target: a ladder step, 20 high, 0 7px, radius 5, bg-3, 12 px. -->
  <Style x:Key="LadderChip" TargetType="Button">
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="{ThemeResource CorvidBg3}" />
    <Setter Property="Foreground" Value="{ThemeResource CorvidText}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource CorvidAccent}" />
    <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource CorvidBg}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Face.Background" Value="{ThemeResource CorvidLine}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Face.Background" Value="{ThemeResource CorvidLine}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    .radio with a check box: the browser's 13 px box, 3 px down, 8 px from its label; checked in the accent with a white
    tick; a checked box that cannot change (a cached model) in the line colour.
  -->
  <Style x:Key="SetupCheckBox" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{ThemeResource CorvidText}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource CorvidAccent}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="13" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Box" Width="13" Height="13" Margin="0,3,0,0" VerticalAlignment="Top" CornerRadius="2.5" BorderThickness="1"
                    BorderBrush="{ThemeResource CorvidText2}" Background="{ThemeResource CorvidBg}">
              <Path x:Name="Tick" Data="M 2.2 5.6 L 4.6 8 L 8.9 3.3" Stroke="{ThemeResource CorvidOnAccent}" StrokeThickness="1.6"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0" />
            </Border>
            <ContentPresenter x:Name="Presenter" Grid.Column="1" Content="{TemplateBinding Content}"
                              HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CombinedStates">
                <VisualState x:Name="UncheckedNormal" />
                <VisualState x:Name="UncheckedPointerOver">
                  <VisualState.Setters>
                    <Setter Target="Box.BorderBrush" Value="{ThemeResource CorvidText}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="UncheckedPressed" />
                <VisualState x:Name="UncheckedDisabled">
                  <VisualState.Setters>
                    <Setter Target="Box.Opacity" Value="0.5" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedNormal">
                  <VisualState.Setters>
                    <Setter Target="Box.Background" Value="{ThemeResource CorvidAccent}" />
                    <Setter Target="Box.BorderBrush" Value="{ThemeResource CorvidAccent}" />
                    <Setter Target="Tick.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPointerOver">
                  <VisualState.Setters>
                    <Setter Target="Box.Background" Value="{ThemeResource CorvidAccent}" />
                    <Setter Target="Box.BorderBrush" Value="{ThemeResource CorvidAccent}" />
                    <Setter Target="Tick.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPressed">
                  <VisualState.Setters>
                    <Setter Target="Box.Background" Value="{ThemeResource CorvidAccent}" />
                    <Setter Target="Box.BorderBrush" Value="{ThemeResource CorvidAccent}" />
                    <Setter Target="Tick.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedDisabled">
                  <VisualState.Setters>
                    <Setter Target="Box.Background" Value="{ThemeResource CorvidLine}" />
                    <Setter Target="Box.BorderBrush" Value="{ThemeResource CorvidLine}" />
                    <Setter Target="Tick.Stroke" Value="{ThemeResource CorvidText2}" />
                    <Setter Target="Tick.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="IndeterminateNormal" />
                <VisualState x:Name="IndeterminatePointerOver" />
                <VisualState x:Name="IndeterminatePressed" />
                <VisualState x:Name="IndeterminateDisabled" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- .radio with a radio button: the browser's 13 px circle; checked, an accent ring around an accent dot. -->
  <Style x:Key="SetupRadio" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{ThemeResource CorvidText}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource CorvidAccent}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="13" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="13" Height="13" Margin="0,3,0,0" VerticalAlignment="Top">
              <Ellipse x:Name="Ring" Stroke="{ThemeResource CorvidText2}" StrokeThickness="1" Fill="{ThemeResource CorvidBg}" />
              <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{ThemeResource CorvidAccent}" Opacity="0" />
            </Grid>
            <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Ring.Stroke" Value="{ThemeResource CorvidText}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed" />
                <VisualState x:Name="Disabled" />
              </VisualStateGroup>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Indeterminate" />
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Ring.Stroke" Value="{ThemeResource CorvidAccent}" />
                    <Setter Target="Ring.StrokeThickness" Value="1.5" />
                    <Setter Target="Dot.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The picker over the page: a card on bg with a line border and a shadowless lift, 12px 14px. -->
  <Style x:Key="PickerCard" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CorvidBg}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CorvidLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,12" />
  </Style>

  <!-- A row of a picker: the whole row is the button, 8px 10px, radius 6, bg-2 on hover; dimmed when it cannot be chosen. -->
  <Style x:Key="PickerRow" TargetType="Button">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource CorvidAccent}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Face" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Face.Background" Value="{ThemeResource CorvidBg2}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Face.Background" Value="{ThemeResource CorvidBg3}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Face.Opacity" Value="0.6" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A text box as the first run's workspace field: mono, 6px 10px, a line border, radius 6. -->
  <Style x:Key="FieldBox" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource CorvidMono}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{ThemeResource CorvidText}" />
    <Setter Property="Background" Value="{ThemeResource CorvidBg}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CorvidLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="32" />
  </Style>
</ResourceDictionary>

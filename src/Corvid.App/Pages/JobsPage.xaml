<Page x:Class="Corvid.App.Pages.JobsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Corvid.App.Controls"
      xmlns:jobs="using:Corvid.App.Core.Jobs"
      xmlns:models="using:Corvid.App.Core.Models"
      xmlns:coreshell="using:Corvid.App.Core.Shell"
      xmlns:mvvm="using:Corvid.App.Core.Mvvm"
      xmlns:local="using:Corvid.App.Pages"
      xmlns:ui="using:Corvid.App.Infrastructure"
      Background="{ThemeResource CorvidBg}"
      Foreground="{ThemeResource CorvidText}"
      FontSize="13.5">
  <!--
    The Jobs area (docs/plan/ui.md §4.10, F13, F23; no mockup: drawn in the mocked pages' language, corvid.css's .page-head,
    .panel, .table, .kv, .tag and .btn). The head with the scheduler line and New job…; the form, when open, above two
    columns (1.4fr and 1fr): Scheduled and the selected job's Runs on the left, the job's detail and the Scheduler on the
    right. Up and Down move between jobs, Enter opens the focused row, Esc closes the remove question or the form.
  -->
  <Page.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Pages/ModelsStyles.xaml" />
        <ResourceDictionary Source="ms-appx:///Pages/OpsStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <DataTemplate x:Key="FactTemplate" x:DataType="models:ModelFact">
        <controls:WrapRowPanel Spacing="8" LineSpacing="4" AutomationProperties.Name="{x:Bind AutomationName}">
          <TextBlock Text="{x:Bind Key}" Style="{StaticResource KvKey}" MinWidth="78" LineHeight="18" />
          <TextBlock local:SpanText.Runs="{x:Bind Value}" Style="{StaticResource Cell}" LineHeight="18" />
        </controls:WrapRowPanel>
      </DataTemplate>

      <DataTemplate x:Key="TagTemplate" x:DataType="coreshell:StatusTag">
        <controls:TagChip Text="{x:Bind Text}" Tone="{x:Bind Tone}" ToolTipService.ToolTip="{x:Bind Detail}" AutomationProperties.Name="{x:Bind Text}" />
      </DataTemplate>
    </ResourceDictionary>
  </Page.Resources>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border x:Name="HeadHost" Style="{StaticResource CorvidPageHead}">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:WrapRowPanel x:Name="HeadTitle" Spacing="12" LineSpacing="12" VerticalAlignment="Center">
          <TextBlock Text="{x:Bind ViewModel.Title}" Style="{StaticResource CorvidPageTitle}" VerticalAlignment="Center"
                     AutomationProperties.HeadingLevel="Level1" />
          <TextBlock local:SpanText.Runs="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Style="{StaticResource CorvidMutedText}" VerticalAlignment="Center" />
        </controls:WrapRowPanel>
        <StackPanel x:Name="HeadButtons" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <controls:CorvidButton Content="New job…" Variant="Primary" Command="{x:Bind ViewModel.NewJobCommand}"
                                 ToolTipService.ToolTip="Schedule a job: its schedule is previewed before anything is written" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer x:Name="BodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="Body" Padding="24,18,24,18" Spacing="18">
        <!-- What an action did, or why it did not (.toast). -->
        <controls:ToneRow Tone="{x:Bind ViewModel.NoticeTone, Mode=OneWay}" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasNotice), Mode=OneWay}"
                          AutomationProperties.LiveSetting="Polite">
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock local:SpanText.Runs="{x:Bind ViewModel.Notice, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center"
                       LineHeight="18.125" LineStackingStrategy="BlockLineHeight" />
            <controls:CorvidButton Grid.Column="1" Style="{StaticResource CorvidSmallButton}" Variant="Ghost" Content="Dismiss"
                                   Foreground="{ThemeResource CorvidText2}" Command="{x:Bind ViewModel.DismissNoticeCommand}" />
          </Grid>
        </controls:ToneRow>

        <!-- New job (G-13): the schedule previewed as "runs next at" before anything is written. -->
        <Border Style="{StaticResource CorvidPanel}" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.IsCreating), Mode=OneWay}">
          <StackPanel>
            <Border Style="{StaticResource PanelHead}">
              <controls:WrapRowPanel Spacing="10" LineSpacing="2" PushLastRight="True">
                <TextBlock Text="New job" Style="{StaticResource PanelTitle}" AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Text="runs in its own session · nothing is written until you create it" Style="{StaticResource PanelNote}" />
              </controls:WrapRowPanel>
            </Border>
            <Grid Padding="14,12" ColumnSpacing="12" RowSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Text="name" Style="{StaticResource OpsLabel}" Margin="0,8,0,0" />
              <TextBox x:Name="DraftNameBox" Grid.Column="1" Style="{StaticResource OpsField}" PlaceholderText="inbox-digest" MaxWidth="360" HorizontalAlignment="Left"
                       Width="360" Text="{x:Bind ViewModel.DraftName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Job name" />
              <TextBlock Grid.Row="1" Text="schedule" Style="{StaticResource OpsLabel}" Margin="0,8,0,0" />
              <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                <TextBox Style="{StaticResource FieldBox}" PlaceholderText="weekdays at 9am · in 30m · 0 9 * * 1-5 · 2026-10-25T09:00"
                         MaxWidth="460" HorizontalAlignment="Stretch"
                         Text="{x:Bind ViewModel.DraftSchedule, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Schedule" />
                <StackPanel Orientation="Horizontal" Spacing="6" AutomationProperties.LiveSetting="Polite">
                  <controls:Icon Kind="Check" Width="14" Height="14" Foreground="{ThemeResource CorvidGreen}" VerticalAlignment="Center"
                                 Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.PreviewOk), Mode=OneWay}" />
                  <controls:Icon Kind="Warning" Width="14" Height="14" Foreground="{ThemeResource CorvidText2}" VerticalAlignment="Center"
                                 Visibility="{x:Bind ui:Ui.CollapsedIf(ViewModel.PreviewOk), Mode=OneWay}" />
                  <TextBlock local:SpanText.Runs="{x:Bind ViewModel.PreviewText, Mode=OneWay}" Style="{StaticResource CellMuted}" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
              <TextBlock Grid.Row="2" Text="prompt" Style="{StaticResource OpsLabel}" Margin="0,8,0,0" />
              <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource OpsField}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
                       PlaceholderText="Summarise the inbox and list what needs an answer today."
                       IsEnabled="{x:Bind ViewModel.CanEditPrompt, Mode=OneWay}"
                       Text="{x:Bind ViewModel.DraftPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Prompt" />
              <TextBlock Grid.Row="3" Text="pre-run" Style="{StaticResource OpsLabel}" Margin="0,8,0,0" />
              <StackPanel Grid.Row="3" Grid.Column="1" Spacing="6">
                <TextBox Style="{StaticResource FieldBox}" PlaceholderText="scripts/fetch-inbox.sh (optional: its output goes into the prompt)"
                         MaxWidth="460" HorizontalAlignment="Stretch"
                         Text="{x:Bind ViewModel.DraftScript, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pre-run script" />
                <CheckBox Style="{StaticResource SetupCheckBox}" IsChecked="{x:Bind ViewModel.DraftNoAgent, Mode=TwoWay}"
                          AutomationProperties.Name="No agent: run only the script">
                  <TextBlock Text="no agent: run only the script, with no model turn" Style="{StaticResource Cell}" />
                </CheckBox>
              </StackPanel>
              <TextBlock Grid.Row="4" Text="deliver to" Style="{StaticResource OpsLabel}" Margin="0,4,0,0" />
              <ItemsControl Grid.Row="4" Grid.Column="1" ItemsSource="{x:Bind ViewModel.Destinations, Mode=OneWay}" IsTabStop="False"
                            AutomationProperties.Name="Deliver the result to">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <controls:WrapRowPanel Spacing="16" LineSpacing="4" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="mvvm:Choice">
                    <RadioButton Style="{StaticResource SetupRadio}" Margin="0,4" GroupName="JobDeliver" IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                 Command="{x:Bind Choose}" AutomationProperties.Name="{x:Bind Description}">
                      <TextBlock Text="{x:Bind Label}" Style="{StaticResource Cell}" />
                    </RadioButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <controls:ToneRow Grid.Row="5" Grid.ColumnSpan="2" Tone="Red" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasDraftWarning), Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.DraftWarning, Mode=OneWay}" TextWrapping="Wrap" LineHeight="18.125" LineStackingStrategy="BlockLineHeight" />
              </controls:ToneRow>
              <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <controls:CorvidButton Style="{StaticResource CorvidSmallButton}" Variant="Primary" Content="Create job"
                                       Command="{x:Bind ViewModel.CreateCommand}" />
                <controls:CorvidButton Style="{StaticResource CorvidSmallButton}" Variant="Ghost" Content="Cancel"
                                       Command="{x:Bind ViewModel.CancelNewCommand}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Grid x:Name="Columns" ColumnSpacing="18" RowSpacing="18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*" />
            <ColumnDefinition x:Name="RightColumn" Width="1*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Spacing="18">
            <!-- Scheduled: one row per job. -->
            <Border Style="{StaticResource CorvidPanel}">
              <StackPanel>
                <Border Style="{StaticResource PanelHead}">
                  <controls:WrapRowPanel Spacing="10" LineSpacing="2" PushLastRight="True">
                    <TextBlock Text="Scheduled" Style="{StaticResource PanelTitle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="pause, resume and remove need no approval: you act directly" Style="{StaticResource PanelNote}" />
                  </controls:WrapRowPanel>
                </Border>
                <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Disabled" SizeChanged="OnTableSized">
                  <StackPanel MinWidth="600" AutomationProperties.Name="Scheduled jobs">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="1.5*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="job" Style="{StaticResource TableHead}" />
                      <TextBlock Grid.Column="1" Text="schedule" Style="{StaticResource TableHead}" />
                      <TextBlock Grid.Column="2" Text="next run" Style="{StaticResource TableHead}" />
                      <TextBlock Grid.Column="3" Text="state" Style="{StaticResource TableHead}" />
                      <TextBlock Grid.Column="4" Text="last run" Style="{StaticResource TableHead}" />
                    </Grid>
                    <ItemsControl x:Name="JobRows" ItemsSource="{x:Bind ViewModel.Jobs}" IsTabStop="False" KeyDown="OnRowsKeyDown">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="jobs:JobRowViewModel">
                          <Button Style="{StaticResource OpsRowButton}" Command="{x:Bind SelectCommand}" AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
                            <Grid BorderBrush="{ThemeResource CorvidLine}" BorderThickness="0,1,0,0">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="1.5*" />
                              </Grid.ColumnDefinitions>
                              <Border Grid.ColumnSpan="5" Background="{ThemeResource CorvidAccentBg}" Visibility="{x:Bind ui:Ui.VisibleIf(IsSelected), Mode=OneWay}" />
                              <controls:WrapRowPanel Margin="10,5.5,10,8.5" Spacing="6" LineSpacing="4">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource CellMono}" FontWeight="Medium" />
                                <controls:TagChip Text="tainted" Tone="Amber" Visibility="{x:Bind ui:Ui.VisibleIf(IsTainted), Mode=OneWay}"
                                                  ToolTipService.ToolTip="Made in a tainted session: its runs start tainted" />
                              </controls:WrapRowPanel>
                              <TextBlock Grid.Column="1" Margin="10,5.5,10,8.5" Text="{x:Bind Schedule, Mode=OneWay}" Style="{StaticResource Cell}" />
                              <TextBlock Grid.Column="2" Margin="10,5.5,10,8.5" Text="{x:Bind Next, Mode=OneWay}" Style="{StaticResource Cell}" />
                              <controls:TagChip Grid.Column="3" Margin="10,7,10,7" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Text="{x:Bind StateText, Mode=OneWay}" Tone="{x:Bind StateTone, Mode=OneWay}" />
                              <TextBlock Grid.Column="4" Margin="10,5.5,10,8.5" Text="{x:Bind Last, Mode=OneWay}" Style="{StaticResource CellMuted}" />
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
                <TextBlock Text="{x:Bind ViewModel.EmptyText}" Style="{StaticResource CellMuted}" Margin="14,12"
                           Visibility="{x:Bind ui:Ui.CollapsedIf(ViewModel.HasJobs), Mode=OneWay}" />
              </StackPanel>
            </Border>

            <!-- The selected job's runs; a run opens its session read-only. -->
            <Border Style="{StaticResource CorvidPanel}">
              <StackPanel>
                <Border Style="{StaticResource PanelHead}">
                  <controls:WrapRowPanel Spacing="10" LineSpacing="2" PushLastRight="True">
                    <TextBlock Text="{x:Bind ViewModel.RunsTitle, Mode=OneWay}" Style="{StaticResource PanelTitle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="{x:Bind ViewModel.RunsNote}" Style="{StaticResource PanelNote}" />
                  </controls:WrapRowPanel>
                </Border>
                <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Disabled" SizeChanged="OnTableSized"
                              Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasRuns), Mode=OneWay}">
                  <StackPanel MinWidth="600" AutomationProperties.Name="Runs">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="124" />
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="due" Style="{StaticResource TableHead}" />
                      <TextBlock Grid.Column="1" Text="took" Style="{StaticResource TableHead}" />
                      <TextBlock Grid.Column="2" Text="status" Style="{StaticResource TableHead}" />
                      <TextBlock Grid.Column="3" Text="what it did" Style="{StaticResource TableHead}" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Runs}" IsTabStop="False">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="jobs:JobRunRowViewModel">
                          <Grid BorderBrush="{ThemeResource CorvidLine}" BorderThickness="0,1,0,0" AutomationProperties.Name="{x:Bind AutomationName}">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="124" />
                              <ColumnDefinition Width="76" />
                              <ColumnDefinition Width="74" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="5" Background="{ThemeResource CorvidAccentBg}" Visibility="{x:Bind ui:Ui.VisibleIf(IsHighlighted), Mode=OneWay}" />
                            <TextBlock Margin="10,5.5,10,8.5" Text="{x:Bind When}" Style="{StaticResource Cell}" />
                            <TextBlock Grid.Column="1" Margin="10,5.5,10,8.5" Text="{x:Bind Took}" Style="{StaticResource CellMuted}" />
                            <controls:TagChip Grid.Column="2" Margin="10,7,10,7" HorizontalAlignment="Left" VerticalAlignment="Top"
                                              Text="{x:Bind StatusText}" Tone="{x:Bind StatusTone}" />
                            <StackPanel Grid.Column="3" Margin="10,5.5,10,8.5">
                              <TextBlock Text="{x:Bind Detail}" Style="{StaticResource Cell}" />
                              <TextBlock Text="{x:Bind SessionId}" Style="{StaticResource CellSmall}" FontFamily="{StaticResource CorvidMono}" />
                            </StackPanel>
                            <controls:CorvidButton Grid.Column="4" Margin="0,6,10,6" VerticalAlignment="Top" Style="{StaticResource CorvidSmallButton}"
                                                   Content="Open run" Command="{x:Bind OpenCommand}" ToolTipService.ToolTip="{x:Bind OpenHelp}"
                                                   AutomationProperties.HelpText="{x:Bind OpenHelp}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
                <TextBlock Text="{x:Bind ViewModel.NoRunsText, Mode=OneWay}" Style="{StaticResource CellMuted}" Margin="14,12"
                           Visibility="{x:Bind ui:Ui.CollapsedIf(ViewModel.HasRuns), Mode=OneWay}" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="RightStack" Grid.Column="1" Spacing="18">
            <!-- The selected job: what it runs and where the result goes; pause, resume, remove. -->
            <Border Style="{StaticResource CorvidPanel}" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasSelection), Mode=OneWay}">
              <StackPanel>
                <Border Style="{StaticResource PanelHead}">
                  <controls:WrapRowPanel Spacing="10" LineSpacing="2" PushLastRight="True">
                    <TextBlock Text="{x:Bind ViewModel.DetailTitle, Mode=OneWay}" Style="{StaticResource PanelTitle}" FontFamily="{StaticResource CorvidMono}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.DetailTags, Mode=OneWay}" IsTabStop="False" ItemTemplate="{StaticResource TagTemplate}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </controls:WrapRowPanel>
                </Border>
                <StackPanel Padding="14,12" Spacing="12">
                  <ItemsControl ItemsSource="{x:Bind ViewModel.Detail, Mode=OneWay}" IsTabStop="False" ItemTemplate="{StaticResource FactTemplate}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                  <controls:WrapRowPanel Spacing="8" LineSpacing="8" Visibility="{x:Bind ui:Ui.CollapsedIf(ViewModel.IsConfirmingRemove), Mode=OneWay}">
                    <controls:CorvidButton Style="{StaticResource CorvidSmallButton}" Content="Pause" Command="{x:Bind ViewModel.PauseCommand}"
                                           Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.CanPause), Mode=OneWay}"
                                           ToolTipService.ToolTip="It will not run until you resume it" />
                    <controls:CorvidButton Style="{StaticResource CorvidSmallButton}" Variant="Primary" Content="Resume" Command="{x:Bind ViewModel.ResumeCommand}"
                                           Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.CanResume), Mode=OneWay}"
                                           ToolTipService.ToolTip="It runs again from its next scheduled time" />
                    <controls:CorvidButton Style="{StaticResource CorvidSmallButton}" Variant="Ghost" Content="Remove…" Foreground="{ThemeResource CorvidRed}"
                                           Command="{x:Bind ViewModel.AskRemoveCommand}" ToolTipService.ToolTip="It will not run again; its runs stay recorded" />
                  </controls:WrapRowPanel>
                  <controls:ToneRow Tone="Red" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.IsConfirmingRemove), Mode=OneWay}">
                    <StackPanel Spacing="8">
                      <TextBlock local:SpanText.Runs="{x:Bind ViewModel.RemoveQuestion, Mode=OneWay}" TextWrapping="Wrap" LineHeight="18.125"
                                 LineStackingStrategy="BlockLineHeight" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:CorvidButton x:Name="ConfirmRemoveButton" Style="{StaticResource CorvidSmallButton}" Content="Remove" Foreground="{ThemeResource CorvidRed}"
                                               Command="{x:Bind ViewModel.RemoveCommand}" />
                        <controls:CorvidButton Style="{StaticResource CorvidSmallButton}" Variant="Ghost" Content="Keep it"
                                               Command="{x:Bind ViewModel.CancelRemoveCommand}" />
                      </StackPanel>
                    </StackPanel>
                  </controls:ToneRow>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- The scheduler: where it runs, and what that means. -->
            <Border Style="{StaticResource CorvidPanel}">
              <StackPanel>
                <Border Style="{StaticResource PanelHead}">
                  <controls:WrapRowPanel Spacing="10" LineSpacing="2" PushLastRight="True">
                    <TextBlock Text="Scheduler" Style="{StaticResource PanelTitle}" AutomationProperties.HeadingLevel="Level2" />
                    <controls:TagChip Text="{x:Bind ViewModel.SchedulerTag, Mode=OneWay}" Tone="{x:Bind ViewModel.SchedulerTone, Mode=OneWay}" />
                  </controls:WrapRowPanel>
                </Border>
                <StackPanel Padding="14,12" Spacing="8">
                  <TextBlock local:SpanText.Runs="{x:Bind ViewModel.SchedulerText, Mode=OneWay}" Style="{StaticResource PanelText}" />
                  <TextBlock Text="Schedules read as &quot;in 30m&quot;, &quot;weekdays at 9am&quot;, a cron line or an ISO time, in the job's zone."
                             Style="{StaticResource PanelSmall}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>

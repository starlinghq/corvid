<Page x:Class="Corvid.App.Pages.AuditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Corvid.App.Controls"
      xmlns:audit="using:Corvid.App.Core.Audit"
      xmlns:local="using:Corvid.App.Pages"
      xmlns:ui="using:Corvid.App.Infrastructure"
      Background="{ThemeResource CorvidBg}"
      Foreground="{ThemeResource CorvidText}"
      FontSize="13.5">
  <!--
    The Audit area (Audit.png, Audit-narrow.png; docs/plan/ui.md §4.12, F8, F10, F21): the page head with the session
    picker, the log's size and the scan and export actions; then three columns: the Filter panel (200 px), the Events
    table (1.3fr) and the right column (1fr) with the selected event (the egress ledger for a request that left the
    machine, the raw event otherwise), the session's detection and the Export panel. Sizes and colours are corvid.css's:
    .page-head, .page-body, .panel, .panel-head, .panel-body, .table, .kv, .sect-head, .tail, .tag, .btn, .radio, .select.
    The page has no dock: the right column is the page's own.
  -->
  <Page.Resources>
    <!-- .panel-head: 10px 14px, a line below, semibold. -->
    <Style x:Key="PanelHead" TargetType="Border">
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="BorderBrush" Value="{ThemeResource CorvidLine}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="PanelTitle" TargetType="TextBlock" BasedOn="{StaticResource CorvidBodyText}">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- .kv .k: 12.5 px text-2, at least 64 wide. -->
    <Style x:Key="KeyLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="LineHeight" Value="18.1" />
      <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
      <Setter Property="MinWidth" Value="64" />
      <Setter Property="Foreground" Value="{ThemeResource CorvidText2}" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="KvText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="LineHeight" Value="18.1" />
      <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
      <Setter Property="Foreground" Value="{ThemeResource CorvidText}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="KvMono" TargetType="TextBlock" BasedOn="{StaticResource KvText}">
      <Setter Property="FontFamily" Value="{StaticResource CorvidMono}" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- .table th: 6px 10px, 12.5 px semibold text-2. -->
    <Style x:Key="HeadCell" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="LineHeight" Value="18.1" />
      <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{ThemeResource CorvidText2}" />
      <Setter Property="Margin" Value="10,6" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- .table td: 7px 10px, 12.5 px, top-aligned. -->
    <Style x:Key="Cell" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="LineHeight" Value="18" />
      <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
      <Setter Property="Margin" Value="10,7" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="MonoCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
      <Setter Property="FontFamily" Value="{StaticResource CorvidMono}" />
    </Style>

    <!-- .tail: 8px 10px on the code background, radius 6, JetBrains Mono 12.5 at a 1.5 line height, no wrapping. -->
    <Style x:Key="TailLine" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource CorvidMono}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="LineHeight" Value="18.75" />
      <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
      <Setter Property="Foreground" Value="{ThemeResource CorvidText}" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>

    <!-- .linkbtn in a panel head: no fill, a dotted underline; .app button's font and colour win, so the head's 13.5 px semibold text. -->
    <Style x:Key="HeadLinkButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="UseSystemFocusVisuals" Value="True" />
      <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource CorvidAccent}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <TextBlock x:Name="LabelText" Text="{TemplateBinding Content}" FontSize="13.5" FontWeight="SemiBold"
                         Foreground="{ThemeResource CorvidText}" TextWrapping="NoWrap" />
              <!-- text-decoration: underline dotted, drawn as a faint 1 px rule the text's width. -->
              <Border Height="1" Margin="0,0,0,1" VerticalAlignment="Bottom" Background="{ThemeResource CorvidText}" Opacity="0.55" />
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                      <Setter Target="LabelText.Foreground" Value="{ThemeResource CorvidAccent}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Pressed" />
                  <VisualState x:Name="Disabled" />
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- .select: 28 high, 0 8px, a line border, radius 6, on bg, with the native select's chevron. -->
    <Style x:Key="SelectButton" TargetType="Button">
      <Setter Property="Background" Value="{ThemeResource CorvidBg}" />
      <Setter Property="BorderBrush" Value="{ThemeResource CorvidLine}" />
      <Setter Property="Foreground" Value="{ThemeResource CorvidText}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,0,6,0" />
      <Setter Property="Height" Value="28" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="UseSystemFocusVisuals" Value="True" />
      <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource CorvidAccent}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Root">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" />
              <Border x:Name="Film" Background="{ThemeResource CorvidText}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0.05" Visibility="Collapsed" />
              <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"
                                Padding="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalContentAlignment="Stretch" />
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                      <Setter Target="Film.Visibility" Value="Visible" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                      <Setter Target="Film.Visibility" Value="Visible" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Disabled">
                    <VisualState.Setters>
                      <Setter Target="Root.Opacity" Value="0.5" />
                    </VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A row of the Events table: the whole row is the button that opens the event. -->
    <Style x:Key="EventRowButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="UseSystemFocusVisuals" Value="True" />
      <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource CorvidAccent}" />
      <Setter Property="FocusVisualMargin" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Border x:Name="Film" Background="{ThemeResource CorvidText}" Opacity="0.03" Visibility="Collapsed" />
              <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" />
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                      <Setter Target="Film.Visibility" Value="Visible" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                      <Setter Target="Film.Visibility" Value="Visible" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Disabled" />
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- .radio with a checkbox: 6px 0, gap 8, the 13 px box 3 px down; checked on the accent. -->
    <Style x:Key="AuditCheckBox" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{ThemeResource CorvidText}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Padding" Value="0,6" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="UseSystemFocusVisuals" Value="True" />
      <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource CorvidAccent}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}" ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid Width="13" Height="13" VerticalAlignment="Top" Margin="4,3,3,0">
                <Border x:Name="Box" CornerRadius="2.5" BorderThickness="1" BorderBrush="{ThemeResource CorvidText2}" Background="{ThemeResource CorvidBg}" />
                <Border x:Name="Fill" CornerRadius="2.5" Background="{ThemeResource CorvidAccent}" Visibility="Collapsed" />
                <Path x:Name="Mark" Data="M2.8,6.6 L5.4,9.2 L10.2,3.9" Stroke="{ThemeResource CorvidOnAccent}" StrokeThickness="1.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
              </Grid>
              <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                FontSize="{TemplateBinding FontSize}" VerticalAlignment="Top" />
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CombinedStates">
                  <VisualState x:Name="UncheckedNormal" />
                  <VisualState x:Name="UncheckedPointerOver">
                    <VisualState.Setters>
                      <Setter Target="Box.BorderBrush" Value="{ThemeResource CorvidText}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="UncheckedPressed" />
                  <VisualState x:Name="UncheckedDisabled">
                    <VisualState.Setters>
                      <Setter Target="Root.Opacity" Value="0.5" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="CheckedNormal">
                    <VisualState.Setters>
                      <Setter Target="Fill.Visibility" Value="Visible" />
                      <Setter Target="Mark.Visibility" Value="Visible" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="CheckedPointerOver">
                    <VisualState.Setters>
                      <Setter Target="Fill.Visibility" Value="Visible" />
                      <Setter Target="Mark.Visibility" Value="Visible" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="CheckedPressed">
                    <VisualState.Setters>
                      <Setter Target="Fill.Visibility" Value="Visible" />
                      <Setter Target="Mark.Visibility" Value="Visible" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="CheckedDisabled">
                    <VisualState.Setters>
                      <Setter Target="Fill.Visibility" Value="Visible" />
                      <Setter Target="Mark.Visibility" Value="Visible" />
                      <Setter Target="Root.Opacity" Value="0.5" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="IndeterminateNormal" />
                  <VisualState x:Name="IndeterminatePointerOver" />
                  <VisualState x:Name="IndeterminatePressed" />
                  <VisualState x:Name="IndeterminateDisabled" />
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- .radio with a radio button: a 13 px ring; checked, the accent ring with its dot. -->
    <Style x:Key="AuditRadioButton" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{ThemeResource CorvidText}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Padding" Value="0,6" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="UseSystemFocusVisuals" Value="True" />
      <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource CorvidAccent}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}" ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid Width="13" Height="13" VerticalAlignment="Top" Margin="5,3,3,0">
                <Ellipse x:Name="Ring" Stroke="{ThemeResource CorvidText2}" StrokeThickness="1" Fill="{ThemeResource CorvidBg}" />
                <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{ThemeResource CorvidAccent}" Visibility="Collapsed" />
              </Grid>
              <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                FontSize="{TemplateBinding FontSize}" VerticalAlignment="Top" />
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver" />
                  <VisualState x:Name="Pressed" />
                  <VisualState x:Name="Disabled">
                    <VisualState.Setters>
                      <Setter Target="Root.Opacity" Value="0.5" />
                    </VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="CheckStates">
                  <VisualState x:Name="Checked">
                    <VisualState.Setters>
                      <Setter Target="Ring.Stroke" Value="{ThemeResource CorvidAccent}" />
                      <Setter Target="Ring.StrokeThickness" Value="1.5" />
                      <Setter Target="Dot.Visibility" Value="Visible" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Unchecked" />
                  <VisualState x:Name="Indeterminate" />
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A raw line in a .tail block. -->
    <DataTemplate x:Key="TailLineTemplate" x:DataType="audit:AuditLine">
      <TextBlock Style="{StaticResource TailLine}" local:AuditRuns.Line="{x:Bind}" />
    </DataTemplate>

    <!-- The raw event's lines wrap: the engine's events hold long strings (a tool's whole result), which a narrow panel cut. -->
    <DataTemplate x:Key="RawLineTemplate" x:DataType="audit:AuditLine">
      <TextBlock Style="{StaticResource TailLine}" TextWrapping="Wrap" local:AuditRuns.Line="{x:Bind}" />
    </DataTemplate>

    <!-- A .kv row: the label, then the value's spans. -->
    <DataTemplate x:Key="FieldTemplate" x:DataType="audit:AuditField">
      <controls:WrapRowPanel Spacing="8" LineSpacing="8">
        <TextBlock Text="{x:Bind Label}" Style="{StaticResource KeyLabel}" />
        <TextBlock Style="{StaticResource KvText}" local:AuditRuns.Spans="{x:Bind Value}" />
      </controls:WrapRowPanel>
    </DataTemplate>
  </Page.Resources>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- .page-head: the title, the session picker and the log's size; Scan and Export at the right, wrapping below when narrow. -->
    <Border x:Name="Head" Style="{StaticResource CorvidPageHead}">
      <Grid x:Name="HeadGrid" ColumnSpacing="12" SizeChanged="OnHeadSizeChanged">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:WrapRowPanel x:Name="HeadLeft" Spacing="12" LineSpacing="8" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" Text="{x:Bind ViewModel.Title}" Style="{StaticResource CorvidPageTitle}" VerticalAlignment="Center"
                     AutomationProperties.HeadingLevel="Level1" />
          <Button x:Name="SessionPicker" Style="{StaticResource SelectButton}" AutomationProperties.Name="Session"
                  ToolTipService.ToolTip="The session whose events to read, or the whole log">
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="SessionLabel" FontSize="13.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <controls:Icon Grid.Column="1" Kind="ChevronDown" Width="12" Height="12" Foreground="{ThemeResource CorvidText}" VerticalAlignment="Center" />
            </Grid>
            <Button.Flyout>
              <MenuFlyout x:Name="SessionMenu" Placement="BottomEdgeAlignedLeft" Opening="OnSessionMenuOpening" />
            </Button.Flyout>
          </Button>
          <TextBlock x:Name="LogText" Style="{StaticResource CorvidSmallText}" VerticalAlignment="Center">
            <Run Text="{x:Bind ViewModel.LogCount, Mode=OneWay}" />
            <Run Text="{x:Bind ViewModel.LogPath, Mode=OneWay}" FontFamily="{StaticResource CorvidMono}" />
          </TextBlock>
        </controls:WrapRowPanel>
        <StackPanel x:Name="HeadActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <controls:CorvidButton Content="Scan · fail on high" Command="{x:Bind ViewModel.ScanCommand}"
                                 ToolTipService.ToolTip="Run the detection rules over this log; the result says what corvid audit scan --fail-on high would exit with" />
          <controls:CorvidButton Content="Export trace…" Click="OnExportClick"
                                 ToolTipService.ToolTip="Write a Beacon JSONL trace of this log (the Export panel)" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- .page-body: 18px 24px; the three columns 200px, 1.3fr and 1fr, 18 apart; one column on the phone. -->
    <ScrollViewer x:Name="BodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  SizeChanged="OnBodySizeChanged">
      <Grid x:Name="Body" Padding="24,18" ColumnSpacing="18" RowSpacing="18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="FilterColumn" Width="200" />
          <ColumnDefinition x:Name="EventsColumn" Width="1.3*" />
          <ColumnDefinition x:Name="SideColumn" Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Filter -->
        <Border x:Name="FilterPanel" Style="{StaticResource CorvidPanel}" VerticalAlignment="Top">
          <StackPanel>
            <Border Style="{StaticResource PanelHead}">
              <Grid>
                <TextBlock Text="Filter" Style="{StaticResource PanelTitle}" AutomationProperties.HeadingLevel="Level2" />
                <Button Content="reset" Style="{StaticResource HeadLinkButton}" HorizontalAlignment="Right" Command="{x:Bind ViewModel.ResetCommand}"
                        AutomationProperties.Name="Reset the filters" />
              </Grid>
            </Border>
            <StackPanel Padding="14,12" Spacing="6">
              <ItemsControl ItemsSource="{x:Bind ViewModel.Filters}" IsTabStop="False" AutomationProperties.Name="Event groups">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="6" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="audit:AuditFilterItem">
                    <CheckBox Style="{StaticResource AuditCheckBox}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}">
                      <TextBlock Text="{x:Bind Label}" FontSize="12.5" LineHeight="18.1" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" />
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="path or tool" Style="{StaticResource CorvidSmallText}" Margin="0,6,0,0" />
              <TextBox x:Name="PathBox" Text="{x:Bind ViewModel.PathFilter, Mode=OneWay}" TextChanged="OnPathTextChanged"
                       PlaceholderText="e.g. web_fetch" PlaceholderForeground="{ThemeResource CorvidText2}"
                       MinHeight="28" Height="28" Padding="8,4,8,0" FontSize="13.5" CornerRadius="6" BorderThickness="1"
                       BorderBrush="{ThemeResource CorvidLine}" Background="{ThemeResource CorvidBg}" Foreground="{ThemeResource CorvidText}"
                       IsSpellCheckEnabled="False" AutomationProperties.Name="Path or tool filter"
                       ToolTipService.ToolTip="Words separated by spaces or commas: a tool, part of a path, or an event type such as tool_call_issued (Ctrl+F)" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Events -->
        <Border x:Name="EventsPanel" Grid.Column="1" Style="{StaticResource CorvidPanel}" VerticalAlignment="Top">
          <StackPanel>
            <Border Style="{StaticResource PanelHead}">
              <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Events" Style="{StaticResource PanelTitle}" AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.EventsNote, Mode=OneWay}" Style="{StaticResource CorvidSmallText}"
                           HorizontalAlignment="Right" HorizontalTextAlignment="Right" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="clear" Style="{StaticResource HeadLinkButton}" Command="{x:Bind ViewModel.ClearMatchCommand}"
                        Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasMatch), Mode=OneWay}" AutomationProperties.Name="Show every event again" />
              </Grid>
            </Border>
            <ScrollViewer x:Name="TableScroll" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto" VerticalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Disabled" SizeChanged="OnTableScrollSizeChanged">
              <StackPanel x:Name="Table" HorizontalAlignment="Left">
                <!-- thead -->
                <Grid BorderBrush="{ThemeResource CorvidLine}" BorderThickness="0,0,0,1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition x:Name="HeadTimeColumn" Width="72" />
                    <ColumnDefinition Width="155" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="seq" Style="{StaticResource HeadCell}" />
                  <TextBlock x:Name="HeadTimeCell" Grid.Column="1" Text="time" Style="{StaticResource HeadCell}" />
                  <TextBlock Grid.Column="2" Text="type" Style="{StaticResource HeadCell}" />
                  <TextBlock Grid.Column="3" Text="summary" Style="{StaticResource HeadCell}" />
                </Grid>
                <ItemsControl x:Name="EventRows" ItemsSource="{x:Bind ViewModel.Rows}" IsTabStop="False" AutomationProperties.Name="Events"
                              KeyDown="OnRowsKeyDown">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="audit:AuditEventRow">
                      <Button Style="{StaticResource EventRowButton}" Command="{x:Bind SelectCommand}" AutomationProperties.Name="{x:Bind AutomationName}" Click="OnRowClick"
>
                        <Grid BorderBrush="{ThemeResource CorvidLine}" BorderThickness="0,0,0,1">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="{x:Bind local:AuditPage.TimeWidth(local:AuditLayout.Current.IsPhone), Mode=OneWay}" />
                            <ColumnDefinition Width="155" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Border Grid.ColumnSpan="4" Background="{ThemeResource CorvidAccentBg}" Visibility="{x:Bind ui:Ui.VisibleIf(IsSelected), Mode=OneWay}" />
                          <TextBlock Text="{x:Bind SequenceText}" Style="{StaticResource MonoCell}" local:AuditRuns.Ink="CorvidText2" local:AuditRuns.Alert="{x:Bind IsAlert}" />
                          <TextBlock Grid.Column="1" Text="{x:Bind TimeText}" Style="{StaticResource Cell}" local:AuditRuns.Ink="CorvidText2" local:AuditRuns.Alert="{x:Bind IsAlert}"
                                     Visibility="{x:Bind ui:Ui.CollapsedIf(local:AuditLayout.Current.IsPhone), Mode=OneWay}" />
                          <TextBlock Grid.Column="2" Text="{x:Bind Type}" Style="{StaticResource MonoCell}" TextTrimming="CharacterEllipsis"
                                     local:AuditRuns.Ink="CorvidText" local:AuditRuns.Alert="{x:Bind IsAlert}" />
                          <TextBlock Grid.Column="3" Style="{StaticResource Cell}" TextWrapping="Wrap" local:AuditRuns.Ink="CorvidText"
                                     local:AuditRuns.Alert="{x:Bind IsAlert}" local:AuditRuns.Spans="{x:Bind Summary}" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" Style="{StaticResource CorvidSmallText}" Margin="10,12"
                           Visibility="{x:Bind ui:Ui.CollapsedIf(ViewModel.HasRows), Mode=OneWay}" />
              </StackPanel>
            </ScrollViewer>
          </StackPanel>
        </Border>

        <!-- The right column: the selected event (the egress ledger, or the raw event), the detection, Export. -->
        <StackPanel x:Name="SideStack" Grid.Column="2" Spacing="14" VerticalAlignment="Top">
          <controls:ToneRow AutomationProperties.LiveSetting="Assertive" Tone="Red" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasError), Mode=OneWay}">
            <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}" TextWrapping="Wrap" />
          </controls:ToneRow>

          <!-- Egress ledger · request 7 → claude -->
          <Border Style="{StaticResource CorvidPanel}" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasEgress), Mode=OneWay}">
            <StackPanel>
              <Border Style="{StaticResource PanelHead}">
                <Grid ColumnSpacing="10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Bind ViewModel.Egress.Title, Mode=OneWay, FallbackValue=''}" Style="{StaticResource PanelTitle}"
                             AutomationProperties.HeadingLevel="Level2" />
                  <controls:TagChip Grid.Column="1" Text="cloud" Tone="Violet" ToolTipService.ToolTip="A cloud model: this request left the machine" />
                </Grid>
              </Border>
              <StackPanel Padding="14,12" Spacing="8">
                <controls:WrapRowPanel Spacing="8" LineSpacing="8">
                  <TextBlock Text="when" Style="{StaticResource KeyLabel}" />
                  <TextBlock Text="{x:Bind ViewModel.Egress.When, Mode=OneWay, FallbackValue=''}" Style="{StaticResource KvText}" />
                </controls:WrapRowPanel>
                <controls:WrapRowPanel Spacing="8" LineSpacing="8">
                  <TextBlock Text="model" Style="{StaticResource KeyLabel}" />
                  <TextBlock Text="{x:Bind ViewModel.Egress.Model, Mode=OneWay, FallbackValue=''}" Style="{StaticResource KvMono}" />
                  <TextBlock Style="{StaticResource KvText}" local:AuditRuns.Ink="CorvidText2" local:AuditRuns.Spans="{x:Bind ViewModel.Egress.Route, Mode=OneWay, FallbackValue={x:Null}}" />
                </controls:WrapRowPanel>
                <controls:WrapRowPanel Spacing="8" LineSpacing="8">
                  <TextBlock Text="sent" Style="{StaticResource KeyLabel}" />
                  <TextBlock Text="{x:Bind ViewModel.Egress.Sent, Mode=OneWay, FallbackValue=''}" Style="{StaticResource KvText}" />
                </controls:WrapRowPanel>
                <controls:WrapRowPanel Spacing="8" LineSpacing="8" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.Egress.HasRedactions), Mode=OneWay, FallbackValue=Collapsed}">
                  <TextBlock Text="redacted" Style="{StaticResource KeyLabel}" />
                  <controls:TagChip Text="{x:Bind ViewModel.Egress.RedactedTag, Mode=OneWay, FallbackValue=''}" Tone="Amber" />
                  <TextBlock Style="{StaticResource KvText}" local:AuditRuns.Spans="{x:Bind ViewModel.Egress.RedactedSummary, Mode=OneWay, FallbackValue={x:Null}}" />
                </controls:WrapRowPanel>
                <!-- The markers in the text do not add up to the gate's count: one may be a tool's or the model's own text. -->
                <controls:ToneRow Tone="Amber" Padding="10,6" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.Egress.HasRedactionMismatch), Mode=OneWay, FallbackValue=Collapsed}">
                  <TextBlock Text="{x:Bind ViewModel.Egress.RedactionMismatch, Mode=OneWay, FallbackValue=''}" FontSize="12.5" TextWrapping="Wrap" />
                </controls:ToneRow>
                <!-- .sect-head: "As sent, after the gate" and what is shown; 4 px more above, 6 below. -->
                <Grid Margin="0,4,0,6" ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="As sent, after the gate" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level3" />
                  <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Egress.ShownLabel, Mode=OneWay, FallbackValue=''}" FontSize="12.5" FontWeight="SemiBold"
                             Foreground="{ThemeResource CorvidText2}" TextWrapping="NoWrap" />
                </Grid>
                <Border Background="{ThemeResource CorvidCodeBg}" CornerRadius="6">
                  <ScrollViewer x:Name="SentScroll" MaxHeight="{x:Bind local:AuditPage.SentHeight(ViewModel.Egress.IsFull), Mode=OneWay, FallbackValue=170}"
                                HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto" VerticalScrollBarVisibility="Auto"
                                AutomationProperties.Name="The request as sent">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Egress.Lines, Mode=OneWay, FallbackValue={x:Null}}" ItemTemplate="{StaticResource TailLineTemplate}"
                                  IsTabStop="False" Padding="10,8" />
                  </ScrollViewer>
                </Border>
                <Grid x:Name="SentActions" ColumnSpacing="8" SizeChanged="OnSentActionsSizeChanged">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <controls:CorvidButton x:Name="SentToggle" Content="{x:Bind ViewModel.Egress.ToggleLabel, Mode=OneWay, FallbackValue=''}" Style="{StaticResource CorvidSmallButton}"
                                         Command="{x:Bind ViewModel.Egress.ToggleFullCommand, Mode=OneWay, FallbackValue={x:Null}}"
                                         ToolTipService.ToolTip="The whole request as the gate sent it, rendered again on demand" />
                  <controls:CorvidButton x:Name="CopySentButton" Grid.Column="1" Content="Copy" Style="{StaticResource CorvidSmallButton}" Variant="Ghost"
                                         Click="OnCopySentClick" ToolTipService.ToolTip="Copy what is shown, with the redaction markers" />
                  <TextBlock x:Name="SentNote" Grid.Column="2" Text="{x:Bind ViewModel.Egress.Note, Mode=OneWay, FallbackValue=''}" Style="{StaticResource CorvidSmallText}"
                             VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Event 1189 · tool_call_issued: the raw event (F21). -->
          <Border Style="{StaticResource CorvidPanel}" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasDetail), Mode=OneWay}">
            <StackPanel>
              <Border Style="{StaticResource PanelHead}">
                <Grid ColumnSpacing="10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Bind ViewModel.Detail.Title, Mode=OneWay, FallbackValue=''}" Style="{StaticResource PanelTitle}"
                             local:AuditRuns.Ink="CorvidText" local:AuditRuns.Alert="{x:Bind ViewModel.Detail.IsAlert, Mode=OneWay, FallbackValue=False}"
                             AutomationProperties.HeadingLevel="Level2" />
                  <controls:CorvidButton x:Name="CloseDetailButton" Grid.Column="1" Content="Close" Style="{StaticResource CorvidSmallButton}" Variant="Ghost"
                                         Command="{x:Bind ViewModel.ClearSelectionCommand}" ToolTipService.ToolTip="Close the event (Esc)" />
                </Grid>
              </Border>
              <StackPanel Padding="14,12" Spacing="8">
                <TextBlock Style="{StaticResource KvText}" local:AuditRuns.Ink="CorvidText" local:AuditRuns.Alert="{x:Bind ViewModel.Detail.IsAlert, Mode=OneWay, FallbackValue=False}"
                           local:AuditRuns.Spans="{x:Bind ViewModel.Detail.Summary, Mode=OneWay, FallbackValue={x:Null}}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Detail.Fields, Mode=OneWay, FallbackValue={x:Null}}" ItemTemplate="{StaticResource FieldTemplate}" IsTabStop="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Grid Margin="0,4,0,6" ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Raw event" FontSize="12.5" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level3" />
                  <TextBlock Grid.Column="1" Text="JSON, as stored" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource CorvidText2}" />
                </Grid>
                <Border Background="{ThemeResource CorvidCodeBg}" CornerRadius="6">
                  <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto"
                                AutomationProperties.Name="The raw event">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Detail.Lines, Mode=OneWay, FallbackValue={x:Null}}" ItemTemplate="{StaticResource RawLineTemplate}"
                                  IsTabStop="False" Padding="10,8" />
                  </ScrollViewer>
                </Border>
                <controls:CorvidButton x:Name="CopyRawButton" Content="Copy" Style="{StaticResource CorvidSmallButton}" HorizontalAlignment="Left"
                                       Click="OnCopyRawClick" ToolTipService.ToolTip="Copy the raw event" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Nothing selected. -->
          <Border Style="{StaticResource CorvidPanel}" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasNoSelection), Mode=OneWay}">
            <StackPanel>
              <Border Style="{StaticResource PanelHead}">
                <TextBlock Text="Event" Style="{StaticResource PanelTitle}" AutomationProperties.HeadingLevel="Level2" />
              </Border>
              <TextBlock Margin="14,12" Text="{x:Bind ViewModel.NoSelectionText, Mode=OneWay}" Style="{StaticResource CorvidMutedText}" FontSize="12.5" LineHeight="18.1" />
            </StackPanel>
          </Border>

          <!-- Detection · credential-read-then-egress (F10). -->
          <Border Style="{StaticResource CorvidPanel}">
            <StackPanel>
              <Border Style="{StaticResource PanelHead}">
                <Grid ColumnSpacing="10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Bind ViewModel.Detection.Title, Mode=OneWay, FallbackValue='Detections'}" Style="{StaticResource PanelTitle}"
                             local:AuditRuns.Ink="CorvidText" local:AuditRuns.Alert="{x:Bind ViewModel.HasDetection, Mode=OneWay}"
                             AutomationProperties.HeadingLevel="Level2" />
                  <controls:TagChip Grid.Column="1" Text="{x:Bind ViewModel.Detection.Tag, Mode=OneWay, FallbackValue=''}" Tone="Red"
                                    Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasDetection), Mode=OneWay}" />
                </Grid>
              </Border>
              <StackPanel Padding="14,12" Spacing="8">
                <TextBlock Style="{StaticResource CorvidBodyText}" local:AuditRuns.Spans="{x:Bind ViewModel.Detection.Explanation, Mode=OneWay, FallbackValue={x:Null}}"
                           Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasDetection), Mode=OneWay}" />
                <TextBlock Text="No detection rule matched in this log." Style="{StaticResource CorvidMutedText}"
                           Visibility="{x:Bind ui:Ui.CollapsedIf(ViewModel.HasDetection), Mode=OneWay}" />
                <controls:WrapRowPanel Spacing="8" LineSpacing="8" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasDetection), Mode=OneWay}">
                  <TextBlock Text="rule" Style="{StaticResource KeyLabel}" />
                  <TextBlock Text="{x:Bind ViewModel.Detection.Rule, Mode=OneWay, FallbackValue=''}" Style="{StaticResource KvMono}" />
                  <TextBlock Text="{x:Bind ViewModel.Detection.RuleDetail, Mode=OneWay, FallbackValue=''}" Style="{StaticResource KvText}" Foreground="{ThemeResource CorvidText2}" />
                </controls:WrapRowPanel>
                <controls:WrapRowPanel Spacing="8" LineSpacing="8" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasDetection), Mode=OneWay}">
                  <TextBlock Text="events" Style="{StaticResource KeyLabel}" />
                  <ItemsControl ItemsSource="{x:Bind ViewModel.Detection.Events, Mode=OneWay, FallbackValue={x:Null}}" IsTabStop="False"
                                AutomationProperties.Name="The matched events">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="audit:AuditEventLink">
                        <controls:LinkButton Text="{x:Bind Text}" Command="{x:Bind Open}" FontSize="12.5"
                                             AutomationProperties.Name="{x:Bind local:AuditPage.EventLinkName(Text)}"
                                             ToolTipService.ToolTip="Show only the detection's events, with this one open" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </controls:WrapRowPanel>
                <controls:WrapRowPanel Spacing="8" LineSpacing="8" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasLastScan), Mode=OneWay}">
                  <TextBlock Text="last scan" Style="{StaticResource KeyLabel}" />
                  <TextBlock Text="{x:Bind ViewModel.LastScan, Mode=OneWay}" Style="{StaticResource KvText}" />
                </controls:WrapRowPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Export · Beacon JSONL -->
          <Border x:Name="ExportPanel" Style="{StaticResource CorvidPanel}">
            <StackPanel>
              <Border Style="{StaticResource PanelHead}">
                <Grid ColumnSpacing="10">
                  <TextBlock Text="Export" Style="{StaticResource PanelTitle}" AutomationProperties.HeadingLevel="Level2" />
                  <TextBlock Text="Beacon JSONL" Style="{StaticResource CorvidSmallText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <StackPanel Padding="14,12" Spacing="8">
                <RadioButton x:Name="FullRadio" GroupName="AuditRetention" Style="{StaticResource AuditRadioButton}"
                             IsChecked="{x:Bind ViewModel.FullRetention, Mode=TwoWay}">
                  <TextBlock Text="full content, secrets redacted, strings cut at 4 KiB" FontSize="12.5" LineHeight="18.1" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" />
                </RadioButton>
                <RadioButton GroupName="AuditRetention" Style="{StaticResource AuditRadioButton}" IsChecked="{x:Bind ViewModel.MetadataOnly, Mode=TwoWay}">
                  <TextBlock Text="metadata only: names, paths, commands and decisions" FontSize="12.5" LineHeight="18.1" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" />
                </RadioButton>
                <CheckBox Style="{StaticResource AuditCheckBox}" IsChecked="{x:Bind ViewModel.IncludeMemory, Mode=TwoWay}">
                  <TextBlock Text="include local-only memory content" FontSize="12.5" LineHeight="18.1" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" />
                </CheckBox>
                <controls:CorvidButton Content="Write trace.jsonl (owner-only file)" Style="{StaticResource CorvidSmallButton}" HorizontalAlignment="Left"
                                       Command="{x:Bind ViewModel.ExportCommand}" />
                <!-- .toast: green, 8px 12px, radius 8, 12.5 px. -->
                <Border x:Name="ExportToast" Background="{ThemeResource CorvidGreenBg}" CornerRadius="8" Padding="12,8"
                        Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasExportResult), Mode=OneWay}">
                  <TextBlock Text="{x:Bind ViewModel.ExportResult, Mode=OneWay}" FontSize="12.5" Foreground="{ThemeResource CorvidGreen}" TextWrapping="Wrap" />
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>

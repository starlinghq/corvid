<Page x:Class="Corvid.App.Pages.SecretsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Corvid.App.Controls"
      xmlns:secrets="using:Corvid.App.Core.Secrets"
      xmlns:models="using:Corvid.App.Core.Models"
      xmlns:coreshell="using:Corvid.App.Core.Shell"
      xmlns:local="using:Corvid.App.Pages"
      xmlns:ui="using:Corvid.App.Infrastructure"
      Background="{ThemeResource CorvidBg}"
      Foreground="{ThemeResource CorvidText}"
      FontSize="13.5">
  <!--
    The Secrets area (docs/plan/ui.md §4.11, F17; no mockup: drawn in the Models page's language). The page head with its
    line and two buttons, then two columns (1.4fr and 1fr, 18 apart): Waiting on a secret and Secrets on the left; Vault,
    Who uses what and How values get in on the right. One column on a phone. Set a secret… and Bind another name… open a
    picker over the page; Esc closes it. No value is drawn anywhere: the view models have none.
  -->
  <Page.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Pages/ModelsStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <DataTemplate x:Key="FactTemplate" x:DataType="models:ModelFact">
        <controls:WrapRowPanel Spacing="8" LineSpacing="4" AutomationProperties.Name="{x:Bind AutomationName}">
          <TextBlock Text="{x:Bind Key}" Style="{StaticResource KvKey}" LineHeight="18" />
          <TextBlock local:SpanText.Runs="{x:Bind Value}" Style="{StaticResource Cell}" LineHeight="18" />
        </controls:WrapRowPanel>
      </DataTemplate>

      <!-- A command to run, in the code font on bg-3, selectable so it can be copied as text. -->
      <Style x:Key="CommandBox" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CorvidCodeBg}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CorvidLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,5" />
      </Style>
    </ResourceDictionary>
  </Page.Resources>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border x:Name="HeadHost" Style="{StaticResource CorvidPageHead}">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:WrapRowPanel x:Name="HeadTitle" Spacing="12" LineSpacing="6" VerticalAlignment="Center">
          <TextBlock Text="{x:Bind ViewModel.Title}" Style="{StaticResource CorvidPageTitle}" VerticalAlignment="Center"
                     AutomationProperties.HeadingLevel="Level1" />
          <TextBlock local:SpanText.Runs="{x:Bind ViewModel.Subtitle}" Style="{StaticResource CorvidMutedText}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </controls:WrapRowPanel>
        <StackPanel x:Name="HeadButtons" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <controls:CorvidButton Content="Check again" Command="{x:Bind ViewModel.RefreshCommand}"
                                 ToolTipService.ToolTip="Ask Vault again: a secret set in a terminal shows here" />
          <controls:CorvidButton Content="Set a secret…" Variant="Primary" Command="{x:Bind ViewModel.OpenSetCommand}"
                                 ToolTipService.ToolTip="Set a secret outside the app: Vault asks for the value, never Corvid" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer x:Name="BodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="Body" Padding="24,18,24,18" Spacing="18">
        <controls:ToneRow Tone="{x:Bind ViewModel.NoticeTone, Mode=OneWay}" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasNotice), Mode=OneWay}"
                          AutomationProperties.LiveSetting="Polite">
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock local:SpanText.Runs="{x:Bind ViewModel.Notice, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center"
                       LineHeight="18.125" LineStackingStrategy="BlockLineHeight" />
            <controls:CorvidButton Grid.Column="1" Style="{StaticResource CorvidSmallButton}" Variant="Ghost" Content="Dismiss"
                                   Foreground="{ThemeResource CorvidText2}" Command="{x:Bind ViewModel.DismissNoticeCommand}" />
          </Grid>
        </controls:ToneRow>

        <!-- F23: Vault absent. -->
        <controls:ToneRow Tone="Red" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.IsVaultAbsent), Mode=OneWay}">
          <TextBlock Text="Vault does not answer: cloud slots are hidden and every feature below waits. Start it with corvid-vault serve."
                     TextWrapping="Wrap" LineHeight="18.125" LineStackingStrategy="BlockLineHeight" />
        </controls:ToneRow>

        <Grid x:Name="Columns" ColumnSpacing="18" RowSpacing="18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="1.4*" />
            <ColumnDefinition x:Name="RightColumn" Width="1*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel x:Name="LeftStack" Spacing="18">
            <!-- Waiting on a secret (F17). -->
            <Border Style="{StaticResource CorvidPanel}">
              <StackPanel>
                <Border Style="{StaticResource PanelHead}">
                  <controls:WrapRowPanel Spacing="10" LineSpacing="2" PushLastRight="True">
                    <TextBlock Text="Waiting on a secret" Style="{StaticResource PanelTitle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="{x:Bind ViewModel.NeedsNote, Mode=OneWay}" Style="{StaticResource PanelNote}" />
                  </controls:WrapRowPanel>
                </Border>
                <ItemsControl x:Name="NeedsList" ItemsSource="{x:Bind ViewModel.Needs}" IsTabStop="False" AutomationProperties.Name="Features waiting on a secret">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="secrets:SecretNeedView">
                      <Border Style="{StaticResource TableRow}" Padding="14,10,14,12" AutomationProperties.Name="{x:Bind AutomationName}">
                        <Grid ColumnSpacing="10">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <controls:Icon Kind="Lock" Width="16" Height="16" Margin="0,1,0,0" VerticalAlignment="Top" Foreground="{ThemeResource CorvidAmber}" />
                          <StackPanel Grid.Column="1" Spacing="8">
                            <StackPanel Spacing="2">
                              <controls:WrapRowPanel Spacing="8" LineSpacing="2">
                                <TextBlock Text="{x:Bind Feature}" Style="{StaticResource Cell}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CellMuted}" />
                              </controls:WrapRowPanel>
                              <TextBlock local:SpanText.Runs="{x:Bind Problem}" Style="{StaticResource Cell}" />
                            </StackPanel>
                            <Border Style="{StaticResource CommandBox}" HorizontalAlignment="Left">
                              <TextBlock Text="{x:Bind Command}" FontFamily="{StaticResource CorvidMono}" FontSize="12.5" IsTextSelectionEnabled="True"
                                         TextWrapping="Wrap" AutomationProperties.Name="{x:Bind Command}" />
                            </Border>
                            <controls:WrapRowPanel Spacing="8" LineSpacing="6">
                              <controls:CorvidButton Style="{StaticResource CorvidSmallButton}" Variant="Primary" Content="Open in a terminal"
                                                     Command="{x:Bind SetCommand}" Tag="{x:Bind}"
                                                     ToolTipService.ToolTip="Runs the command in a terminal; Vault asks for the value there" />
                              <controls:CorvidButton Style="{StaticResource CorvidSmallButton}" Content="Bind another name…" Command="{x:Bind BindCommand}"
                                                     ToolTipService.ToolTip="Use a secret Vault already has, if it is bound to this host" />
                              <controls:CorvidButton Style="{StaticResource CorvidSmallButton}" Variant="Ghost" Content="Vault helper" IsEnabled="False"
                                                     ToolTipService.ToolTip="The Vault helper (U-6) is not built yet; a terminal does the same" />
                            </controls:WrapRowPanel>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="14,10,14,12" Text="Nothing waits on a secret: every configured feature has the name it needs."
                           Style="{StaticResource PanelSmall}" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasNoNeeds), Mode=OneWay}" />
              </StackPanel>
            </Border>

            <!-- Secrets: names and policy, never values. -->
            <Border Style="{StaticResource CorvidPanel}">
              <StackPanel>
                <Border Style="{StaticResource PanelHead}">
                  <controls:WrapRowPanel Spacing="10" LineSpacing="2" PushLastRight="True">
                    <TextBlock Text="Secrets" Style="{StaticResource PanelTitle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="{x:Bind ViewModel.SecretsNote, Mode=OneWay}" Style="{StaticResource PanelNote}" />
                  </controls:WrapRowPanel>
                </Border>
                <TextBlock Text="name · hosts · methods · toolsets · budget" Style="{StaticResource TableHead}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Secrets}" IsTabStop="False" AutomationProperties.Name="Secrets in Vault">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="secrets:SecretRowView">
                      <Border Style="{StaticResource TableRow}" Padding="10,6.5,10,9" AutomationProperties.Name="{x:Bind AutomationName}">
                        <Grid ColumnSpacing="14">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Spacing="3">
                            <controls:WrapRowPanel Spacing="8" LineSpacing="2">
                              <TextBlock Text="{x:Bind Name}" Style="{StaticResource CellMono}" FontWeight="SemiBold" />
                              <controls:TagChip Text="hidden characters" Tone="Red" Visibility="{x:Bind ui:Ui.VisibleIf(HasHidden)}"
                                                ToolTipService.ToolTip="The name holds characters a reader cannot see; it cannot be bound until it is corrected in Vault" />
                              <TextBlock Text="{x:Bind Description}" Style="{StaticResource CellMuted}" />
                            </controls:WrapRowPanel>
                            <TextBlock Text="{x:Bind Hosts}" Style="{StaticResource CellSmall}" FontFamily="{StaticResource CorvidMono}" />
                            <ItemsControl ItemsSource="{x:Bind Methods}" IsTabStop="False" AutomationProperties.Name="Methods">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <controls:WrapRowPanel Spacing="4" LineSpacing="4" />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="coreshell:StatusTag">
                                  <controls:TagChip Text="{x:Bind Text}" Tone="{x:Bind Tone}" ToolTipService.ToolTip="{x:Bind Detail}" AutomationProperties.Name="{x:Bind Text}" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <controls:WrapRowPanel Spacing="8" LineSpacing="2">
                              <TextBlock Text="{x:Bind Use}" Style="{StaticResource CellSmall}" />
                              <TextBlock Text="{x:Bind TaintedUse}" Style="{StaticResource CellSmall}" />
                            </controls:WrapRowPanel>
                          </StackPanel>
                          <StackPanel Grid.Column="1" Width="150" Spacing="3">
                            <TextBlock Text="{x:Bind Budget}" Style="{StaticResource CellSmall}" />
                            <controls:Meter Width="140" HorizontalAlignment="Left" Fraction="{x:Bind BudgetFraction}" Visibility="{x:Bind ui:Ui.VisibleIf(HasBudget)}"
                                            AutomationProperties.Name="Budget used" />
                            <TextBlock Text="{x:Bind UsedBy}" Style="{StaticResource CellSmall}" />
                            <TextBlock Text="{x:Bind LastUsed}" Style="{StaticResource CellSmall}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="10,8" Text="Vault has no secrets yet. Set a secret… shows the command that adds one."
                           Style="{StaticResource CellMuted}" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasNoSecrets), Mode=OneWay}" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="RightStack" Grid.Column="1" Spacing="18">
            <!-- Vault. -->
            <Border Style="{StaticResource CorvidPanel}">
              <StackPanel>
                <Border Style="{StaticResource PanelHead}">
                  <controls:WrapRowPanel Spacing="10" LineSpacing="2" PushLastRight="True">
                    <TextBlock Text="Vault" Style="{StaticResource PanelTitle}" AutomationProperties.HeadingLevel="Level2" />
                    <controls:TagChip Text="{x:Bind ViewModel.VaultTag, Mode=OneWay}" Tone="{x:Bind ViewModel.VaultTone, Mode=OneWay}" />
                  </controls:WrapRowPanel>
                </Border>
                <StackPanel Padding="14,12" Spacing="8">
                  <TextBlock Text="A separate process holds every value. Corvid sees names, hosts and policy, and the counts below." Style="{StaticResource PanelText}" />
                  <ItemsControl ItemsSource="{x:Bind ViewModel.VaultFacts, Mode=OneWay}" IsTabStop="False" ItemTemplate="{StaticResource FactTemplate}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="6" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{x:Bind ViewModel.AuditFacts, Mode=OneWay}" IsTabStop="False" ItemTemplate="{StaticResource FactTemplate}"
                                AutomationProperties.Name="Vault's audit summary">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="6" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Who uses what. -->
            <Border Style="{StaticResource CorvidPanel}">
              <StackPanel>
                <Border Style="{StaticResource PanelHead}">
                  <controls:WrapRowPanel Spacing="10" LineSpacing="2" PushLastRight="True">
                    <TextBlock Text="Who uses what" Style="{StaticResource PanelTitle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="from corvid.json" Style="{StaticResource PanelNote}" />
                  </controls:WrapRowPanel>
                </Border>
                <ItemsControl Padding="14,10,14,12" ItemsSource="{x:Bind ViewModel.Consumers, Mode=OneWay}" IsTabStop="False" AutomationProperties.Name="Features and their secrets">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="secrets:ConsumerRowView">
                      <Grid ColumnSpacing="8" AutomationProperties.Name="{x:Bind AutomationName}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <controls:WrapRowPanel Spacing="6">
                            <TextBlock Text="{x:Bind Feature}" Style="{StaticResource Cell}" />
                            <TextBlock Text="{x:Bind Secret}" Style="{StaticResource CellMono}" />
                          </controls:WrapRowPanel>
                          <TextBlock Text="{x:Bind Host}" Style="{StaticResource CellSmall}" />
                        </StackPanel>
                        <controls:TagChip Grid.Column="1" Text="{x:Bind State}" Tone="{x:Bind StateTone}" VerticalAlignment="Top" Margin="0,1,0,0" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- How values get in. -->
            <Border Style="{StaticResource CorvidPanel}">
              <StackPanel>
                <Border Style="{StaticResource PanelHead}">
                  <TextBlock Text="How values get in" Style="{StaticResource PanelTitle}" AutomationProperties.HeadingLevel="Level2" />
                </Border>
                <StackPanel Padding="14,12" Spacing="8">
                  <TextBlock local:SpanText.Runs="{x:Bind local:SecretsPage.HowSet}" Style="{StaticResource PanelText}" />
                  <TextBlock local:SpanText.Runs="{x:Bind local:SecretsPage.HowLater}" Style="{StaticResource PanelSmall}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <!-- The pickers, over the page: a scrim that closes them, then the card. -->
    <Grid x:Name="PickerLayer" Grid.RowSpan="2" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.IsPickerOpen), Mode=OneWay}">
      <Border Background="#33000000" Tapped="OnScrimTapped" />
      <ContentControl x:Name="PickerHost" IsTabStop="True" UseSystemFocusVisuals="False" VerticalAlignment="Top" HorizontalAlignment="Center"
                      Margin="16,64,16,16" HorizontalContentAlignment="Stretch">
        <Border x:Name="PickerCard" Style="{StaticResource PickerCard}" Width="480">
          <Grid>
            <!-- Set a secret… -->
            <StackPanel Spacing="8" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.IsSetOpen), Mode=OneWay}">
              <TextBlock Text="Set a secret" Style="{StaticResource PanelTitle}" AutomationProperties.HeadingLevel="Level2" />
              <TextBlock Text="Vault asks for the value in a terminal; it never passes through Corvid. Corvid learns only that the name now exists."
                         Style="{StaticResource PanelSmall}" />
              <TextBlock Text="name" Style="{StaticResource KvKey}" />
              <TextBox x:Name="SetNameBox" Style="{StaticResource FieldBox}" PlaceholderText="gemini.key" KeyDown="OnSetNameKeyDown"
                       Text="{x:Bind ViewModel.SetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Secret name" />
              <TextBlock Text="{x:Bind ViewModel.SetNameProblem, Mode=OneWay}" Style="{StaticResource PanelSmall}" Foreground="{ThemeResource CorvidRed}"
                         Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasSetNameProblem), Mode=OneWay}" />
              <TextBlock Text="command" Style="{StaticResource KvKey}" />
              <Border Style="{StaticResource CommandBox}">
                <TextBlock Text="{x:Bind ViewModel.SetPreview, Mode=OneWay}" FontFamily="{StaticResource CorvidMono}" FontSize="12.5"
                           IsTextSelectionEnabled="True" TextWrapping="Wrap" />
              </Border>
              <controls:ToneRow Tone="Amber" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasLaunch), Mode=OneWay}" AutomationProperties.LiveSetting="Polite">
                <TextBlock Text="{x:Bind ViewModel.LaunchNote, Mode=OneWay}" TextWrapping="Wrap" LineHeight="18.125" LineStackingStrategy="BlockLineHeight" />
              </controls:ToneRow>
              <controls:WrapRowPanel Spacing="8" LineSpacing="6" Margin="0,4,0,0">
                <controls:CorvidButton Style="{StaticResource CorvidSmallButton}" Variant="Primary" Content="Open in a terminal"
                                       Command="{x:Bind ViewModel.StartSetCommand}" />
                <controls:CorvidButton Style="{StaticResource CorvidSmallButton}" Content="Check again" Command="{x:Bind ViewModel.RefreshCommand}"
                                       Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.HasLaunch), Mode=OneWay}"
                                       ToolTipService.ToolTip="Ask Vault whether the secret exists now" />
                <controls:CorvidButton Style="{StaticResource CorvidSmallButton}" Variant="Ghost" Content="Close" Command="{x:Bind ViewModel.ClosePickerCommand}" />
              </controls:WrapRowPanel>
            </StackPanel>

            <!-- Bind another name… -->
            <StackPanel Spacing="8" Visibility="{x:Bind ui:Ui.VisibleIf(ViewModel.IsBindOpen), Mode=OneWay}">
              <TextBlock Text="{x:Bind ViewModel.BindTitle, Mode=OneWay}" Style="{StaticResource PanelTitle}" AutomationProperties.HeadingLevel="Level2" />
              <TextBlock Text="A secret serves the feature only when Vault binds it to the feature's host. The name is written to corvid.json; no value moves."
                         Style="{StaticResource PanelSmall}" />
              <ScrollViewer x:Name="BindScroll" MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
              <ItemsControl ItemsSource="{x:Bind ViewModel.BindChoices}" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="secrets:BindChoiceView">
                    <Button Style="{StaticResource PickerRow}" Command="{x:Bind Choose}" AutomationProperties.Name="{x:Bind AutomationName}">
                      <StackPanel>
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource CellMono}" />
                        <TextBlock Text="{x:Bind Hosts}" Style="{StaticResource CellSmall}" />
                        <TextBlock Text="{x:Bind Reason}" Style="{StaticResource CellSmall}" Visibility="{x:Bind ui:Ui.VisibleIf(HasReason)}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              </ScrollViewer>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:CorvidButton Style="{StaticResource CorvidSmallButton}" Variant="Ghost" Content="Cancel" Command="{x:Bind ViewModel.ClosePickerCommand}" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>
      </ContentControl>
    </Grid>
  </Grid>
</Page>

<UserControl x:Class="Corvid.App.Pages.BoardDock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Corvid.App.Controls"
             xmlns:local="using:Corvid.App.Pages"
             xmlns:ui="using:Corvid.App.Infrastructure"
             Foreground="{ThemeResource CorvidText}"
             FontSize="13.5">
  <!--
    .tray (Board.dc.html aside.tray): the head (12px 14px, a line below, semibold) with "Notify when unfocused"; the items
    (AttentionList); and the note at the foot (12px 14px, a line above, small and muted).
  -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Padding="14,12" BorderBrush="{ThemeResource CorvidLine}" BorderThickness="0,0,0,1" ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{x:Bind ViewModel.AttentionHead, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap"
                 TextTrimming="CharacterEllipsis" AutomationProperties.HeadingLevel="Level2" />
      <controls:CorvidButton Grid.Column="1" Content="{x:Bind ViewModel.NotifyLabel, Mode=OneWay}" Style="{StaticResource CorvidSmallButton}"
                             Variant="Ghost" Command="{x:Bind ViewModel.ToggleNotifyCommand}"
                             ToolTipService.ToolTip="A native notification for each new item while the window is unfocused" />
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
      <StackPanel>
        <local:AttentionList Items="{x:Bind ViewModel.Attention, Mode=OneWay}" />
        <TextBlock Margin="14,12" Style="{StaticResource CorvidSmallText}" Text="Nothing waits on you."
                   Visibility="{x:Bind ui:Ui.CollapsedIf(ViewModel.HasAttention), Mode=OneWay}" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Padding="14,12" BorderBrush="{ThemeResource CorvidLine}" BorderThickness="0,1,0,0">
      <TextBlock Style="{StaticResource CorvidSmallText}"
                 Text="Nothing here is answered from a bare button: approvals open their full card, with the parsed command, reasons and diff." />
    </Border>
  </Grid>
</UserControl>

<UserControl x:Class="Corvid.App.Pages.BoardDock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{ThemeResource CorvidText}"
             FontSize="13.5">
  <!-- .tray: the attention tray's head, then its items (built with the Board). -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Padding="14,0,14,0" MinHeight="49" BorderBrush="{ThemeResource CorvidLine}" BorderThickness="0,0,0,1">
      <TextBlock Text="Attention" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
    </Border>
    <TextBlock Grid.Row="1" Margin="14,12,14,12" Style="{StaticResource CorvidSmallText}"
               Text="Everything waiting on you across sessions: approvals, questions, held tools, pairing codes, reviews and finished jobs. Each item opens its full card." />
  </Grid>
</UserControl>

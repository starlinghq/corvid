<!--
  Templates for the shell's controls, drawn from the mockups' CSS (corvid.css): sizes, radii and colours are the CSS's.
  Every colour is a {ThemeResource Corvid*} so a theme switch at run time repaints them, and states that would fight over
  one property (hover and selected) set different elements, so they compose. Keyboard focus draws the system focus
  rectangle in the accent colour, as the mockups' focus outline (.opt.focus) is.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Corvid.App.Controls">

  <!--
    .nav li a: 6px 8px padding, radius 6, gap 10; hover bg-3; selected accent-bg, accent, weight 500, accent badge. The
    row's height comes from the rail's PitchedStackPanel (31.575 px, the CSS's padding and line height), and the label is
    centred at its natural height, which places it where CSS's half-leading does.
  -->
  <Style TargetType="controls:RailNavItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="31" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource CorvidAccent}" />
    <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource CorvidBg}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:RailNavItem">
          <Grid x:Name="Root" CornerRadius="6" Background="Transparent">
            <Border x:Name="Hover" CornerRadius="6" Background="{ThemeResource CorvidBg3}" Opacity="0" />
            <Grid Padding="{TemplateBinding Padding}" ColumnSpacing="10" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <controls:Icon x:Name="Glyph" Kind="{TemplateBinding Icon}" Foreground="{ThemeResource CorvidText}" VerticalAlignment="Center" />
              <TextBlock x:Name="LabelText" Grid.Column="1" Text="{TemplateBinding Label}" Foreground="{ThemeResource CorvidText}"
                         FontSize="13.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
              <Border x:Name="BadgeBox" Grid.Column="2" MinWidth="18" Height="18" Padding="5,0" CornerRadius="9"
                      Background="{ThemeResource CorvidBg3}" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="BadgeText" Text="{TemplateBinding Badge}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{ThemeResource CorvidText2}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Hover.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Hover.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.5" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="SelectionStates">
                <VisualState x:Name="Unselected" />
                <VisualState x:Name="Selected">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource CorvidAccentBg}" />
                    <Setter Target="Hover.Visibility" Value="Collapsed" />
                    <Setter Target="Glyph.Foreground" Value="{ThemeResource CorvidAccent}" />
                    <Setter Target="LabelText.Foreground" Value="{ThemeResource CorvidAccent}" />
                    <Setter Target="LabelText.FontWeight" Value="Medium" />
                    <Setter Target="BadgeBox.Background" Value="{ThemeResource CorvidAccent}" />
                    <Setter Target="BadgeText.Foreground" Value="{ThemeResource CorvidOnAccent}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="BadgeStates">
                <VisualState x:Name="NoBadge" />
                <VisualState x:Name="HasBadge">
                  <VisualState.Setters>
                    <Setter Target="BadgeBox.Visibility" Value="Visible" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    .sessions li a: 5px 8px padding, radius 6, gap 8; the status dot; selected bg-3; the time muted and small. Rows of
    29.575 px from the rail's PitchedStackPanel, the label centred at its natural height.
  -->
  <Style TargetType="controls:RailSessionItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="29" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource CorvidAccent}" />
    <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource CorvidBg}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:RailSessionItem">
          <Grid x:Name="Root" CornerRadius="6" Background="Transparent">
            <Border x:Name="Hover" CornerRadius="6" Background="{ThemeResource CorvidBg3}" Opacity="0" />
            <Grid Padding="{TemplateBinding Padding}" ColumnSpacing="8" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{ThemeResource CorvidText2}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{TemplateBinding Title}" Foreground="{ThemeResource CorvidText}" FontSize="13.5"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
              <TextBlock Grid.Column="2" Text="{TemplateBinding When}" Foreground="{ThemeResource CorvidText2}" FontSize="12"
                         VerticalAlignment="Center" TextWrapping="NoWrap" />
            </Grid>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Hover.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Hover.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.5" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="SelectionStates">
                <VisualState x:Name="Unselected" />
                <VisualState x:Name="Selected">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource CorvidBg3}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="DotStates">
                <VisualState x:Name="Idle" />
                <VisualState x:Name="Running">
                  <VisualState.Setters>
                    <Setter Target="Dot.Fill" Value="{ThemeResource CorvidAccent}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Waiting">
                  <VisualState.Setters>
                    <Setter Target="Dot.Fill" Value="{ThemeResource CorvidAmber}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Job">
                  <VisualState.Setters>
                    <Setter Target="Dot.Fill" Value="{ThemeResource CorvidViolet}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- .iconbtn: 28 by 28, radius 6, text-2 until hovered (bg-3, text); .count: amber, 16 high, top-right at -2. -->
  <Style TargetType="controls:IconButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource CorvidAccent}" />
    <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource CorvidBg}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:IconButton">
          <Grid x:Name="Root">
            <Border x:Name="Face" CornerRadius="6" Background="Transparent" />
            <controls:Icon x:Name="Glyph" Kind="{TemplateBinding Icon}" Foreground="{ThemeResource CorvidText2}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border x:Name="CountBox" MinWidth="16" Height="16" Padding="4,0" CornerRadius="8" Margin="0,-2,-2,0"
                    Background="{ThemeResource CorvidAmber}" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
              <TextBlock Text="{TemplateBinding Count}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource CorvidOnAccent}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Face.Background" Value="{ThemeResource CorvidBg3}" />
                    <Setter Target="Glyph.Foreground" Value="{ThemeResource CorvidText}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Face.Background" Value="{ThemeResource CorvidBg3}" />
                    <Setter Target="Glyph.Foreground" Value="{ThemeResource CorvidText}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.5" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CountStates">
                <VisualState x:Name="NoCount" />
                <VisualState x:Name="HasCount">
                  <VisualState.Setters>
                    <Setter Target="CountBox.Visibility" Value="Visible" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- .seg button: 0 8px padding, 11.5 px, text-2; pressed in inverted colours (text background, bg text). -->
  <Style TargetType="controls:SegmentButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource CorvidAccent}" />
    <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource CorvidBg}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:SegmentButton">
          <Grid x:Name="Root" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
            <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}" Foreground="{ThemeResource CorvidText2}"
                              FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource CorvidText}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource CorvidText}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.5" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource CorvidText}" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource CorvidBg}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPointerOver">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource CorvidText}" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource CorvidBg}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPressed">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource CorvidText}" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource CorvidBg}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedDisabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource CorvidText}" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource CorvidBg}" />
                    <Setter Target="Root.Opacity" Value="0.5" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- .tag: 18 high, 0 7px padding, radius 9, 11 px semibold, in its tone's pair of colours. -->
  <Style TargetType="controls:TagChip">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:TagChip">
          <Border x:Name="Root" Height="18" Padding="7,0" CornerRadius="9" Background="{ThemeResource CorvidBg3}">
            <TextBlock x:Name="Label" Text="{TemplateBinding Text}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{ThemeResource CorvidText2}" VerticalAlignment="Center" TextWrapping="NoWrap" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="ToneStates">
                <VisualState x:Name="Grey" />
                <VisualState x:Name="Amber">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource CorvidAmberBg}" />
                    <Setter Target="Label.Foreground" Value="{ThemeResource CorvidAmber}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Red">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource CorvidRedBg}" />
                    <Setter Target="Label.Foreground" Value="{ThemeResource CorvidRed}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Green">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource CorvidGreenBg}" />
                    <Setter Target="Label.Foreground" Value="{ThemeResource CorvidGreen}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Violet">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource CorvidVioletBg}" />
                    <Setter Target="Label.Foreground" Value="{ThemeResource CorvidViolet}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Blue">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource CorvidAccentBg}" />
                    <Setter Target="Label.Foreground" Value="{ThemeResource CorvidAccent}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- .ph-bar a: icon over an 11 px label, 44 px tall, radius 8, text-2; the current tab accent; the amber count. -->
  <Style TargetType="controls:PhoneTabItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,6" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource CorvidAccent}" />
    <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource CorvidBg}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:PhoneTabItem">
          <Grid x:Name="Root" MinHeight="44" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
            <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
              <controls:Icon x:Name="Glyph" Kind="{TemplateBinding Icon}" Foreground="{ThemeResource CorvidText2}" HorizontalAlignment="Center" />
              <TextBlock x:Name="LabelText" Text="{TemplateBinding Label}" FontSize="11" Foreground="{ThemeResource CorvidText2}"
                         HorizontalAlignment="Center" TextWrapping="NoWrap" />
            </StackPanel>
            <Border x:Name="CountBox" MinWidth="16" Height="16" Padding="4,0" CornerRadius="8" Margin="24,-4,0,0"
                    Background="{ThemeResource CorvidAmber}" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed">
              <TextBlock Text="{TemplateBinding Count}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource CorvidOnAccent}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver" />
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource CorvidBg3}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.5" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="SelectionStates">
                <VisualState x:Name="Unselected" />
                <VisualState x:Name="Selected">
                  <VisualState.Setters>
                    <Setter Target="Glyph.Foreground" Value="{ThemeResource CorvidAccent}" />
                    <Setter Target="LabelText.Foreground" Value="{ThemeResource CorvidAccent}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CountStates">
                <VisualState x:Name="NoCount" />
                <VisualState x:Name="HasCount">
                  <VisualState.Setters>
                    <Setter Target="CountBox.Visibility" Value="Visible" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- .tabs button: 26 high, 0 9px padding, radius 6, 12.5 px text-2; selected on bg with text and weight 500. -->
  <Style TargetType="controls:DockTab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource CorvidAccent}" />
    <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource CorvidBg}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:DockTab">
          <Grid x:Name="Root" Height="26" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock x:Name="LabelText" Text="{TemplateBinding Label}" FontSize="12.5" Foreground="{ThemeResource CorvidText2}"
                         VerticalAlignment="Center" TextWrapping="NoWrap" />
              <Border x:Name="BadgeBox" MinWidth="18" Height="18" Padding="5,0" CornerRadius="9" Background="{ThemeResource CorvidBg3}"
                      VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="{TemplateBinding Badge}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource CorvidText2}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </StackPanel>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="LabelText.Foreground" Value="{ThemeResource CorvidText}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="LabelText.Foreground" Value="{ThemeResource CorvidText}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.5" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="SelectionStates">
                <VisualState x:Name="Unselected" />
                <VisualState x:Name="Selected">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource CorvidBg}" />
                    <Setter Target="LabelText.Foreground" Value="{ThemeResource CorvidText}" />
                    <Setter Target="LabelText.FontWeight" Value="Medium" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="BadgeStates">
                <VisualState x:Name="NoBadge" />
                <VisualState x:Name="HasBadge">
                  <VisualState.Setters>
                    <Setter Target="BadgeBox.Visibility" Value="Visible" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- a: the accent colour, no underline until hovered. -->
  <Style TargetType="controls:LinkButton">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource CorvidAccent}" />
    <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource CorvidBg}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:LinkButton">
          <Grid x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}">
            <TextBlock x:Name="LabelText" Text="{TemplateBinding Text}" Foreground="{ThemeResource CorvidAccent}" FontSize="{TemplateBinding FontSize}"
                       Padding="0,1.62" TextWrapping="NoWrap" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="LabelText.TextDecorations" Value="Underline" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="LabelText.TextDecorations" Value="Underline" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.5" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    .btn: 30 high, 0 12px padding, radius 6, a line border on bg, weight 500; .btn.primary on the accent with
    CorvidOnAccent text; .btn.ghost with no border or fill. Hover lays a faint text-coloured film over the face (.btn:hover
    bg-2, .btn.ghost:hover bg-3).
  -->
  <Style x:Key="CorvidButtonBase" TargetType="controls:CorvidButton">
    <Setter Property="Background" Value="{ThemeResource CorvidBg}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CorvidLine}" />
    <Setter Property="Foreground" Value="{ThemeResource CorvidText}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Height" Value="30" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource CorvidAccent}" />
    <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource CorvidBg}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:CorvidButton">
          <Grid x:Name="Root">
            <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" />
            <Border x:Name="Film" Background="{ThemeResource CorvidText}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0.05"
                    Visibility="Collapsed" />
            <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                              FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Center" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Film.Visibility" Value="Visible" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Film.Visibility" Value="Visible" />
                    <Setter Target="Film.Opacity" Value="0.1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.5" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="VariantStates">
                <VisualState x:Name="Default" />
                <VisualState x:Name="Primary">
                  <VisualState.Setters>
                    <Setter Target="Face.Background" Value="{ThemeResource CorvidAccent}" />
                    <Setter Target="Face.BorderBrush" Value="{ThemeResource CorvidAccent}" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource CorvidOnAccent}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Ghost">
                  <VisualState.Setters>
                    <Setter Target="Face.Background" Value="Transparent" />
                    <Setter Target="Face.BorderBrush" Value="Transparent" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    .row: 6px 10px, radius 6, 12.5 px; .row.esc violet, .row.taint amber, .row.detect red on their backgrounds;
    .row.memory (grey) bg-2 with a line border and text-2. Content inherits the tone's colour.
  -->
  <Style TargetType="controls:ToneRow">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:ToneRow">
          <Border x:Name="Root" Padding="{TemplateBinding Padding}" CornerRadius="6" Background="{ThemeResource CorvidBg2}"
                  BorderBrush="{ThemeResource CorvidLine}" BorderThickness="1">
            <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{ThemeResource CorvidText2}" FontSize="{TemplateBinding FontSize}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="ToneStates">
                <VisualState x:Name="Grey" />
                <VisualState x:Name="Amber">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource CorvidAmberBg}" />
                    <Setter Target="Root.BorderThickness" Value="0" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource CorvidAmber}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Red">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource CorvidRedBg}" />
                    <Setter Target="Root.BorderThickness" Value="0" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource CorvidRed}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Green">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource CorvidGreenBg}" />
                    <Setter Target="Root.BorderThickness" Value="0" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource CorvidGreen}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Violet">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource CorvidVioletBg}" />
                    <Setter Target="Root.BorderThickness" Value="0" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource CorvidViolet}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Blue">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource CorvidAccentBg}" />
                    <Setter Target="Root.BorderThickness" Value="0" />
                    <Setter Target="Presenter.Foreground" Value="{ThemeResource CorvidAccent}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The implicit style; an explicit Style replaces it, so the sizes below are based on the keyed one. -->
  <Style TargetType="controls:CorvidButton" BasedOn="{StaticResource CorvidButtonBase}" />

  <!-- .btn.sm: 26 high, 0 9px padding, 12.5 px. -->
  <Style x:Key="CorvidSmallButton" TargetType="controls:CorvidButton" BasedOn="{StaticResource CorvidButtonBase}">
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>

  <!-- kbd: 18 high, 0 5px padding, radius 4, a line border on bg-2, 11 px text-2. -->
  <Style x:Key="CorvidKeyCap" TargetType="Border">
    <Setter Property="Height" Value="18" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{ThemeResource CorvidLine}" />
    <Setter Property="Background" Value="{ThemeResource CorvidBg2}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="CorvidKeyCapText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="ms-appx:///Assets/Fonts/JetBrainsMono" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{ThemeResource CorvidText2}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- .page-head: 12px 24px, a line below; the title at 17 px semibold. -->
  <Style x:Key="CorvidPageHead" TargetType="Border">
    <Setter Property="Padding" Value="24,12" />
    <Setter Property="MinHeight" Value="55" />
    <Setter Property="BorderBrush" Value="{ThemeResource CorvidLine}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <!-- .panel: a bordered, rounded block on the page. -->
  <Style x:Key="CorvidPanel" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CorvidBg}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CorvidLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
</ResourceDictionary>

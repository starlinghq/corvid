<!--
  Type (docs/plan/ui.md §7, corvid.css): Inter for prose, JetBrains Mono for code, commands and paths, both embedded under
  Assets/Fonts with their OFL licences. Inter is also the default text font (set in App's constructor), so plain text
  needs no FontFamily. Sizes follow the mockups: 13.5 px body, 12 to 12.5 px secondary, 15 px session title, 17 px page
  title, 600 for headings, 12.5 px mono. Line heights are the CSS's 1.45, fixed per line so rows measure as the mockups do.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="CorvidSans">ms-appx:///Assets/Fonts/Inter</FontFamily>
  <FontFamily x:Key="CorvidMono">ms-appx:///Assets/Fonts/JetBrainsMono</FontFamily>

  <x:Double x:Key="CorvidBodySize">13.5</x:Double>
  <x:Double x:Key="CorvidSmallSize">12</x:Double>
  <x:Double x:Key="CorvidCodeSize">12.5</x:Double>

  <!-- Body text: 13.5 px, the text colour. -->
  <Style x:Key="CorvidBodyText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource CorvidSans}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="LineHeight" Value="19.6" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="Foreground" Value="{ThemeResource CorvidText}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- .muted: the second text colour at body size. -->
  <Style x:Key="CorvidMutedText" TargetType="TextBlock" BasedOn="{StaticResource CorvidBodyText}">
    <Setter Property="Foreground" Value="{ThemeResource CorvidText2}" />
  </Style>

  <!-- .muted.small: 12 px secondary text. -->
  <Style x:Key="CorvidSmallText" TargetType="TextBlock" BasedOn="{StaticResource CorvidBodyText}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="17.4" />
    <Setter Property="Foreground" Value="{ThemeResource CorvidText2}" />
  </Style>

  <!-- .section-title: 11 px, semibold, spaced, upper case (the text is written in capitals). One line, so no line height. -->
  <Style x:Key="CorvidSectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CharacterSpacing" Value="40" />
    <Setter Property="Foreground" Value="{ThemeResource CorvidText2}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <!-- .page-head h1: 17 px, semibold. -->
  <Style x:Key="CorvidPageTitle" TargetType="TextBlock" BasedOn="{StaticResource CorvidBodyText}">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="LineHeight" Value="24.65" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <!-- .title: a session's title, 15 px, semibold, cut with an ellipsis. -->
  <Style x:Key="CorvidSessionTitle" TargetType="TextBlock" BasedOn="{StaticResource CorvidBodyText}">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="LineHeight" Value="21.75" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- .mono: JetBrains Mono at 12.5 px for code, commands and paths. -->
  <Style x:Key="CorvidMonoText" TargetType="TextBlock" BasedOn="{StaticResource CorvidBodyText}">
    <Setter Property="FontFamily" Value="{StaticResource CorvidMono}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="LineHeight" Value="18.1" />
  </Style>
</ResourceDictionary>

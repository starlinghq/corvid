<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
    <ProjectReference Include="../../src/Corvid.Acp/Corvid.Acp.csproj" />
    <!-- The host tests' fake slots, so every suite drives the host the same way. -->
    <Compile Include="../Corvid.Host.Tests/Fakes.cs" Link="Fakes.cs" />
    <!-- Recorded message exchanges, compared with what the agent says now. -->
    <None Include="Exchanges/*.jsonl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/TestImages.cs" Link="TestImages.cs" />
  </ItemGroup>
</Project>

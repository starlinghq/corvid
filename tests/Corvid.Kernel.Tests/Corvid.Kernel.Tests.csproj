<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
    <ProjectReference Include="../../src/Corvid.Kernel/Corvid.Kernel.csproj" />
    <!-- Real generated tools (read-only, side-effecting, destructive), and the golden-trajectory format. -->
    <ProjectReference Include="../Corvid.Tools.Fixtures/Corvid.Tools.Fixtures.csproj" />
    <ProjectReference Include="../../evals/Corvid.Evals/Corvid.Evals.csproj" />
    <!-- The built-in shell tool (C-012), driven through the real turn loop and approval pipeline. -->
    <ProjectReference Include="../../src/Corvid.Tools.Builtin/Corvid.Tools.Builtin.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../evals/golden/*.json" LinkBase="golden" CopyToOutputDirectory="PreserveNewest" />
    <!-- The Beacon export's golden lines (C-027). -->
    <Content Include="Fixtures/*.jsonl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/TestImages.cs" Link="TestImages.cs" />
  </ItemGroup>
</Project>

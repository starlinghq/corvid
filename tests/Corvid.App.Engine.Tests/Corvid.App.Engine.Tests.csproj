<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
    <ProjectReference Include="../../src/Corvid.App.Engine/Corvid.App.Engine.csproj" />
    <!-- The host tests' fake slots and test host, so the engine is driven on the fakes every host suite uses. -->
    <Compile Include="../Corvid.Host.Tests/Fakes.cs" Link="Fakes.cs" />
    <!-- The app core tests' manual clock, so no timer of the composition fires on its own. -->
    <Compile Include="../Corvid.App.Core.Tests/ManualTimeProvider.cs" Link="ManualTimeProvider.cs" />
    <!-- A3 ops: the in-process MCP server (C-018) and the stand-in Vault on a Unix socket, as the host tests use them. -->
    <Compile Include="../Corvid.Mcp.Tests/FakeMcpServer.cs" Link="FakeMcpServer.cs" />
    <Compile Include="../Corvid.Models.Remote.Tests/Infrastructure.cs" Link="FakeVault.cs" />
    <Compile Include="../Shared/ShortTemp.cs" Link="ShortTemp.cs" />
    <!-- A4 hosting: the gateway tests' fake platform, so the hosted gateway (G-14) never reaches a real chat service. -->
    <Compile Include="../Corvid.Gateway.Tests/Fakes.cs" Link="GatewayFakes.cs" />
  </ItemGroup>
</Project>

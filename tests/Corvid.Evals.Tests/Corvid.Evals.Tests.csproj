<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
    <ProjectReference Include="../../evals/Corvid.Evals/Corvid.Evals.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Copied at build time, so a no-build test run replays the golden set as committed. -->
    <Content Include="../../evals/golden/*.json" LinkBase="golden" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

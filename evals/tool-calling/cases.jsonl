{"id": "ms-007", "prompt": "Fetch https://example.com/release-notes and save a short summary to notes/release.md.", "tags": ["multi_step"], "steps": [{"expect": {"tool": "web_fetch"}, "args": {"url": {"equals": "https://example.com/release-notes"}}}, {"expect": {"tool": "write_file"}, "args": {"path": {"regex": "^(\\./)?notes/release\\.md$"}}}], "results": {"web_fetch": "Release 2.1: faster startup, a new export command, and a fix for the login timeout."}}
{"id": "ms-008", "prompt": "Get the weather in Lisbon and email it to ana@example.com.", "tags": ["multi_step"], "steps": [{"expect": {"tool": "weather__get_weather"}, "args": {"city": {"equals": "Lisbon"}}}, {"expect": {"any_of": ["email__send_email", "messages__send_message"]}, "args": {"to": {"contains": ["ana@example.com"]}, "recipient": {"contains": ["ana@example.com"]}, "channel": {"equals": "email"}}}], "results": {"weather__get_weather": "{\"city\":\"Lisbon\",\"now\":\"sunny, 24 C\"}"}}
{"id": "ms-009", "prompt": "Read config.json, then change the port 8080 in it to 9090.", "tags": ["multi_step"], "steps": [{"expect": {"tool": "read_file"}, "args": {"path": {"regex": "^(\\./)?config\\.json$"}}}, {"expect": {"tool": "patch_file"}, "args": {"path": {"regex": "^(\\./)?config\\.json$"}, "old_text": {"contains": ["8080"]}, "new_text": {"contains": ["9090"]}}}], "results": {"read_file": "1\t{\n2\t  \"port\": 8080,\n3\t  \"debug\": false\n4\t}"}}
{"id": "ms-010", "prompt": "Look up what you remember about my dentist, then remind me tomorrow at 9am to call them.", "tags": ["multi_step"], "steps": [{"expect": {"tool": "memory_search"}, "args": {"query": {"contains": ["dentist"]}}}, {"expect": {"any_of": ["reminders__create_reminder", "cron_create"]}}], "results": {"memory_search": "{\"results\":[{\"text\":\"The user's dentist is Dr Patel, 0161 555 0199.\"}]}"}}

<Project>
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>
  <!-- Corvid.Host and Corvid.Cli only (C-013): the generic host, OpenTelemetry export and the terminal UI. The checker
       allows these in the composition root and the CLI, never in core projects. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.0" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="Spectre.Console.Testing" Version="0.57.2" />
  </ItemGroup>
  <!-- Corvid.Models.Starling only (decision D-3: nuget.org, every Starlings.* package at 0.3.0 together). The checker keeps
       these out of core projects. -->
  <ItemGroup>
    <PackageVersion Include="Starlings.Acquisition" Version="0.3.0" />
    <PackageVersion Include="Starlings.Models.E5.Extensions.AI" Version="0.3.0" />
    <PackageVersion Include="Starlings.Models.EmbeddingGemma2.Extensions.AI" Version="0.3.0" />
    <PackageVersion Include="Starlings.Models.Gliner2" Version="0.3.0" />
    <PackageVersion Include="Starlings.Models.Kev" Version="0.3.0" />
    <PackageVersion Include="Starlings.Models.Qwen35.Extensions.AI" Version="0.3.0" />
    <!-- CPU natives: ONNX Runtime GenAI, which brings Microsoft.ML.OnnxRuntime 1.30.0 for the ONNX models too. -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntimeGenAI" Version="0.17.1" />
  </ItemGroup>
</Project>
